#!/usr/bin/env python3
"""영역 이미지 스모크(ADR 0004): 이미지를 빌드하고, 띄워서 /healthz·/readyz 를 확인한다(잡은 한 번 실행해 결과 줄을 본다).

사용: tools/smoke {service|job|web} <영역> [--no-build]    (services/<이름>, jobs/<이름> 또는 web/<이름>)
docker 환경은 deploy/dockerenv.py 가 정한 격리 설정만 쓴다. 종료 코드는 시험의 종료 코드다.
"""

from __future__ import annotations

import argparse
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "deploy"))
import dockerenv  # noqa: E402


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("kind", choices=["service", "job", "web"])
    parser.add_argument("area")
    parser.add_argument("--no-build", action="store_true", help="이미 빌드한 이미지를 쓴다")
    args = parser.parse_args()
    if args.kind == "service" and (ROOT / "services" / args.area).is_dir():
        folder, target, image = ROOT / "services" / args.area, args.area, f"openit/{args.area.lstrip('_')}:local"
        command = ["uv", "run", "pytest", "-m", "smoke", "-ra"]
    elif args.kind == "job" and (ROOT / "jobs" / args.area).is_dir():
        folder, target, image = ROOT / "jobs" / args.area, args.area, f"openit/{args.area.lstrip('_')}:local"
        command = ["uv", "run", "pytest", "-m", "smoke", "-ra"]
    elif args.kind == "web" and (ROOT / "web" / args.area).is_dir():
        folder = ROOT / "web" / args.area
        target, image = f"web-{args.area.lstrip('_')}", f"openit/web-{args.area.lstrip('_')}:local"
        command = ["npm", "run", "smoke"]
    else:
        print(f"대상 없음: {args.kind}/{args.area} 가 없다", file=sys.stderr)
        return 3
    try:
        env = dockerenv.docker_env()
    except dockerenv.DockerEnvError as error:
        print(f"docker 환경을 정하지 못했다: {error}", file=sys.stderr)
        return 1
    if not args.no_build:
        rc = subprocess.run([str(ROOT / "deploy" / "deploy"), "build", target], check=False).returncode
        if rc != 0:
            return rc
    env["OPENIT_SMOKE_IMAGE"] = image
    return subprocess.run(command, cwd=folder, env=env, check=False).returncode


if __name__ == "__main__":
    sys.exit(main())
