#!/usr/bin/env python3
"""템플릿에서 새 영역 폴더를 만든다. 같은 입력이면 같은 결과다(ADR 0003).

사용: tools/new-area {service|job|lib|web} <이름> [--lib <라이브러리>]... [--openapi <계약 이름>] [--root <리포 루트>]
- service -> services/<이름>, job -> jobs/<이름>, lib -> libs/<이름>, web -> web/<이름> (templates/<종류> 에서)
- 이름은 소문자·숫자·하이픈. 밑줄 접두어(_example)는 템플릿 시험용 영역에만 쓴다.
- 잠금 파일(uv lock, npm install)과 THIRD_PARTY_NOTICES(openit-notices generate, ADR 0018, 이미지가 있는 영역만)를 만든다.
- 파이썬 영역은 계약에서 타입을 생성한다(openit-gen-contract, ADR 0020). 화면은 npm install 뒤 generate:contract 를 돌린다.
- --lib: libs/<라이브러리> 를 경로 의존으로 더한다(service, job. `uv add`, ADR 0020).
- --openapi: 서비스가 받는·내는 contracts/openapi/<이름>.yaml. 없으면 영역 이름의 파일이 있으면 그것, 없으면 platform(건강 상태만)이다.
- docker-bake.hcl 의 SERVICES / JOB_AREAS / WEBS 목록에 이름을 더한다(정렬, 중복 없음). lib 는 이미지가 없어 더하지 않는다.
표준 라이브러리만 쓴다(의존 없음).
"""

from __future__ import annotations

import argparse
import re
import shutil
import subprocess
import sys
from pathlib import Path

NAME_RE = re.compile(r"^_?[a-z][a-z0-9]*(-[a-z0-9]+)*$")
KINDS = {"service": ("services", "SERVICES"), "job": ("jobs", "JOB_AREAS"), "lib": ("libs", None), "web": ("web", "WEBS")}
PYTHON_KINDS = {"service", "job", "lib"}
DEFAULT_OPENAPI = "platform"  # 왜: 모든 서비스가 내는 건강 상태(/healthz, /readyz, /metrics)만 정의한 계약이다
TEXT_SUFFIXES = {".py", ".toml", ".md", ".txt", ".json", ".ts", ".tsx", ".html", ".css", ".mjs", ".cjs", ".js", ".yaml", ".yml", ".conf", ".ini", ".mako", ""}
SKIP_DIRS = {"node_modules", ".venv", "__pycache__", "dist", "test-results", "playwright-report", ".pytest_cache", ".ruff_cache"}


def package_name(name: str) -> str:
    return name.lstrip("_").replace("-", "_")


def render(text: str, name: str, service_name: str = DEFAULT_OPENAPI) -> str:
    return text.replace("__AREA__", name).replace("__PKG__", package_name(name)).replace("__SERVICE_NAME__", service_name)


def contract_service_names(root: Path) -> list[str] | None:
    """계약 ServiceName 의 값들. 계약 폴더가 없으면(시험용 사본) None."""
    components = root / "contracts" / "components.yaml"
    if not components.is_file():
        return None
    match = re.search(r"^    ServiceName:\n(?:      .*\n)*?      enum: \[([^\]]*)\]", components.read_text(encoding="utf-8"), re.M)
    if not match:
        sys.exit(f"오류: {components} 에서 ServiceName 의 enum 을 찾지 못했다")
    return [item.strip() for item in match.group(1).split(",")]


def copy_template(src: Path, dst: Path, name: str, service_name: str = DEFAULT_OPENAPI) -> None:
    for path in sorted(src.rglob("*")):
        rel = path.relative_to(src)
        if SKIP_DIRS & set(rel.parts):
            continue
        target = dst / Path(render(str(rel), name, service_name))
        if path.is_dir():
            target.mkdir(parents=True, exist_ok=True)
        else:
            target.parent.mkdir(parents=True, exist_ok=True)
            if path.suffix in TEXT_SUFFIXES or path.name in {"Dockerfile", ".dockerignore", ".gitignore"}:
                target.write_text(render(path.read_text(encoding="utf-8"), name, service_name), encoding="utf-8")
                shutil.copymode(path, target)
            else:
                shutil.copy2(path, target)


def update_bake(bake: Path, var: str, name: str) -> None:
    text = bake.read_text(encoding="utf-8")
    pattern = re.compile(rf"(// BEGIN {var}\n)(.*?)(// END {var}\n)", re.S)
    match = pattern.search(text)
    if not match:
        sys.exit(f"오류: {bake} 에 '// BEGIN {var}' ~ '// END {var}' 표시가 없다")
    current = re.search(r"default\s*=\s*\[(.*?)\]", match.group(2), re.S)
    names = (set(re.findall(r'"([^"]+)"', current.group(1))) if current else set()) | {name}
    body = f'variable "{var}" {{\n  default = [{", ".join(chr(34) + n + chr(34) for n in sorted(names))}]\n}}\n'
    bake.write_text(text[: match.start(2)] + body + text[match.end(2) :], encoding="utf-8")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("kind", choices=sorted(KINDS))
    parser.add_argument("name")
    parser.add_argument("--lib", action="append", default=[], metavar="LIB", help="경로 의존으로 더할 libs/<LIB>(service, job)")
    parser.add_argument("--openapi", metavar="NAME", help="service 가 쓰는 contracts/openapi/<NAME>.yaml")
    parser.add_argument("--no-lock", action="store_true", help="잠금 파일과 고지 파일을 만들지 않는다(시험용)")
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parent.parent)
    args = parser.parse_args()
    if not NAME_RE.match(args.name):
        print(f"오류: 이름 '{args.name}' 은 소문자·숫자·하이픈이어야 한다", file=sys.stderr)
        return 2
    folder, var = KINDS[args.kind]
    if args.lib and args.kind not in {"service", "job"}:
        print("오류: --lib 는 service 와 job 에만 쓴다", file=sys.stderr)
        return 2
    if args.openapi and args.kind != "service":
        print("오류: --openapi 는 service 에만 쓴다", file=sys.stderr)
        return 2
    if args.lib and args.no_lock:
        print("오류: --lib 는 uv add 로 잠금 파일을 만들므로 --no-lock 과 같이 쓰지 않는다", file=sys.stderr)
        return 2
    for lib in args.lib:
        if not (args.root / "libs" / lib / "pyproject.toml").is_file():
            print(f"오류: libs/{lib} 가 없다", file=sys.stderr)
            return 2
    template = args.root / "templates" / args.kind
    if not template.is_dir():
        print(f"오류: 템플릿 {template} 이 없다", file=sys.stderr)
        return 2
    dst = args.root / folder / args.name
    if dst.exists():
        print(f"오류: {dst} 가 이미 있다", file=sys.stderr)
        return 1
    openapi = args.openapi or (args.name if (args.root / "contracts" / "openapi" / f"{args.name}.yaml").is_file() else DEFAULT_OPENAPI)
    if args.kind == "service" and not (args.root / "contracts" / "openapi" / f"{openapi}.yaml").is_file() and (args.root / "contracts").is_dir():
        print(f"오류: contracts/openapi/{openapi}.yaml 이 없다", file=sys.stderr)
        return 2
    # 왜: HealthReport.service 는 계약 ServiceName 값이어야 한다. 계약에 없는 이름(시험 영역 등)은 platform 의 이름을 빌린다
    names = contract_service_names(args.root)
    service_name = args.name if names is not None and args.name in names else DEFAULT_OPENAPI
    copy_template(template, dst, args.name, service_name)
    if args.kind == "service" and openapi != DEFAULT_OPENAPI:
        pyproject = dst / "pyproject.toml"
        pyproject.write_text(pyproject.read_text(encoding="utf-8").replace(f'openapi = ["{DEFAULT_OPENAPI}"]', f'openapi = ["{openapi}"]'), encoding="utf-8")
    if not args.no_lock:
        checks = ["uv", "run", "--project", str(args.root / "tools" / "checks"), "--frozen"]
        if args.kind in PYTHON_KINDS:
            # 왜 먼저: 계약 타입은 영역 코드가 import 한다. 잠금 전에 만들어도 의존이 같다
            subprocess.run([*checks, "openit-gen-contract", str(dst), "--root", str(args.root)], check=True)
        # 왜: Dockerfile 이 잠금 파일(uv.lock, package-lock.json)을 요구한다. 의존 버전은 uv·npm 이 잠금 파일에 고정한다
        if args.kind == "web":
            subprocess.run(["npm", "install"], cwd=dst, check=True)
            subprocess.run(["npm", "run", "generate:contract"], cwd=dst, check=True)
        else:
            subprocess.run(["uv", "lock"], cwd=dst, check=True)
            for lib in args.lib:  # 경로 의존: uv 가 [tool.uv.sources] 에 path 를 쓰고 의존 이름은 버전 없이 더한다
                subprocess.run(["uv", "add", f"../../libs/{lib}"], cwd=dst, check=True)
        # 왜: Dockerfile 이 THIRD_PARTY_NOTICES 를 이미지에 넣는다(ADR 0018). 잠금 파일에서 생성한다. lib 는 이미지가 없다
        if args.kind != "lib":
            subprocess.run([*checks, "openit-notices", "--root", str(args.root), "generate", str(dst)], check=True)
    if var is not None:
        update_bake(args.root / "docker-bake.hcl", var, args.name)
    print(f"만들었다: {dst.relative_to(args.root)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
