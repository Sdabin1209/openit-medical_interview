#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.12"
# dependencies = [
#     "bcrypt",
#     "cryptography",
#     "jsonschema",
#     "pydantic",
#     "pyyaml",
#     "rfc3339-validator",
#     "typer",
# ]
# ///
"""잡 스케줄러 시험(샌드박스, D123, ADR 0028): 제품을 사본으로 설치하고, 스케줄에 있는 잡을 한 번씩 트리거해 실행 경로·결과 기록·감시를 확인한다.

서버 한 대(`--one`)와 서버 두 대(`--two`, survey-service 와 그 DB 가 플랫폼과 다른 서버)를 모두 시험한다. 둘 다 주지 않으면 둘 다 한다. 시험이 더하는 것은 설치 입력(.env, layout.json,
비밀 파일, 서버 밖 대상의 루트)과 가짜 systemctl 하나뿐이다. 제품 구성에 시험용 줄을 더하지 않는다.
시험이 하는 것:
- 스케줄 계산: `schedule list --now <주입한 시각>` 이 잡마다 주기·다음 실행을 내고(시계를 주입한다. 실제로 기다리지 않는다) 값이 예상과 같다.
- 유닛 생성: `schedule render` 가 만든 서비스·타이머 파일을 `systemd-analyze verify` 로 검증하고(있으면), `schedule install`·`uninstall` 이 가짜 systemctl 로 올바른 명령을 부른다(이 노드의 systemd 에 설치하지 않는다).
- 잡을 한 번씩 트리거(`schedule run`): DETECT_FAILURES·PURGE_EXPIRED(survey-service 이미지의 선언대로, 그 영역이 있는 서버의 compose 로), BACKUP·OFFSITE_SYNC·RESTORE_TEST(deploy 의 잡).
  종료 코드, 표준 출력의 JobRunResult(계약 스키마로 검증), 기록 파일, 감시(Pushgateway 의 지표와 Prometheus 가 읽은 규칙)를 본다.
- 겹침 방지: 같은 잡의 잠금이 잡혀 있으면 시작하지 않고 75 이고 기록을 바꾸지 않는다. 시간 상한: 상한을 넘기는 명령은 멈추고(1초 상한) 자식까지 사라진다.
- 실패 경보: 서버 밖 자격 파일이 없는 BACKUP 은 1 로 기록되고(시작 전에 멈춘다, D88 U6) Prometheus 의 OpenitJobFailed 가 발화해 Alertmanager 에 도달한다. DB 를 멈춘 PURGE_EXPIRED 는 75 로 기록되고
  경보가 아니다. 고친 뒤 다시 돌리면 0 이고 경보가 풀린다.
- 시간은 통제 가능한 것만: 기다림은 모두 조건이 되면 끝나고 상한이 있다(고정 대기 없음). 경보는 Prometheus 의 긁기·평가 주기를 기다리므로 상한 안에서 조건을 본다.
- 컨테이너·볼륨·네트워크 이름에 `openit-sch` 가 들어간다. 끝나면 이 프로젝트의 것만 지우고 남은 것이 0개인지 본다.

사용: tools/schedule-sandbox [--one] [--two] [--keep]    종료 코드: 0 통과, 1 실패, 3 컨테이너가 닿는 주소가 모자라 시험할 수 없음.
"""

from __future__ import annotations

import argparse
import fcntl
import importlib.machinery
import importlib.util
import json
import os
import re
import shutil
import subprocess
import sys
import time
from datetime import UTC, datetime
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


def load(name: str, filename: str):  # type: ignore[no-untyped-def]
    loader = importlib.machinery.SourceFileLoader(name, str(ROOT / "tools" / filename))
    spec = importlib.util.spec_from_loader(name, loader)
    assert spec is not None
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


BK = load("backup_sandbox", "backup-sandbox")  # 서버 밖 대상 흉내·설치 틀·정리를 같은 방식으로 쓴다
PROJECT = "openit-sch"
BK.PROJECT = PROJECT
BK.OFFSITE_NAME = f"{PROJECT}-offsite"
LS = BK.LS
LS.PROJECT = PROJECT
Failure = LS.Failure
NOW = "2026-11-11T01:00:00+09:00"  # 주입하는 시계(수요일 새벽 1시, 한국 시각)
CONTRACTS = ROOT / "contracts" / "components.yaml"
JOBS = ("DETECT_FAILURES", "PURGE_EXPIRED", "BACKUP", "OFFSITE_SYNC", "RESTORE_TEST")
ALERT_WAIT = 420  # 초. Prometheus 가 Pushgateway 를 긁고(1분 간격) 규칙을 평가하는(1분 간격) 데 걸리는 시간의 상한(여러 번 돌 시간, 측정하지 않았다)


def contract_check(document: dict[str, object]) -> None:
    """JobRunResult 가 계약 스키마(components.yaml)를 지킨다."""
    import jsonschema  # noqa: PLC0415
    import yaml  # noqa: PLC0415

    components = yaml.safe_load(CONTRACTS.read_text(encoding="utf-8"))["components"]
    jsonschema.validate(document, {"$ref": "#/components/schemas/JobRunResult", "components": components}, format_checker=jsonschema.FormatChecker())


class Scenario(BK.Scenario):
    def metrics(self) -> dict[str, dict[str, float]]:
        """Pushgateway 가 가진 잡 지표: 지표 이름 -> {잡 이름: 값}. 같은 서버 엔진의 pushgateway 컨테이너 안에서 읽는다(상시 서비스 안에서 한 명령, 시험 접근 방식)."""
        platform = self.server_of("platform")
        out = LS.docker(["exec", self.container(platform, "pushgateway"), "wget", "-q", "-O", "-", "http://127.0.0.1:9091/metrics"], context=platform).stdout
        found: dict[str, dict[str, float]] = {}
        for match in re.finditer(r'^(openit_job_[a-z_]+)\{[^}]*job_name="([A-Z_]+)"[^}]*\} (\S+)$', out, re.M):
            found.setdefault(match.group(1), {})[match.group(2)] = float(match.group(3))
        return found

    def prometheus_get(self, path: str) -> dict[str, object]:
        platform = self.server_of("platform")
        out = LS.docker(["exec", self.container(platform, "prometheus"), "wget", "-q", "-O", "-", f"http://127.0.0.1:9090{path}"], context=platform).stdout
        return json.loads(out)  # type: ignore[no-any-return]

    def alertmanager_alerts(self) -> list[dict[str, object]]:
        platform = self.server_of("platform")
        out = LS.docker(["exec", self.container(platform, "alertmanager"), "wget", "-q", "-O", "-", "http://127.0.0.1:9093/api/v2/alerts"], context=platform).stdout
        return json.loads(out)  # type: ignore[no-any-return]

    def firing(self, alertname: str, job: str) -> bool:
        alerts = self.prometheus_get("/api/v1/alerts")["data"]["alerts"]  # type: ignore[index]
        return any(a["labels"].get("alertname") == alertname and a["labels"].get("job_name") == job and a["state"] == "firing" for a in alerts)  # type: ignore[index, union-attr]

    def save_diagnostics(self) -> None:
        """실패하면 정리하기 전에 이 시험의 컨테이너 상태와 로그, 잡 결과 기록을 남긴다(진단 수단을 지우지 않는다). 서버 한 대(context 없음)와 두 대 모두."""
        LS.LOGS.mkdir(parents=True, exist_ok=True)
        for server in ([LS.SERVER_A, LS.SERVER_B] if self.two else [None]):
            label = f"label=com.docker.compose.project={self.project_of(server)}"
            ids = LS.docker(["ps", "-a", "--filter", label, "-q"], context=server, check=False).stdout.split()
            for identifier in ids:
                name = LS.docker(["inspect", "--format", "{{.Name}}", identifier], context=server, check=False).stdout.strip().lstrip("/")
                logs = LS.docker(["logs", "--tail", "200", identifier], context=server, check=False)
                (LS.LOGS / f"{self.log}-diag-{name}.log").write_text(logs.stdout + logs.stderr, encoding="utf-8")
        runs = self.root / "deploy" / "job-runs"
        if runs.is_dir():
            (LS.LOGS / f"{self.log}-diag-job-runs.json").write_text(json.dumps({p.name: p.read_text(encoding="utf-8") for p in sorted(runs.glob("*.json"))}, indent=2), encoding="utf-8")

    def run_schedule(self, job: str, wanted: int, *, log: str, requested_at: str | None = None) -> dict[str, object]:
        """`schedule run <잡>` 의 종료 코드와 결과 줄을 본다(줄은 계약 스키마로 검증하고 종료 코드와 같아야 한다)."""
        args = ["schedule", "run", job, *(["--requested-at", requested_at] if requested_at else [])]
        result = self.deploy(*args, log=log, check=False)
        line = BK.result_line(result.stdout)
        contract_check(line)
        if result.returncode != wanted or line["exit_code"] != wanted or line["job"] != job:
            raise Failure(f"{job}: rc={result.returncode} 결과 {line} (기대 {wanted})\n{(result.stdout + result.stderr)[-1500:]}")
        return line

    def recorded(self, job: str) -> dict[str, object]:
        path = self.root / "deploy" / "job-runs" / f"{job}.json"
        if not path.is_file():
            raise Failure(f"{job} 의 결과 기록 파일이 없다: {path}")
        return json.loads(path.read_text(encoding="utf-8"))  # type: ignore[no-any-return]

    def run(self, keep: bool) -> None:
        import yaml  # noqa: PLC0415

        image = yaml.safe_load((ROOT / "deploy" / "compose.yaml").read_text(encoding="utf-8"))["services"]["backup-store"]["image"]
        scratch = LS.WORK / f"{PROJECT}-scratch"
        if scratch.exists():
            shutil.rmtree(scratch)
        scratch.mkdir(parents=True)
        self.offsite = BK.Offsite(self.offsite_address, scratch)
        offsite_url = self.offsite.start(image)
        servers = (
            [{"name": LS.SERVER_A, "address": self.address_a, "services": ["platform", "admin-console", "kiosk-frontend"]},
             {"name": LS.SERVER_B, "address": self.address_b, "services": ["survey-service", "model-runtime"]}]
            if self.two else
            [{"name": LS.SERVER_A, "address": self.address_a, "services": ["platform", "survey-service", "model-runtime", "admin-console", "kiosk-frontend"]}]
        )

        def install_inputs(root: Path) -> None:
            document = json.loads((root / "deploy" / "layout.json").read_text(encoding="utf-8"))
            document["backup"]["offsite_url"] = offsite_url
            (root / "deploy" / "layout.json").write_text(json.dumps(document, indent=2) + "\n", encoding="utf-8")
            credentials = Path(document["backup"]["offsite_credentials_file"])
            credentials.write_text(f"offsite:{self.offsite.password}\n", encoding="utf-8")  # type: ignore[union-attr]
            credentials.chmod(0o600)
            trust = root / "deploy" / "pki" / "trust.d"
            trust.mkdir(parents=True)
            (trust / "offsite-ca.crt").write_bytes(self.offsite.ca_pem)  # type: ignore[union-attr]

        LS.prepare(self.address_a, self.address_b, single=not self.two, layout_doc={"servers": servers, "device_placements": []}, before_install=install_inputs)
        endpoint = LS.dockerenv.docker_env({**LS.env()}, ROOT)["DOCKER_HOST"]
        if self.two:
            for server in (LS.SERVER_A, LS.SERVER_B):
                LS.docker(["context", "create", server, "--docker", f"host={endpoint}"])
        backup_dir = self.root / "state" / "backup"
        survey_server = self.server_of("survey-service")
        state: dict[str, object] = {}

        def step(name: str, action):  # type: ignore[no-untyped-def]
            started = time.monotonic()
            detail = action()
            print(f"OK   [{self.log}] {name} ({time.monotonic() - started:.0f}초) {detail}", flush=True)

        def expect_rc(result, wanted: int, what: str) -> None:  # type: ignore[no-untyped-def]
            if result.returncode != wanted:
                raise Failure(f"{what}: rc={result.returncode} (기대 {wanted})\n{(result.stdout + result.stderr)[-1500:]}")

        def install() -> str:
            expect_rc(self.deploy("secrets", "init", log="secrets", check=False), 0, "secrets init")
            doctor = self.deploy("doctor", log="doctor", check=False)
            expect_rc(doctor, 0, "doctor")
            for job in JOBS:
                if job not in doctor.stdout:
                    raise Failure(f"doctor 의 잡 스케줄에 {job} 이 없다:\n{doctor.stdout[-1500:]}")
            expect_rc(self.deploy("bootstrap", log="bootstrap", check=False), 0, "bootstrap")
            expect_rc(self.deploy("status", log="status", check=False), 0, "status")
            rules = self.prometheus_get("/api/v1/rules")["data"]["groups"]  # type: ignore[index]
            presence = [g for g in rules if g["name"] == "openit-job-presence"]  # type: ignore[index]
            if not presence or len(presence[0]["rules"]) != len(JOBS):
                raise Failure(f"Prometheus 가 deploy 가 만든 잡 규칙 {len(JOBS)}개를 읽지 않았다: {presence}")
            return f"doctor rc=0(잡 {len(JOBS)}개), bootstrap rc=0, status rc=0, Prometheus 가 생성 규칙 {len(JOBS)}개를 읽었다"

        def clock() -> str:
            result = self.deploy("schedule", "list", "--now", NOW, log="list", check=False)
            expect_rc(result, 0, "schedule list")
            expected = {
                "DETECT_FAILURES": ("900초마다", "2026-11-11T01:15:00+09:00"),
                "PURGE_EXPIRED": ("900초마다", "2026-11-11T01:15:00+09:00"),
                "BACKUP": ("매일 02:00", "2026-11-11T02:00:00+09:00"),
                "OFFSITE_SYNC": ("매일 03:00", "2026-11-11T03:00:00+09:00"),
                "RESTORE_TEST": ("매주 일요일 04:00", "2026-11-15T04:00:00+09:00"),
            }
            lines = result.stdout.splitlines()
            for job, (describe, first) in expected.items():
                index = next((i for i, line in enumerate(lines) if line.startswith(job + " ")), None)
                if index is None or describe not in lines[index] or f"다음: {first}" not in lines[index + 2]:
                    raise Failure(f"{job} 의 주기·다음 실행이 기대와 다르다(기대 {describe}, {first}):\n{result.stdout[-1500:]}")
            return f"주입한 시계 {NOW}: 잡 {len(expected)}개의 주기와 다음 실행이 예상과 같다"

        def units() -> str:
            out = scratch / "units"
            user = os.environ.get("USER") or subprocess.run(["id", "-un"], capture_output=True, text=True, check=True).stdout.strip()
            expect_rc(self.deploy("schedule", "render", "--out", str(out), "--user", user, log="render", check=False), 0, "schedule render")
            files = sorted(path.name for path in out.iterdir())
            if len(files) != 2 * len(JOBS) or not all(name.startswith(f"{PROJECT}-job-") for name in files):
                raise Failure(f"유닛 파일이 기대와 다르다: {files}")
            verified = "systemd-analyze verify 건너뜀(없다)"
            if shutil.which("systemd-analyze"):
                result = subprocess.run(["systemd-analyze", "verify", *[str(out / name) for name in files]], capture_output=True, text=True, check=False)
                problems = [line for line in (result.stdout + result.stderr).splitlines() if line.strip()]
                if result.returncode != 0 or problems:
                    raise Failure(f"systemd-analyze verify 가 실패했다: {problems}")
                verified = "systemd-analyze verify 통과"
            # 가짜 systemctl: 부른 명령을 파일에 적는다(이 노드의 systemd 에 설치하지 않는다)
            fake = scratch / "systemctl"
            record = scratch / "systemctl.log"
            fake.write_text(f"#!/bin/sh\necho \"$@\" >> {record}\n", encoding="utf-8")
            fake.chmod(0o755)
            unit_dir = scratch / "system"
            unit_dir.mkdir()
            (unit_dir / f"{PROJECT}-job-old-job.timer").write_text("[Timer]\n", encoding="utf-8")  # 지금 스케줄에 없는 이 설치의 옛 유닛
            (unit_dir / "unrelated.timer").write_text("[Timer]\n", encoding="utf-8")  # 다른 유닛은 건드리지 않는다
            expect_rc(self.deploy("schedule", "install", "--unit-dir", str(unit_dir), "--systemctl", str(fake), "--user", user, log="install", check=False), 0, "schedule install")
            installed = sorted(path.name for path in unit_dir.iterdir())
            if installed != sorted([*files, "unrelated.timer"]):
                raise Failure(f"설치 뒤 유닛 폴더가 기대와 다르다: {installed}")
            calls = record.read_text(encoding="utf-8").splitlines()
            timers = sorted(name for name in files if name.endswith(".timer"))
            if calls != [f"disable --now {PROJECT}-job-old-job.timer", "daemon-reload", "enable --now " + " ".join(timers)]:
                raise Failure(f"systemctl 호출이 기대와 다르다: {calls}")
            expect_rc(self.deploy("schedule", "install", "--unit-dir", str(unit_dir), "--systemctl", str(fake), "--user", user, log="install-again", check=False), 0, "schedule install 다시")
            if (unit_dir / f"{PROJECT}-job-backup.timer").read_text(encoding="utf-8") != (out / f"{PROJECT}-job-backup.timer").read_text(encoding="utf-8"):
                raise Failure("다시 설치한 유닛이 만든 것과 다르다")
            expect_rc(self.deploy("schedule", "uninstall", "--unit-dir", str(unit_dir), "--systemctl", str(fake), log="uninstall", check=False), 0, "schedule uninstall")
            if sorted(path.name for path in unit_dir.iterdir()) != ["unrelated.timer"]:
                raise Failure(f"uninstall 뒤 남은 유닛: {sorted(path.name for path in unit_dir.iterdir())}")
            return f"유닛 {len(files)}개 생성, {verified}, 가짜 systemctl 로 install(옛 유닛만 제거, 다시 설치 같음)·uninstall"

        def trigger_area_jobs() -> str:
            notes = []
            for job in ("DETECT_FAILURES", "PURGE_EXPIRED"):
                since = datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ")
                line = self.run_schedule(job, 0, log=f"run-{job.lower()}", requested_at="2026-11-11T00:00:00+09:00")
                until = datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ")
                if line.get("processed_count") is None:
                    raise Failure(f"{job} 이 처리한 항목 수를 내지 않았다: {line}")
                # 그 영역이 있는 서버의 compose 프로젝트에서 일회용 컨테이너가 만들어졌다(docker 이벤트로 확인)
                events = LS.docker(["events", "--since", since, "--until", until, "--filter", "type=container", "--filter", "event=create", "--format", "{{json .}}"],
                                   context=survey_server).stdout.splitlines()
                projects = {json.loads(row)["Actor"]["Attributes"].get("com.docker.compose.project") for row in events
                            if json.loads(row)["Actor"]["Attributes"].get("com.docker.compose.service") == "survey-service"}
                if projects != {self.project_of(survey_server)}:
                    raise Failure(f"{job} 이 survey-service 가 있는 서버의 프로젝트에서 돌지 않았다: {projects} (기대 {self.project_of(survey_server)})")
                if self.recorded(job)["exit_code"] != 0:
                    raise Failure(f"{job} 의 기록이 성공이 아니다")
                leftover = LS.docker(["ps", "-a", "--filter", f"name={self.project_of(survey_server)}-job-", "-q"], context=survey_server).stdout.split()
                if leftover:
                    raise Failure(f"{job} 의 일회용 컨테이너가 남았다: {leftover}")
                notes.append(f"{job} rc=0 처리 {line['processed_count']}건({self.project_of(survey_server)} 에서)")
            return "; ".join(notes) + ", 일회용 컨테이너 0개"

        def trigger_deploy_jobs() -> str:
            self.seed()  # 백업할 내용(survey 시험 표)과 활성화 기록
            notes = []
            for job, key in (("BACKUP", "snapshot_id"), ("OFFSITE_SYNC", "processed_count"), ("RESTORE_TEST", "processed_count")):
                line = self.run_schedule(job, 0, log=f"run-{job.lower()}")
                if key not in line or (key == "snapshot_id" and not BK.SNAPSHOT_ID.fullmatch(str(line[key]))):
                    raise Failure(f"{job} 의 결과에 {key} 가 없거나 모양이 틀리다: {line}")
                if self.recorded(job)["exit_code"] != 0:
                    raise Failure(f"{job} 의 기록이 성공이 아니다")
                notes.append(f"{job} rc=0")
            return ", ".join(notes)

        def metrics_and_status() -> str:
            found = self.metrics()
            for job in JOBS:
                code = found.get("openit_job_last_exit_code", {}).get(job)
                success = found.get("openit_job_last_success_timestamp_seconds", {}).get(job)
                period = found.get("openit_job_period_seconds", {}).get(job)
                if code != 0 or success is None or period is None:
                    raise Failure(f"Pushgateway 의 {job} 지표가 기대와 다르다(종료 코드 0, 마지막 성공, 주기): {code} {success} {period}")
            periods = found["openit_job_period_seconds"]
            if periods["PURGE_EXPIRED"] != 900 or periods["BACKUP"] != 86400 or periods["RESTORE_TEST"] != 604800:
                raise Failure(f"주기 지표가 스케줄과 다르다: {periods}")
            state["success"] = dict(found["openit_job_last_success_timestamp_seconds"])
            expect_rc(self.deploy("schedule", "status", log="schedule-status", check=False), 0, "schedule status")
            return f"Pushgateway 에 잡 {len(JOBS)}개의 종료 코드 0·마지막 성공·주기 지표(주기 {sorted(set(periods.values()))}), schedule status rc=0"

        def overlap_and_timeout() -> str:
            lock_path = self.root / "deploy" / "job-runs" / "PURGE_EXPIRED.lock"
            before = (self.root / "deploy" / "job-runs" / "PURGE_EXPIRED.json").read_text(encoding="utf-8")
            with lock_path.open("a") as handle:
                fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)  # 같은 잡이 돌고 있는 것처럼 잠금을 쥔다
                result = self.deploy("schedule", "run", "PURGE_EXPIRED", log="run-overlap", check=False)
                if result.returncode != 75 or BK.result_line(result.stdout)["exit_code"] != 75 or "동시 실행 금지" not in result.stderr:
                    raise Failure(f"잠금이 잡혀 있는데 시작했거나 75 가 아니다: rc={result.returncode}\n{result.stderr[-500:]}")
            after = (self.root / "deploy" / "job-runs" / "PURGE_EXPIRED.json").read_text(encoding="utf-8")
            if after != before:
                raise Failure("겹쳐서 시작하지 않은 실행이 결과 기록을 바꿨다")
            # 시간 상한: 제품의 run_process 를 불러 1초 상한으로 sleep 을 돌린다(자식까지 멈춘다)
            deploy_module = load("deploy_module", "../deploy/deploy")
            started = time.monotonic()
            code, _ = deploy_module.run_process(["sh", "-c", "sleep 300 & echo $! > " + str(scratch / "child.pid") + "; wait"], None, 1)
            took = time.monotonic() - started
            child = int((scratch / "child.pid").read_text(encoding="utf-8").strip())
            time.sleep(0.2)
            alive = Path(f"/proc/{child}").exists() and "Z" not in (Path(f"/proc/{child}/stat").read_text(encoding="utf-8").split(") ")[1][:1])
            if code is not None or took > 20 or alive:
                raise Failure(f"시간 상한을 넘긴 명령이 멈추지 않았다: code={code} {took:.1f}초 자식 살아 있음={alive}")
            return f"잠금이 잡히면 rc=75·기록 불변, 1초 상한을 넘긴 명령은 {took:.1f}초에 멈추고 자식(sleep)도 사라진다"

        def failure_alert() -> str:
            moved = backup_dir / "offsite_credentials.moved"
            (backup_dir / "offsite_credentials").rename(moved)
            try:
                line = self.run_schedule("BACKUP", 1, log="run-backup-fails")
            finally:
                moved.rename(backup_dir / "offsite_credentials")
            expect_rc(self.deploy("schedule", "status", log="status-failed", check=False), 1, "실패 뒤 schedule status")
            if self.recorded("BACKUP")["exit_code"] != 1:
                raise Failure("실패한 BACKUP 이 1 로 기록되지 않았다")
            found = self.metrics()
            if found["openit_job_last_exit_code"]["BACKUP"] != 1:
                raise Failure(f"Pushgateway 의 BACKUP 종료 코드가 1 이 아니다: {found['openit_job_last_exit_code']}")
            if found["openit_job_last_success_timestamp_seconds"]["BACKUP"] != state["success"]["BACKUP"]:  # type: ignore[index]
                raise Failure("실패가 마지막 성공 시각을 덮었다(POST 는 같은 이름의 지표만 바꿔야 한다)")
            LS.wait_until("OpenitJobFailed(BACKUP)가 Prometheus 에서 발화", lambda: self.firing("OpenitJobFailed", "BACKUP"), ALERT_WAIT, 10)
            LS.wait_until("발화한 경보가 Alertmanager 에 도달", lambda: any(a["labels"].get("alertname") == "OpenitJobFailed" and a["labels"].get("job_name") == "BACKUP"  # type: ignore[attr-defined]
                                                                      for a in self.alertmanager_alerts()), 120, 5)
            return f"서버 밖 자격 없는 BACKUP rc=1(결과 줄 {line['exit_code']}), 지표 1·마지막 성공 유지, OpenitJobFailed 발화 -> Alertmanager 도달"

        def transient_and_recovery() -> str:
            database = self.container(survey_server, "survey-db")
            LS.docker(["stop", database], context=survey_server)
            try:
                line = self.run_schedule("PURGE_EXPIRED", 75, log="run-purge-db-down")
            finally:
                LS.docker(["start", database], context=survey_server)
            if self.metrics()["openit_job_last_exit_code"]["PURGE_EXPIRED"] != 75:
                raise Failure("DB 가 멈춘 PURGE_EXPIRED 의 지표가 75 가 아니다")
            # 일시적 실패는 경보가 아니다(OpenitJobFailed 는 종료 코드 1 만)
            LS.wait_until("DB 가 다시 선다", lambda: "healthy" in LS.docker(["inspect", "--format", "{{.State.Health.Status}}", database], context=survey_server).stdout, 90, 3)
            self.run_schedule("PURGE_EXPIRED", 0, log="run-purge-recovered")
            self.run_schedule("BACKUP", 0, log="run-backup-recovered")
            found = self.metrics()
            if found["openit_job_last_exit_code"]["BACKUP"] != 0 or found["openit_job_last_exit_code"]["PURGE_EXPIRED"] != 0:
                raise Failure(f"고친 뒤 종료 코드 지표가 0 으로 돌아오지 않았다: {found['openit_job_last_exit_code']}")
            if found["openit_job_last_success_timestamp_seconds"]["BACKUP"] <= state["success"]["BACKUP"]:  # type: ignore[index]
                raise Failure("고친 뒤 BACKUP 의 마지막 성공 시각이 갱신되지 않았다")
            LS.wait_until("OpenitJobFailed(BACKUP)가 풀린다", lambda: not self.firing("OpenitJobFailed", "BACKUP"), ALERT_WAIT, 10)
            if self.firing("OpenitJobFailed", "PURGE_EXPIRED"):
                raise Failure("일시적 실패(75)에 OpenitJobFailed 가 울렸다")
            return f"DB 를 멈춘 PURGE_EXPIRED rc=75(결과 줄 {line['exit_code']}, 경보 아님), 고친 뒤 둘 다 rc=0, OpenitJobFailed 해제"

        def teardown() -> str:
            expect_rc(self.deploy("down", "--volumes", "--yes", log="down", check=False), 0, "down --volumes")
            left = BK.leftovers(self.two, except_offsite=True)
            if left:
                raise Failure(f"down --volumes 뒤 남은 것: {left}")
            return "down --volumes rc=0, 남은 컨테이너·볼륨·네트워크 0개"

        try:
            step("secrets, doctor(잡 스케줄·생성 규칙 검증), bootstrap", install)
            step("스케줄 계산(주입한 시계)", clock)
            step("유닛 생성·검증·설치(가짜 systemctl)", units)
            step("영역의 잡 트리거(선언한 서버에서)", trigger_area_jobs)
            step("deploy 의 잡 트리거", trigger_deploy_jobs)
            step("잡 결과 지표·상태", metrics_and_status)
            step("겹침 방지·시간 상한", overlap_and_timeout)
            step("실패(1) -> 감시 경보", failure_alert)
            step("일시적 실패(75), 복구", transient_and_recovery)
            step("down --volumes", teardown)
        except Failure:
            try:
                self.save_diagnostics()
            except Exception as error:  # noqa: BLE001  왜: 진단을 남기다 실패해도 원래 실패 사유를 가리지 않는다
                print(f"진단을 남기지 못했다: {error}", file=sys.stderr)
            raise
        finally:
            if not keep:
                BK.clean(self.two)
                self.offsite.stop()
                shutil.rmtree(LS.WORK / PROJECT, ignore_errors=True)
                shutil.rmtree(scratch, ignore_errors=True)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--one", action="store_true", help="서버 한 대만")
    parser.add_argument("--two", action="store_true", help="서버 두 대만")
    parser.add_argument("--keep", action="store_true", help="끝나도 사본과 컨테이너를 지우지 않는다(진단용)")
    args = parser.parse_args()
    modes = [m for m, wanted in (("one", args.one), ("two", args.two)) if wanted] or ["one", "two"]
    if LS.LOGS.exists():
        shutil.rmtree(LS.LOGS)
    missing = [name for name in LS.SERVICES if LS.docker_image_missing(name)]
    if missing:
        print(f"이 엔진에 영역 이미지가 없다: {', '.join(missing)} (./deploy build)", file=sys.stderr)
        return 1
    (LS.WORK / PROJECT / ".docker-config").mkdir(parents=True, exist_ok=True)
    addresses = LS.reachable_addresses(LS.LOGS)
    if len(addresses) < (2 if "two" in modes else 1):
        print(f"컨테이너가 닿는 서로 다른 IPv4 주소가 모자라다(찾은 것: {addresses})", file=sys.stderr)
        return 3
    for mode in modes:
        print(f"--- 서버 {'두 대' if mode == 'two' else '한 대'}: 주소 {addresses[:2 if mode == 'two' else 1]}", flush=True)
        scenario = Scenario(mode == "two", addresses)
        try:
            scenario.run(args.keep)
        except Failure as error:
            print(f"FAIL [{scenario.log}] {error}", file=sys.stderr)
            return 1
        finally:
            if not args.keep:
                BK.clean(mode == "two")
                left = BK.leftovers(mode == "two")
                if left:
                    print(f"경고: 정리하지 못한 것 {left}", file=sys.stderr)
    print("잡 스케줄러 샌드박스 통과: " + ", ".join(modes))
    return 0


if __name__ == "__main__":
    import socket

    socket.setdefaulttimeout(30)
    sys.exit(main())
