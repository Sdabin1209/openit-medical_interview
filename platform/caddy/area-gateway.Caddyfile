# 영역 게이트웨이(platform ADR 0007, 계약 9.0.0). 서비스 영역마다 이 파일 하나로 Caddy 컨테이너 하나를 띄운다. 설명: area-gateway.md
# 환경 변수: OPENIT_AREA_NAME(서비스 이름), OPENIT_AREA_UPSTREAM(영역 안 서비스 host:port, 평문), OPENIT_SERVICE_PORT(TLS 포트, 1024 이상),
#            OPENIT_INTERNAL_ACME_DIRECTORY_URL(사설 CA 의 ACME 디렉터리)
{
	admin off
	# 왜 1m: 입구 에이전트와 같다. 갱신 점검 주기의 기본은 10분이고 실패한 갱신을 1분마다 다시 시도해 수명이 짧은 인증서의 여유를 덜 쓴다. 측정하지 않았다(ADR 0014)
	renew_interval 1m
	skip_install_trust
	https_port {$OPENIT_SERVICE_PORT}
	# 왜 /area-certs: 영역 안 공유 tmpfs 볼륨이다. 서비스가 이 폴더를 읽기 전용으로 마운트해 이웃을 부를 때 보일 클라이언트 인증서·키(OPENIT_TLS_*_FILE)를 읽는다
	storage file_system /area-certs
	servers {
		# 왜 strict_sni_host: 클라이언트 인증은 TLS 연결 정책(SNI 별)에 걸린다. SNI 와 Host 가 다른 요청을 받으면 인증이 걸리지 않은 연결로 서비스 이름의 Host 를 보낼 수 있다.
		# 둘이 같아야 요청을 받게 해 이 틈을 닫는다(Caddy 문서: 클라이언트 인증을 쓰면 필요한 안전장치)
		strict_sni_host on
	}
}

{$OPENIT_AREA_NAME} {
	tls {
		issuer acme {
			dir {$OPENIT_INTERNAL_ACME_DIRECTORY_URL}
			# 신뢰 목록의 루트로 step-ca 의 서버 인증서를 검증한다(검증을 끄지 않는다)
			trusted_roots /etc/openit/trust-list.pem
			# 왜 http-01 만: tls-alpn-01 은 443 번이어야 하고 이 컨테이너는 443 을 열지 않는다(RFC 8737 3). http-01(RFC 8555 8.3)은 80 번이다
			disable_tlsalpn_challenge
		}
		# 왜 require_and_verify: 영역 사이 mTLS(계약 area_mtls). 신뢰 목록의 루트가 서명한 클라이언트 인증서가 없는 연결은 핸드셰이크에서 끊는다
		client_auth {
			mode require_and_verify
			trust_pool file {
				pem_file /etc/openit/trust-list.pem
			}
		}
	}
	# 왜 입구의 인증서(SAN gateway)가 아니면 지운다: X-Forwarded-Client-Cert 는 입구(Envoy)가 검증한 기기 인증서를 담는다(계약 device_mtls).
	# 다른 이웃이나 입구를 거치지 않은 호출이 같은 머리글을 보내도 서비스에 닿지 않게 한다(위조 방지)
	@not_ingress not expression {http.request.tls.client.san.dns_names.0} == "gateway"
	request_header @not_ingress -X-Forwarded-Client-Cert
	reverse_proxy {$OPENIT_AREA_UPSTREAM} {
		# 왜 -1: 알림 스트림(streamStaffAlerts)과 응답 문장 스트림(startSessionStream, submitTurnStream, generateResponseStream)은 text/event-stream 이다. 버퍼 없이 바로 흘려 보낸다.
		# Caddy 문서는 Content-Type: text/event-stream 이면 이 값과 무관하게 바로 flush 한다고 하지만 그 판정에 기대지 않고 명시한다. 응답 시간 제한은 Caddy 의 기본이 없다(ADR 0009).
		# 왜 encode 를 쓰지 않는다: 압축은 조각을 모으고(계약 README 응답 문장 스트림 9항), 영역 안 평문 HTTP 와 영역 사이 TLS 에서 압축으로 얻을 것이 없다
		flush_interval -1
	}
}

# 영역 안 감시용 평문 포트(고정 9100, platform/src/openit_platform/area_gateway.py 의 MONITOR_PORT). backend 내부 네트워크에서만 닿고 입구(Envoy)로는 나가지 않는다.
# 상태 경로 셋만 서비스에 이어 주고 나머지는 404 로 닫는다
http://:9100 {
	request_header -X-Forwarded-Client-Cert
	@monitor path /healthz /readyz /metrics
	handle @monitor {
		reverse_proxy {$OPENIT_AREA_UPSTREAM}
	}
	handle {
		respond 404
	}
}
