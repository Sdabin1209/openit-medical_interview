# 설치처마다 다른 값의 예시(ADR 0004). 복사해 deploy/.env 로 두고 고친다. deploy/.env 는 git 제외다.
# 비밀은 여기에 적지 않는다(deploy/secrets/ 의 파일, ./deploy secrets init).
# 이 파일의 값이 기본값이다. deploy/.env 에 적은 키만 덮어쓴다(compose 와 ./deploy 가 같은 두 파일을 읽는다).
# 기간은 '<정수>h'(시간) 또는 '<정수>m'(분)이다(step-ca 가 읽는 형식). 값마다 근거는 ADR 0014 에 있다(측정한 값이 아닌 것은 그렇게 적었다).

# ---- 설치 ----
# compose 프로젝트 이름. 한 서버에 설치를 둘 이상 두면 서로 다르게 한다(컨테이너·볼륨 이름의 접두어가 된다).
OPENIT_PROJECT_NAME=openit

# 게이트웨이(Envoy)와 레지스트리가 호스트에서 듣는 주소. 포트는 Docker 가 배정한다(고정 포트 없음).
OPENIT_BIND_ADDRESS=127.0.0.1

# ---- 사람 인증(Keycloak, oauth2-proxy). 이름은 계약 PlatformEnv 를 따른다(platform ADR 0001) ----
# 발급자 주소(OIDC issuer). 토큰의 iss 가 된다. https 이고 `/realms/openit` 으로 끝나며 호스트는 OPENIT_PUBLIC_NAMES 안에 있어야 한다.
# 입구가 이 주소의 /realms/openit/ 와 /oauth2/ 를 Keycloak·oauth2-proxy 로 보낸다. 포트는 입구가 컨테이너 안에서 듣는 OPENIT_LISTEN_PORT 와 같게 쓴다
# (호스트에 게시된 포트는 Docker 가 배정한다. 설치처가 고정 주소를 따로 둔다면 그 주소로 바꾼다).
OPENIT_OIDC_ISSUER_URL=https://openit.internal:8443/realms/openit

# ---- 신뢰의 뿌리: 사설 CA(ADR 0013, 0014, 0015) ----
# 루트를 어디서 얻는가(계약 CaMode). self = 설치가 루트 CA 를 만든다(루트 개인 키는 이 관리 노드의 deploy/pki/ 에만 둔다).
# organization = 조직 CA 가 서명한 중간 CA 로 step-ca 를 운영한다(루트 키는 우리에게 없다: ./deploy ca csr, ./deploy ca install).
OPENIT_CA_MODE=self

# CA 이름(인증서 주체의 이름). 루트는 "<이름> Root CA", 중간은 "<이름> Intermediate CA".
OPENIT_CA_NAME=openit-internal-ca

# step-ca 자신의 서버 인증서에 넣을 DNS 이름(쉼표로 구분). 컨테이너 안 health 확인용 localhost 를 포함한다.
OPENIT_CA_DNS_NAMES=step-ca,localhost

# 사설 CA 가 발급해도 되는 이름(쉼표로 구분, step-ca 의 x509 정책 allow). 이 밖의 이름은 발급을 거부한다.
# 서비스 이름과 `*.<설치>.internal`(ICANN 이 사설용으로 예약한 TLD, 도메인이 없는 설치처의 기본)을 넣는다. <설치>는 설치처에 맞게 바꾼다.
OPENIT_CA_ALLOWED_DNS=registry,step-ca,gateway,openit.internal,*.openit.internal
# 발급해도 되는 IP 주소·대역(쉼표로 구분, CIDR). 서비스를 IP 로 부르는 설치처만 적는다. 비우면 IP 는 발급하지 않는다.
OPENIT_CA_ALLOWED_IPS=

# 인증서 수명. 루트 87600h = 10년, 중간 CA 26280h = 3년, 리프 168h = 7일(근거: ADR 0014). 리프의 하한은 step-ca 의 5m 이다.
OPENIT_CA_ROOT_LIFETIME=87600h
OPENIT_CA_INTERMEDIATE_LIFETIME=26280h
OPENIT_LEAF_LIFETIME=168h

# `./deploy ca status` 가 경보(rc=1)로 보는 남은 기간. 4320h = 180일, 2160h = 90일, 24h.
# 리프의 24h 는 platform/monitoring/rules.yml 의 86400 초와 같아야 한다(점검이 확인한다). 리프 수명을 바꾸면 함께 바꾼다.
OPENIT_CA_WARN_ROOT=4320h
OPENIT_CA_WARN_INTERMEDIATE=2160h
OPENIT_CA_WARN_LEAF=24h

# 서비스 사이(안쪽)에서 리프를 받는 ACME 주소(RFC 8555 디렉터리). step-ca 의 ACME provisioner 이름은 acme 이다.
OPENIT_INTERNAL_ACME_DIRECTORY_URL=https://step-ca:9000/acme/acme/directory

# ---- 신뢰 목록(trust bundle) ----
# 모든 서버·클라이언트가 같은 신뢰 목록으로 검증한다(서버별로 섞지 않는다, ADR 0015). 루트는 여럿 허용한다.
# 목록은 ./deploy bootstrap 과 ./deploy ca bundle 이 만든다: 이 설치의 루트 + OPENIT_TRUST_EXTRA_DIR 폴더의 *.crt·*.pem.
# 경로는 deploy/ 기준 상대 경로이거나 절대 경로다. 이름은 계약 PlatformEnv 의 OPENIT_TRUST_LIST_FILE 이다.
OPENIT_TRUST_LIST_FILE=./pki/trust-bundle.pem
OPENIT_TRUST_EXTRA_DIR=./pki/trust.d

# ---- 공개 입구(사람과 키오스크가 접속하는 주소, ADR 0015, platform ADR 0002) ----
# 입구 인증서를 누가 서명하는가(계약 IngressCertificateMode). private = 이 설치의 사설 CA(도메인이 없는 설치처, 루트를 키오스크·직원 PC 에 배포),
# organization = 조직이 발급한 인증서 파일(아래 두 파일), acme-public = 공인 CA 에서 ACME 로(공개 도메인이 있을 때).
OPENIT_INGRESS_CERTIFICATE_MODE=private
# 입구가 서비스하는 이름(쉼표로 구분, 인증서의 SAN). 첫 이름이 입구의 기본 이름이다. acme-public 이면 공개 도메인이어야 한다.
# private 이면 OPENIT_CA_ALLOWED_DNS 가 허용하는 이름이어야 한다. (계약 PlatformEnv 에 없는 설치 값이다: change-requests/platform-001)
OPENIT_PUBLIC_NAMES=openit.internal
# acme-public 일 때만 쓴다. 공인 CA 의 ACME 디렉터리 주소(계약 OPENIT_ACME_DIRECTORY_URL). 공인 CA 는 80 번(http-01)으로 되돌아 접속하므로
# 설치처가 공개 주소의 80 번을 입구(ingress-acme)로 이어 줘야 한다.
OPENIT_ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
# organization 일 때만 쓴다. 조직이 발급한 입구 인증서(PEM, 사슬 포함)와 개인 키 파일. bootstrap 이 검증하고 deploy/pki/ingress/ 에 복사한다.
# (계약 PlatformEnv 에 없는 설치 값이다: change-requests/platform-001)
OPENIT_INGRESS_CERTIFICATE_FILE=
OPENIT_INGRESS_PRIVATE_KEY_FILE=
# 입구가 서비스 컨테이너 안에서 듣는 포트(계약 OPENIT_LISTEN_PORT). 1024 이상이다(입구는 비 root 로 돈다).
OPENIT_LISTEN_PORT=8443
# 영역 서비스가 컨테이너 안에서 듣는 포트. 입구가 상류로 접속할 때와 감시가 /metrics 를 읽을 때 쓴다(deploy 가 각 서비스의 OPENIT_LISTEN_PORT 로 같은 값을 준다).
OPENIT_SERVICE_PORT=8443
# 키오스크 기기의 클라이언트 인증서를 검증할 조직 PKI 의 루트 파일(PEM, 계약 OPENIT_DEVICE_CA_CERTIFICATE_FILE). 비우면 기기 경로를 열 수 없다.
OPENIT_DEVICE_CA_CERTIFICATE_FILE=
# 기기 허용 목록 파일(계약 DeviceAllowlist 모양의 JSON, 계약 OPENIT_DEVICE_ALLOWLIST_FILE). 등록·회전·폐기는 이 파일을 바꾸고 ./deploy up 을 다시 한다.
OPENIT_DEVICE_ALLOWLIST_FILE=./device-allowlist.json
# 영역들의 노출 선언(계약 Exposure, 파일 이름 <서비스 이름>.json)을 모은 폴더(계약 OPENIT_EXPOSURES_DIR). ./deploy 가 이미지 라벨 io.openit.exposure 에서 채운다.
OPENIT_EXPOSURES_DIR=./generated/exposures
# 기계 호출자 표 파일(계약 MachineTokenTable 모양의 JSON, 계약 OPENIT_MACHINE_TOKENS_FILE). 호출자마다 사람 인증(Keycloak)의 기계 클라이언트가 만들어진다.
OPENIT_MACHINE_TOKENS_FILE=./machine-callers.json

# ---- 감시(ADR 0014, platform ADR 0005) ----
# 경보 수신처(계약 AlertReceiverUrl: https 웹훅 또는 mailto). 서버 전체가 멈추면 서버 안의 감시는 말이 없으므로, 수신처는 일정 간격의 생존 신호(Watchdog 경보)가
# 끊기는 것으로 서버 중단을 알아차려야 한다(서버 밖 감시, D10). 비우면 경보를 보내지 않고 doctor 가 알린다.
OPENIT_ALERT_RECEIVER_URL=
# mailto 수신처일 때만 쓴다. 메일을 내보낼 SMTP 서버(<호스트>:<포트>). (계약 PlatformEnv 에 없는 설치 값이다: change-requests/platform-001)
OPENIT_ALERT_SMTP_SMARTHOST=
# 경보 수신처로 생존 신호를 다시 보내는 간격. 1m 은 Prometheus 평가 주기와 같게 둔 선택값이고 측정하지 않았다(platform ADR 0005).
OPENIT_ALERT_HEARTBEAT_INTERVAL=1m

# ---- 이미지 레지스트리(ADR 0013) ----
# local = 이 설치가 레지스트리를 띄운다(관리 노드 서버 한 대면 그 서버). external = 설치처의 레지스트리를 쓴다(레지스트리 단계를 건너뛴다).
OPENIT_REGISTRY_MODE=local
# external 일 때 이미지 이름의 앞부분(<호스트[:포트]>/<경로>). local 이면 비워 둔다(주소는 Docker 가 배정한 포트로 정해진다).
OPENIT_REGISTRY_ADDRESS=
# local 일 때 레지스트리 인증서에 넣을 DNS 이름(쉼표로 구분). OPENIT_CA_ALLOWED_DNS 가 허용하는 이름이어야 한다.
OPENIT_REGISTRY_NAMES=registry
