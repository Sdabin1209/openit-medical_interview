# 설치처마다 다른 값의 예시(ADR 0004). 복사해 deploy/.env 로 두고 고친다. deploy/.env 는 git 제외다.
# 비밀은 여기에 적지 않는다(deploy/secrets/ 의 파일, ./deploy secrets init).
# 이 파일의 값이 기본값이다. deploy/.env 에 적은 키만 덮어쓴다(compose 와 ./deploy 가 같은 두 파일을 읽는다).
# 기간은 '<정수>h'(시간) 또는 '<정수>m'(분)이다(step-ca 가 읽는 형식). 값마다 근거는 ADR 0014 에 있다(측정한 값이 아닌 것은 그렇게 적었다).

# ---- 설치 ----
# compose 프로젝트 이름. 한 서버에 설치를 둘 이상 두면 서로 다르게 한다(컨테이너·볼륨 이름의 접두어가 된다).
OPENIT_PROJECT_NAME=openit

# 게이트웨이(Envoy)와 레지스트리가 호스트에서 듣는 주소. 포트는 Docker 가 배정한다(고정 포트 없음).
OPENIT_BIND_ADDRESS=127.0.0.1

# Keycloak 이 자신을 가리키는 공개 URL(발급하는 토큰의 issuer 가 된다). 설치처의 사람 인증 주소로 바꾼다.
OPENIT_KEYCLOAK_URL=http://keycloak:8080

# oauth2-proxy 가 로그인 뒤 돌아올 주소와 쿠키 도메인. 설치처 주소로 바꾼다.
OPENIT_OAUTH2_PROXY_REDIRECT_URL=http://localhost:4180/oauth2/callback

# ---- 신뢰의 뿌리: 사설 CA(ADR 0013, 0014, 0015) ----
# 루트를 어디서 얻는가. self = 설치가 루트 CA 를 만든다(루트 개인 키는 이 관리 노드의 deploy/pki/ 에만 둔다).
# institution = 기관 CA 가 서명한 중간 CA 로 step-ca 를 운영한다(루트 키는 우리에게 없다: ./deploy ca csr, ./deploy ca install).
OPENIT_CA_MODE=self

# CA 이름(인증서 주체의 이름). 루트는 "<이름> Root CA", 중간은 "<이름> Intermediate CA".
OPENIT_CA_NAME=openit-internal-ca

# step-ca 자신의 서버 인증서에 넣을 DNS 이름(쉼표로 구분). 컨테이너 안 health 확인용 localhost 를 포함한다.
OPENIT_CA_DNS_NAMES=step-ca,localhost

# 사설 CA 가 발급해도 되는 이름(쉼표로 구분, step-ca 의 x509 정책 allow). 이 밖의 이름은 발급을 거부한다.
# 서비스 이름과 `*.<설치>.internal`(ICANN 이 사설용으로 예약한 TLD, 도메인이 없는 설치처의 기본)을 넣는다. <설치>는 설치처에 맞게 바꾼다.
OPENIT_CA_ALLOWED_DNS=registry,step-ca,*.openit.internal
# 발급해도 되는 IP 주소·대역(쉼표로 구분, CIDR). 서비스를 IP 로 부르는 설치처만 적는다. 비우면 IP 는 발급하지 않는다.
OPENIT_CA_ALLOWED_IPS=

# 인증서 수명. 루트 87600h = 10년, 중간 CA 26280h = 3년, 리프 168h = 7일(근거: ADR 0014). 리프의 하한은 step-ca 의 5m 이다.
OPENIT_CA_ROOT_LIFETIME=87600h
OPENIT_CA_INTERMEDIATE_LIFETIME=26280h
OPENIT_LEAF_LIFETIME=168h

# `./deploy ca status` 가 경보(rc=1)로 보는 남은 기간. 4320h = 180일, 2160h = 90일, 24h.
# 리프의 24h 는 deploy/monitoring/rules.yml 의 86400 초와 같아야 한다(점검이 확인한다). 리프 수명을 바꾸면 함께 바꾼다.
OPENIT_CA_WARN_ROOT=4320h
OPENIT_CA_WARN_INTERMEDIATE=2160h
OPENIT_CA_WARN_LEAF=24h

# 서비스 사이(안쪽)에서 리프를 받는 ACME 주소(RFC 8555 디렉터리). step-ca 의 ACME provisioner 이름은 acme 이다.
OPENIT_INTERNAL_ACME_DIRECTORY_URL=https://step-ca:9000/acme/acme/directory

# ---- 신뢰 목록(trust bundle) ----
# 모든 서버·클라이언트가 같은 신뢰 목록으로 검증한다(서버별로 섞지 않는다, ADR 0015). 루트는 여럿 허용한다.
# 목록은 ./deploy bootstrap 과 ./deploy ca bundle 이 만든다: 이 설치의 루트 + OPENIT_TRUST_EXTRA_DIR 폴더의 *.crt·*.pem.
# 경로는 deploy/ 기준 상대 경로이거나 절대 경로다.
OPENIT_TRUST_BUNDLE_PATH=./pki/trust-bundle.pem
OPENIT_TRUST_EXTRA_DIR=./pki/trust.d

# ---- 공개 입구(사람과 키오스크가 접속하는 주소, ADR 0015) ----
# 입구 인증서를 누가 서명하는가. private = 이 설치의 사설 CA(도메인이 없는 설치처, 루트를 키오스크·직원 PC 에 배포),
# institution = 기관 CA 가 준 인증서 파일, public-acme = 공인 CA 에서 ACME 로(공개 도메인이 있을 때).
OPENIT_PUBLIC_CERT_MODE=private
# 입구가 서비스하는 이름(쉼표로 구분). public-acme 이면 공개 도메인이어야 한다.
OPENIT_PUBLIC_NAMES=
# public-acme 일 때만 쓴다. 공인 CA 의 ACME 디렉터리 주소.
OPENIT_PUBLIC_ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
# 키오스크 기기의 클라이언트 인증서를 검증할 기관 CA 루트 파일(PEM). 비우면 클라이언트 인증서를 요구하지 않는다.
OPENIT_KIOSK_CLIENT_CA_FILE=

# ---- 이미지 레지스트리(ADR 0013) ----
# local = 이 설치가 레지스트리를 띄운다(관리 노드 서버 한 대면 그 서버). external = 설치처의 레지스트리를 쓴다(레지스트리 단계를 건너뛴다).
OPENIT_REGISTRY_MODE=local
# external 일 때 이미지 이름의 앞부분(<호스트[:포트]>/<경로>). local 이면 비워 둔다(주소는 Docker 가 배정한 포트로 정해진다).
OPENIT_REGISTRY_ADDRESS=
# local 일 때 레지스트리 인증서에 넣을 DNS 이름(쉼표로 구분). OPENIT_CA_ALLOWED_DNS 가 허용하는 이름이어야 한다.
OPENIT_REGISTRY_NAMES=registry
