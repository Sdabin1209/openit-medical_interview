def is_running(service: str) -> bool:
    return bool(compose(["ps", "--quiet", "--status", "running", service], capture_output=True).stdout.strip())


def recreate(services: list[str]) -> None:
    # 왜 --no-deps(여러 서버): compose 는 이 서버에 없는 서비스(다른 서버에 배정된 것)를 의존성으로 이 서버에 띄운다
    extra = ["--no-deps"] if get_layout().multi else []
    for service in services:
        if compose(["up", "-d", "--wait", *extra, "--force-recreate", service]).returncode != 0:
            fail(f"{service} 를 다시 만들지 못했다. 진단을 위해 컨테이너와 로그를 남겨 두었다: ./deploy status")


@app.command()
def up() -> None:
    """compose 로 띄운다(health 가 될 때까지 기다린다). 바뀐 platform 설정은 돌고 있던 서비스를 다시 만들어 반영한다. 배치 설정이 여러 서버면 서버마다 그 서버의 서비스만 띄운다."""
    if not (SECRETS_DIR / next(iter(SECRET_NAMES))).is_file() or not (CA_DIR / "ca.json").is_file():
        fail("비밀 파일이나 CA 파일이 없다. 먼저 ./deploy bootstrap", EXIT_FAIL)
    if get_layout().multi:
        up_multi()
        return
    unbuilt = sync_image_env()
    if unbuilt:
        fail(f"이 엔진에 없는 이미지가 있다: {', '.join(unbuilt)}. ./deploy build 로 만들거나 ./deploy pull 로 받는다", EXIT_FAIL)
    prepare_platform()
    require_backup_config()
    running = {service for files in RECREATE_ON_CHANGE.values() for service in files if is_running(service)}
    changed = sorted(PENDING_CHANGES)
    result = compose(["up", "-d", "--wait"])
    if result.returncode != 0:
        fail(f"up 실패(rc={result.returncode}). 진단을 위해 컨테이너와 로그를 남겨 두었다: ./deploy status", EXIT_FAIL)
    again = sorted({service for name in changed for service in RECREATE_ON_CHANGE.get(name, ()) if service in running})
    if again:
        typer.echo(f"바뀐 설정을 반영하려고 다시 만든다: {', '.join(again)}")
        recreate(again)
    PENDING_CHANGES.clear()
    if "identity/openit-realm.json" in changed and is_running("keycloak"):
        typer.echo("알림: realm 파일이 바뀌었다. Keycloak 은 이미 있는 realm 을 다시 가져오지 않는다. ./deploy identity sync 로 반영한다")


def up_multi() -> None:
    """서버마다(플랫폼 서버 먼저) 이미지를 받고 파일을 올리고 그 서버의 서비스만 띄운다. 신뢰의 뿌리 -> 레지스트리 -> 이미지 순서는 bootstrap 이 먼저 지킨다."""
    prepare_platform()
    require_backup_config()
    changed = sorted(PENDING_CHANGES)
    for server in get_layout().order():
        typer.echo(f"[{server.name}] {server.address}: {', '.join(server.services)}")
        up_server(server, changed)
    PENDING_CHANGES.clear()


def up_server(server: dlayout.Server, changed: list[str]) -> None:
    with on_server(server):
        ensure_images(server)
        if (unbuilt := sync_image_env(server)):
            fail(f"서버 {server.name} 의 엔진에 없는 이미지가 있다: {', '.join(unbuilt)}. ./deploy build 로 만들거나 서버가 레지스트리에서 받을 수 있게 한다", EXIT_FAIL)
        stale = stage_server(server)
        model = compose_model(server)
        selected = selected_services(server, model)
        running = {service for service in selected if is_running(service)}
        for tier in dlayout.tiers(model, selected):  # type: ignore[arg-type]
            result = compose(["up", "-d", "--wait", "--no-deps", *tier])
            if result.returncode != 0:
                fail(f"서버 {server.name} 의 up 실패(rc={result.returncode}). 진단을 위해 컨테이너와 로그를 남겨 두었다: ./deploy status", EXIT_FAIL)
        again = sorted({service for name in changed for service in RECREATE_ON_CHANGE.get(name, ()) if service in running} | (set(stale) & running))
        if again:
            typer.echo(f"[{server.name}] 바뀐 설정을 반영하려고 다시 만든다: {', '.join(again)}")
            recreate(again)


def ensure_images(server: dlayout.Server) -> None:
    """서버의 엔진에 영역 이미지를 갖춘다. 빌드 엔진과 같은 엔진이면 이미 있고, 다른 엔진이면 lock 의 digest 로 레지스트리에서 받는다(docker pull, ADR 0013)."""
    if is_build_engine(server):
        return
    prefix = registry_target(reg_cfg()).prefix
    lock = read_lock()
    for name in deployed_images():
        if image_service(name) not in server.services:
            continue
        if name not in lock:
            fail(f"images.lock 에 '{name}' 이 없다. 먼저 ./deploy bootstrap 으로 이미지를 올린다")
        reference = f"{prefix}/{local_image(name)}@{lock[name]}"
        if docker(["image", "inspect", reference], capture_output=True).returncode != 0:
            pulled = docker(["pull", "--quiet", reference], capture_output=True)
            if pulled.returncode != 0:
                fail(f"서버 {server.name} 의 엔진이 {reference} 를 받지 못했다: {(pulled.stderr or pulled.stdout).strip()[-300:]}\n"
                     f"  이 서버의 호스트가 레지스트리 이름 {prefix.split(':')[0]} 을 플랫폼 서버 주소로 풀고(/etc/hosts), 신뢰 목록의 루트를 "
                     f"/etc/docker/certs.d/{prefix}/ca.crt 에 두어야 한다(INSTALL.md 의 서버 준비)")
        if docker(["tag", reference, f"{local_image(name)}:local"], capture_output=True).returncode != 0:
            fail(f"{name}: 내려받은 이미지에 이름을 붙이지 못했다")


@app.command()
def down(
    volumes: Annotated[bool, typer.Option("--volumes", help="볼륨(데이터베이스, 인증서 저장소)까지 지운다. 되돌릴 수 없다")] = False,
    yes: Annotated[bool, typer.Option("--yes", help="--volumes 로 데이터가 지워지는 것을 확인했다")] = False,
) -> None:
    """이 설치의 컨테이너를 내린다(여러 서버면 모든 서버, 서비스 서버 먼저 플랫폼 서버 마지막). 볼륨은 --volumes --yes 일 때만 지운다."""
    global LENIENT_GENERATION, FORCE_BACKUP_PROFILE  # noqa: PLW0603
    if volumes and not yes:
        fail("--volumes 는 데이터베이스와 인증서 저장소를 지운다. 확인했으면 --yes 를 붙인다", 2)
    LENIENT_GENERATION = True
    FORCE_BACKUP_PROFILE = True
    layout = get_layout()
    servers = list(reversed(layout.order())) if layout.multi else [layout.platform]
    failed: list[str] = []
    for server in servers:
        command = ["down", *(["--volumes"] if volumes else []), *(["--remove-orphans"] if layout.multi else [])]
        result = compose(command, server)
        if result.returncode != 0:
            failed.append(f"{server.name}(rc={result.returncode})")
        elif volumes and layout.multi:
            unstage_server(server)
    if failed:
        fail(f"down 실패: {', '.join(failed)}")


@app.command()
def status() -> None:
    """컨테이너 상태와 health 를 보인다(여러 서버면 모든 서버, 배정된 서비스가 없으면 그것도 정상이 아니다)."""
    layout = get_layout()
    servers = layout.order() if layout.multi else [layout.platform]
    unhealthy = 0
    seen = 0
    for server in servers:
        if layout.multi:
            typer.echo(f"[{server.name}] {server.address}")
        listing = compose(["ps", "--all", "--format", "json"], server, capture_output=True)
        if listing.returncode != 0:
            if not layout.multi:
                fail(f"status 실패(rc={listing.returncode}): {listing.stderr.strip()}")
            typer.echo(f"  FAIL 서버에 닿지 못했다(rc={listing.returncode}): {listing.stderr.strip()[-200:]}")
            unhealthy += 1
            continue
        rows = [json.loads(line) for line in listing.stdout.splitlines() if line.strip()]
        seen += len(rows)
        for row in rows:
            health = row.get("Health") or "-"
            typer.echo(f"{row['Service']:<16} {row['State']:<10} health={health}")
            if row["State"] != "running" or health not in ("healthy", "-"):
                unhealthy += 1
        if layout.multi:
            expected = selected_services(server, compose_model(server))
            missing = sorted(set(expected) - {row["Service"] for row in rows if row["State"] == "running"} - {row["Service"] for row in rows})
            for service in missing:
                typer.echo(f"{service:<16} {'없음':<10} (이 서버에 배정됐으나 컨테이너가 없다)")
            unhealthy += len(missing)
    if not seen and not unhealthy:
        no_target("떠 있는 컨테이너가 없다(./deploy up)")
    if unhealthy:
        fail(f"정상이 아닌 컨테이너 {unhealthy}개", EXIT_FAIL)


@app.command()
def job(name: Annotated[str, typer.Argument(help="잡 이름(jobs/<이름>)")]) -> None:
