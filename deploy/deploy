    return list(dict.fromkeys(names))


def egress_targets() -> dict[str, list[tuple[str, int]]]:
    return {spec.service: list(spec.targets) for spec in platform_generated().gateway.egress}


def layout_flows() -> list[dlayout.Flow]:
    settings = platform_generated().settings
    return dlayout.flows(
        get_layout(),
        service_port=settings.service_port,
        listen_port=settings.listen_port,
        registry_local=env_values()["OPENIT_REGISTRY_MODE"] == "local",
        egress=egress_targets(),
        public_hosts=(settings.public_host, *settings.public_names),
        registry_hosts=tuple(reg_cfg().names) if env_values()["OPENIT_REGISTRY_MODE"] == "local" else (),
    )


def prepare_layout(server: dlayout.Server) -> dict[str, Path]:
    """서버의 가장자리 설정, compose 덮개, 환경 파일을 쓴다(같은 입력이면 같은 파일). 경로를 돌려준다."""
    layout = get_layout()
    settings = platform_generated().settings
    generated = platform_generated()
    try:
        hosts = dlayout.hosts_for(layout, server, platform_names=platform_names())
        step_ca = None if server is layout.platform else (acme_name(), dlayout.resolve_ip(layout.platform.address))
    except dlayout.LayoutError as error:
        fail("배치 설정이 틀렸다:\n  " + "\n  ".join(error.problems))
    edge_yaml = LAYOUT_DIR / server.name / "edge.yaml"
    write_if_changed(
        edge_yaml,
        pf_edge_render(settings, generated, server, layout),
    )
    override = dlayout.server_override(
        layout, server, flow_list=layout_flows(), hosts=hosts, step_ca=step_ca, service_port=settings.service_port,
        listen_port=settings.listen_port, registry_local=env_values()["OPENIT_REGISTRY_MODE"] == "local",
    )
    files = {"override": LAYOUT_DIR / f"{server.name}.yaml", "env": LAYOUT_DIR / f"{server.name}.env", "stage": LAYOUT_DIR / f"{server.name}.stage.yaml"}
    write_if_changed(files["override"], dlayout.dump_yaml(override, f"./deploy 가 서버 {server.name} 의 배치 설정에서 만든다(ADR 0026). 손으로 고치지 않는다."))
    write_if_changed(files["env"], f"# ./deploy 가 만든다. 서버 {server.name} 의 compose 가 읽는 값이다.\nOPENIT_EDGE_CONFIG={edge_yaml}\n")
    return files


def pf_edge_render(settings: object, generated: pf_generate.Generated, server: dlayout.Server, layout: dlayout.Layout) -> str:
    from openit_platform import gateway as pf_gateway  # noqa: PLC0415

    egress_services = [] if server is layout.platform else list(server.areas)  # 왜: 플랫폼 서버에서는 입구가 나가는 터널을 맡는다
    config = pf_edge.build_edge(settings, generated.gateway, areas=list(server.areas), egress_services=egress_services)  # type: ignore[arg-type]
    return pf_gateway.render(config).replace("platform/src/openit_platform/gateway.py", "platform/src/openit_platform/edge.py")


def compose_model(server: dlayout.Server) -> dict[str, object]:
    """이 서버의 compose 모델(덮개까지 합친 `config --format json`, 파일 올리기 덮개는 뺀 것)."""
    with on_server(server):
        result = docker([*compose_args(server, staged=False), "config", "--format", "json"], capture_output=True)
    if result.returncode != 0:
        fail(f"서버 {server.name} 의 compose config 실패: {result.stderr.strip()[-400:]}")
    return json.loads(result.stdout)  # type: ignore[no-any-return]


def selected_services(server: dlayout.Server, model: dict[str, object]) -> list[str]:
    return dlayout.services_in(
        model, get_layout(), server,  # type: ignore[arg-type]
        registry_local=env_values()["OPENIT_REGISTRY_MODE"] == "local" and server is get_layout().platform,
        inference_local=env_values()["OPENIT_INFERENCE_ENGINE_LOCAL"] == "true" and "model-runtime" in server.services,
    )


def tool_image() -> str:
    """서버 엔진에서 파일을 올리고 지우는 일회용 컨테이너의 이미지(compose.yaml 의 레지스트리 앞단 Caddy, digest 고정). 모든 서버가 이미 받는 이미지다(영역 게이트웨이도 같은 것)."""
    return str(yaml.safe_load(COMPOSE_FILE.read_text(encoding="utf-8"))["services"]["registry"]["image"])


def stage_root(server: dlayout.Server) -> str:
    """서버의 엔진 호스트에서 이 서버 프로젝트의 파일을 두는 폴더(OPENIT_STAGE_ROOT/<프로젝트>)."""
    return f"{env_values()['OPENIT_STAGE_ROOT'].rstrip('/')}/{server_project(server)}"


def stage_server(server: dlayout.Server) -> list[str]:
    """여러 서버일 때 서버의 엔진 호스트에 compose 가 읽는 파일을 올린다(bind mount 는 엔진 호스트의 경로라 원격 엔진에는 관리 노드의 경로가 없다).

    엔진 API 만 쓴다: 일회용 컨테이너가 스테이징 폴더를 bind mount 하고 표준 입력의 tar 를 푼다(ssh·rsync 가 필요 없다). 서비스는 그 경로를 bind mount 한다.
    지난번과 내용이 바뀐 파일을 쓰는 서비스 이름을 돌려준다(돌고 있으면 다시 만들어야 읽는다).
    """
    if not get_layout().multi:
        return []
    model = compose_model(server)
    selected = selected_services(server, model)
    root = stage_root(server)
    entries, document, users = dlayout.stage_plan(model, selected, root=root)  # type: ignore[arg-type]
    files = prepare_layout(server)
    write_if_changed(files["stage"], dlayout.dump_yaml(document, f"./deploy 가 서버 {server.name} 에 올릴 파일의 마운트를 만든다(ADR 0026). 손으로 고치지 않는다."))
    digests = {entry.rel: dlayout.entry_digest(entry) for entry in entries}
    state_file = LAYOUT_DIR / f"{server.name}.stage.json"
    before = json.loads(state_file.read_text(encoding="utf-8")) if state_file.is_file() else {}
    changed_entries = [entry for entry in entries if before.get(entry.rel) != digests[entry.rel]]
    changed = sorted({service for entry in changed_entries if entry.rel in before for service in users[entry.rel]})
    # 왜 바뀐 폴더만 비운다: 폴더를 지우고 다시 만들면 그 폴더를 마운트한 컨테이너가 지워진 폴더를 계속 본다. 안의 내용만 비우고 폴더는 둔다
    clear = " ".join(f"find /stage/{entry.rel} -mindepth 1 -delete;" for entry in changed_entries if entry.source.is_dir() and entry.rel in before)
    if changed_entries:
        # 왜 바뀐 것만: 안 바뀐 파일을 다시 쓰면 파일이 새로 만들어져(unlink 뒤 create) 그 파일을 bind mount 한 컨테이너가 다시 시작할 때 원본을 못 찾는다
        with on_server(server):
            uploaded = docker_bytes(["run", "--rm", "-i", "--entrypoint", "sh", "-v", f"{root}:/stage", tool_image(), "-c",
                                     f"chmod 700 /stage; {clear} tar -x -C /stage"], dlayout.build_tar(changed_entries))
        if uploaded.returncode != 0:
            fail(f"서버 {server.name}: 파일을 올리지 못했다(rc={uploaded.returncode}): {uploaded.stderr.decode(errors='replace').strip()[-300:]}")
    state_file.write_text(json.dumps(digests, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    return changed


def unstage_server(server: dlayout.Server) -> None:
    """down --volumes: 서버의 엔진 호스트에서 이 프로젝트의 스테이징 폴더를 지운다(비밀 파일 사본이 남지 않게)."""
    root = stage_root(server)
    parent, _, name = root.rpartition("/")
    with on_server(server):
        docker(["run", "--rm", "--entrypoint", "sh", "-v", f"{parent}:/stage", tool_image(), "-c", f"rm -rf /stage/{name}"],
               capture_output=True)
    (LAYOUT_DIR / f"{server.name}.stage.json").unlink(missing_ok=True)


def git(*args: str) -> str:
    result = subprocess.run(["git", "-C", str(ROOT), *args], capture_output=True, text=True, check=False)  # noqa: S603, S607
    if result.returncode != 0:
        fail(f"git {' '.join(args)} 실패(rc={result.returncode}): {result.stderr.strip()}")
    return result.stdout.strip()


def area_targets() -> dict[str, str]:
    """bake 대상 이름 -> 종류. services/·jobs/·web/ 폴더가 정본이다."""
    targets: dict[str, str] = {}
    for kind, folder, prefix in (("service", "services", ""), ("job", "jobs", ""), ("web", "web", "web-")):
        base = ROOT / folder
        if base.is_dir():
            for child in sorted(base.iterdir()):
                if child.is_dir() and (child / "Dockerfile").is_file():
                    name = child.name if kind in ("service", "job") else prefix + child.name.lstrip("_")
                    targets[name] = kind
    return targets


DECLARATION_FILES = {"jobs": "jobs.json", "exposure": "exposure.json", "inputs": "inputs.json"}  # 이미지 라벨 io.openit.<이름> 의 원본(영역 폴더)


def area_declarations() -> str:
    """대상 이름 -> {jobs, exposure, inputs}(각각 한 줄 JSON 글자). 원본은 영역 폴더의 jobs.json·exposure.json·inputs.json 이다.

    이미지 라벨 io.openit.jobs(JobsDeclaration)·io.openit.exposure(Exposure)·io.openit.inputs(ContainerInputs)가 된다(docker-bake.hcl 의 AREA_DECLARATIONS).
    파일이 있으면 계약 스키마로 검증하지 않고 모양만(JSON) 본다: 계약 검증은 영역 시험과 `./deploy doctor` 가 한다.
    잡 이미지는 jobs.json, 상시 서비스·화면은 inputs.json(D134: 모든 영역 이미지의 필수 선언)이 없으면 빌드를 막는다. 밑줄로 시작하는 틀 시험 영역은 건너뛴다.
    """
    found: dict[str, dict[str, str]] = {}
    for name, kind in area_targets().items():
        folder = ROOT / area_folder(name, kind)
        entry: dict[str, str] = {}
        for key, filename in DECLARATION_FILES.items():
            path = folder / filename
            if path.is_file():
                try:
                    entry[key] = json.dumps(json.loads(path.read_text(encoding="utf-8")), ensure_ascii=False, separators=(",", ":"))
                except json.JSONDecodeError as error:
                    fail(f"{path.relative_to(ROOT)} 가 JSON 이 아니다: {error}")
        template_area = folder.name.startswith("_")
        if kind == "job" and "jobs" not in entry and not template_area:
            fail(f"{folder.relative_to(ROOT)}: jobs.json 이 없다(JobsDeclaration)")
        if "inputs" not in entry and not template_area:
            fail(f"{folder.relative_to(ROOT)}: inputs.json 이 없다(ContainerInputs, D134)")
        found[name] = entry
    return json.dumps(found, ensure_ascii=False, separators=(",", ":"))


def read_lock() -> dict[str, str]:
    lock: dict[str, str] = {}
    if LOCK_FILE.exists():
        for line in LOCK_FILE.read_text(encoding="utf-8").splitlines():
            if line and not line.startswith("#"):
                key, _, value = line.partition(" ")
                lock[key] = value
    return lock


def write_lock(lock: dict[str, str]) -> None:
    header = "# `deploy/deploy build` 와 `deploy/deploy bootstrap` 이 쓴다. 한 줄 = <대상> <이미지 digest>. 직접 고치지 않는다.\n"
    LOCK_FILE.write_text(header + "".join(f"{k} {v}\n" for k, v in sorted(lock.items())), encoding="utf-8")


# ---------------------------------------------------------------- platform 준비(platform ADR 0001~0005)


def install_egress_targets(service: str) -> list[dict[str, object]]:
    """설치 설정이 정하는 나가는 호출 상대(ExternalEgressTarget). 호스트가 설치처마다 달라 영역 이미지의 노출 선언에 못 박지 못한다(변경 요청 model-runtime-005).

    model-runtime 은 레지스트리(OPENIT_REGISTRY_HOST 의 443 번 또는 external 레지스트리 주소), survey-service 는 웹 푸시 서비스(OPENIT_PUSH_SERVICE_HOSTS)다.
    """
    env = env_values()
    hosts: list[str] = []
    if service == "model-runtime":
        if env["OPENIT_REGISTRY_MODE"] == "external":
            hosts.append(env["OPENIT_REGISTRY_ADDRESS"].split("/")[0])
        else:
            hosts.append(f"{env['OPENIT_REGISTRY_NAMES'].split(',')[0].strip()}:443")
    if service == "survey-service":
        hosts += [item.strip() for item in env["OPENIT_PUSH_SERVICE_HOSTS"].split(",") if item.strip()]
    targets: list[dict[str, object]] = []
    for item in hosts:
        host, _, port = item.partition(":")
        targets.append({"host": host, "port": int(port or 443)})  # 왜 443: 레지스트리·웹 푸시는 TLS 이고 https 의 기본 포트다(RFC 9110 4.2.2)
    return targets


def sync_exposures() -> None:
    """이미지 라벨 io.openit.exposure 의 노출 선언에 설치 설정의 나가는 상대를 더해 OPENIT_EXPOSURES_DIR 에 <서비스 이름>.json 으로 쓴다. 라벨이 없는 이미지는 건너뛴다."""
    from openit_platform.contract.models import ServiceName  # noqa: PLC0415

    allowed = {item.value for item in ServiceName}
    folder = pki.resolve_path(DEPLOY, env_values()["OPENIT_EXPOSURES_DIR"])
    for name in area_targets():
        service = name.removeprefix("web-")
        if service not in allowed:
            continue
        reference = f"{local_image(name)}:local"
        label = docker(["image", "inspect", "--format", '{{ index .Config.Labels "io.openit.exposure" }}', reference], capture_output=True)
        text = label.stdout.strip()
        if label.returncode != 0 or text in ("", "<no value>"):
            continue
        declaration = json.loads(text)
        declaration["egress"] = [*declaration["egress"], *install_egress_targets(service)]
        write_if_changed(folder / f"{service}.json", json.dumps(declaration, ensure_ascii=False, indent=2, sort_keys=True) + "\n")


def validate_device_ca(path: Path | None) -> None:
    """기기 인증서를 검증할 조직 PKI 루트: 읽을 수 있고, CA 이고, 유효 기간 안이다."""
    if path is None:
        return
    if not path.is_file():
        fail(f"OPENIT_DEVICE_CA_CERTIFICATE_FILE 파일이 없다: {path}")
    try:
        certs = pki.load_certs(path)
    except ValueError as error:
        fail(f"기기 CA 파일이 PEM 인증서가 아니다: {error}")
    for cert in certs:
        problems = [item for item in pki.check_ca(cert)]
        if problems:
            fail(f"기기 CA {pki.subject_text(cert)} 를 쓸 수 없다: {', '.join(problems)}")


def install_ingress_certificate(cfg: object) -> None:
    """organization 방식: 조직이 준 입구 인증서를 검증하고 pki/ingress/ 에 복사한다(없으면 폴더만 만든다)."""
    target = PKI_DIR / "ingress"
    private_dir(PKI_DIR)
    target.mkdir(exist_ok=True)
    target.chmod(0o755)  # 왜 0755: 폴더째 컨테이너에 마운트된다. 호스트 쪽 접근은 부모 pki/(0700)가 막는다(ADR 0008)
    settings = cfg  # type: ignore[assignment]
    if settings.ingress_mode != "organization":  # type: ignore[attr-defined]
        return
    cert_file, key_file = settings.ingress_certificate_file, settings.ingress_private_key_file  # type: ignore[attr-defined]
    for path in (cert_file, key_file):
        if path is None or not path.is_file():
            fail(f"organization 방식의 입구 인증서 파일이 없다: {path}")
    chain = pki.load_certs(cert_file)
    problems: list[str] = []
    try:
        if not pki.key_matches_cert(key_file, None, chain[0]):
            problems.append("개인 키가 인증서와 짝이 아니다")
    except (ValueError, TypeError) as error:
        problems.append(f"개인 키를 열지 못했다(암호가 걸려 있거나 키가 아니다): {error}")
    if not bundle_path().is_file():
        fail("신뢰 목록이 없다(./deploy bootstrap 의 신뢰의 뿌리 단계가 먼저다)")
    roots = pki.load_certs(bundle_path())
    problems += pki.verify_server_chain(chain, roots, list(settings.public_names))  # type: ignore[attr-defined]
    if problems:
        fail("입구 인증서를 쓸 수 없다:\n  " + "\n  ".join(problems))
    write_if_changed(target / "tls.crt", pki.pem_text(chain))
    write_if_changed(target / "tls.key", key_file.read_text(encoding="utf-8"))
    for name in ("tls.crt", "tls.key"):
        (target / name).chmod(0o644)  # 왜 0644: 컨테이너 사용자가 읽는다(ADR 0008)


def prepare_platform() -> None:
    """생성 전에 갖출 것: 이미지 라벨의 노출 선언, 기기 CA 검증, 입구 인증서(organization). 마지막에 생성 파일을 맞춘다."""
    secrets_init()  # 기계 호출자 비밀 파일 포함(이미 있는 것은 건드리지 않는다)
    sync_exposures()
    platform_generated.cache_clear()
    cfg = platform_generated().settings
    validate_device_ca(cfg.device_ca_file)
    install_ingress_certificate(cfg)
    sync_generated()


def throwaway_certificate(directory: Path, paths: tuple[str, ...]) -> None:
    """설정 검증용: 입구 설정이 읽는 자리(컨테이너 안 경로)마다 쓸모없는 자체 서명 인증서와 키를 둔다. 실제 인증서가 아니다."""
    from cryptography import x509  # noqa: PLC0415
    from cryptography.hazmat.primitives import hashes, serialization  # noqa: PLC0415
    from cryptography.hazmat.primitives.asymmetric import ec  # noqa: PLC0415
    from cryptography.x509.oid import NameOID  # noqa: PLC0415

    key = ec.generate_private_key(ec.SECP256R1())
    name = x509.Name([x509.NameAttribute(NameOID.COMMON_NAME, "config-check")])
    now = datetime.now(UTC)
    cert = x509.CertificateBuilder().subject_name(name).issuer_name(name).public_key(key.public_key()).serial_number(1) \
        .not_valid_before(now).not_valid_after(now.replace(year=now.year + 1)).sign(key, hashes.SHA256())
    cert_pem = cert.public_bytes(serialization.Encoding.PEM)
    key_pem = key.private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, serialization.NoEncryption())
    for container_path in paths:
        target = directory / container_path.lstrip("/")
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(key_pem if container_path.endswith(".key") else cert_pem)
    (directory / "throwaway.pem").write_bytes(cert_pem)


def validate_platform_configs() -> list[tuple[str, bool, str]]:
    """생성된 입구(Envoy)·입구 에이전트(Caddy)·경보(Alertmanager) 설정을 각 제품의 검증 명령으로 본다. (이름, 통과, 자세한 말) 목록."""
    import tempfile  # noqa: PLC0415

    generated = platform_generated()
    results: list[tuple[str, bool, str]] = []
    with tempfile.TemporaryDirectory(prefix="openit-pf-validate-") as tmp:
        root = Path(tmp)
        throwaway_certificate(root, generated.certificate_paths)
        trust = bundle_path() if bundle_path().is_file() else root / "throwaway.pem"
        device = GENERATED / pf_generate.DEVICE_CA_PLACEHOLDER
        device_ca = device if device.is_file() and device.stat().st_size else root / "throwaway.pem"
        run = ["run", "--rm", "--network", "none", "--read-only", "--tmpfs", "/tmp", "--cap-drop", "ALL"]
        org_dir = root / "etc/openit/ingress"
        org_dir.mkdir(parents=True, exist_ok=True)
        # 컨테이너 안 경로와 같은 자리에 마운트한다: /ingress-certs 아래와 /etc/openit/ingress
        envoy = docker([*run, "--user", "10001:10001", "-v", f"{root / 'ingress-certs'}:/ingress-certs:ro", "-v", f"{org_dir}:/etc/openit/ingress:ro",
                        "-v", f"{GENERATED / 'gateway' / 'envoy.yaml'}:/etc/envoy/envoy.yaml:ro", "-v", f"{GENERATED / 'gateway' / 'sds'}:/etc/envoy/sds:ro", "-v", f"{trust}:/etc/openit/trust-list.pem:ro",
                        "-v", f"{device_ca}:/etc/openit/device-ca.pem:ro", service_image("envoy"), "--mode", "validate", "-c", "/etc/envoy/envoy.yaml"],
                       capture_output=True)
        results.append(("입구(Envoy) 설정 검증", envoy.returncode == 0, (envoy.stdout + envoy.stderr).strip()[-400:]))
        # 왜 tmpfs: 검증이 저장소에 쓴다. 호스트 폴더에 쓰게 하면 컨테이너 사용자 소유 파일이 남아 지워지지 않는다
        caddy = docker([*run, "--user", "10001:10001", "--tmpfs", "/ingress-certs:uid=10001", "--tmpfs", "/data:uid=10001", "--tmpfs", "/config:uid=10001",
                        "-v", f"{GENERATED / 'ingress' / 'Caddyfile'}:/etc/caddy/Caddyfile:ro", "-v", f"{trust}:/etc/openit/trust-list.pem:ro",
                        service_image("ingress-acme"), "caddy", "validate", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"], capture_output=True)
        results.append(("입구 인증서 에이전트(Caddyfile) 검증", caddy.returncode == 0, (caddy.stdout + caddy.stderr).strip()[-400:]))
        amtool = docker([*run, "-v", f"{GENERATED / 'monitoring'}:/etc/alertmanager:ro", "--entrypoint", "amtool", service_image("alertmanager"),
                         "check-config", "/etc/alertmanager/alertmanager.yml"], capture_output=True)
        results.append(("경보 수신 설정 검증(amtool)", amtool.returncode == 0, (amtool.stdout + amtool.stderr).strip()[-400:]))
    return results


def endpoint_host(endpoint: str) -> str | None:
    """ssh://사용자@호스트[:포트] 나 tcp://호스트:포트 의 호스트. unix 소켓이면 None(같은 호스트의 엔진이라 주소를 대조할 수 없다)."""
    if not endpoint.startswith(("ssh://", "tcp://")):
        return None
    return endpoint.split("://", 1)[1].rpartition("@")[2].split(":")[0]


def doctor_layout(check: Callable[..., None]) -> None:
    """배치 설정 점검(ADR 0026): 서버마다 docker context 와 엔진, 주소, 서비스 배정, 서버 사이에 열어야 하는 포트."""
    layout = get_layout()
    typer.echo(f"[--] 배치: {'배치 설정 파일' if layout.explicit else '파일 없음 = 서버 한 대(관리 노드의 엔진)'}, 서버 {len(layout.servers)}대")
    for server in layout.servers:
        typer.echo(f"      {server.name} {server.address}: {', '.join(server.services)}")
    if not layout.multi:
        return
    check("compose 서비스 라벨(서버 배정의 기준)", not (missing := dlayout.unlabeled_services(compose_model(layout.platform))), f"라벨 io.openit.service 가 없다: {', '.join(missing)}")
    for server in layout.servers:
        try:
            endpoint = dockerenv.docker_env(server_environ(server))["DOCKER_HOST"]
        except dockerenv.DockerEnvError as error:
            check(f"서버 {server.name} 의 docker context", False,
                  f"{error}. 만들기: DOCKER_CONFIG=\"$PWD/.docker-config\" docker context create {server.name} --docker host=ssh://<사용자>@{server.address}")
            continue
        host = endpoint_host(endpoint)
        check(f"서버 {server.name} 의 docker context 가 주소 {server.address} 를 가리킨다", host is None or host == server.address,
              f"context 의 엔드포인트 호스트는 {host} 이다")
        with on_server(server):
            engine = docker(["version", "--format", "{{.Server.Version}}"], capture_output=True)
            check(f"서버 {server.name} 의 엔진 응답", engine.returncode == 0, "엔진에 연결하지 못했다")
            if engine.returncode == 0 and "model-runtime" in server.services and env_values()["OPENIT_INFERENCE_ENGINE_LOCAL"] == "true":
                runtimes = docker(["info", "--format", "{{json .Runtimes}}"], capture_output=True).stdout
                check(f"서버 {server.name}: 추론 엔진용 nvidia 런타임", "nvidia" in runtimes, "NVIDIA 컨테이너 툴킷을 설치하고 도커에 nvidia 런타임을 등록한다")
        try:
            dlayout.resolve_ip(server.address)
            check(f"서버 {server.name} 의 주소 {server.address} 를 IPv4 로 풀 수 있다", True)
        except dlayout.LayoutError as error:
            check(f"서버 {server.name} 의 주소 풀이", False, "; ".join(error.problems))
    flow_list = layout_flows()
    settings = platform_generated().settings
    problems = dlayout.port_problems(layout, flow_list, service_port=settings.service_port, listen_port=settings.listen_port,
                                     registry_local=env_values()["OPENIT_REGISTRY_MODE"] == "local")
    check("서버 안 게시 포트가 겹치지 않는다", not problems, "; ".join(problems))
    typer.echo("[--] 서버 사이에 열어야 하는 포트(방화벽에서 이 방향만 연다):")
    for flow in flow_list:
        typer.echo(f"      {flow.src} -> {flow.dst}:{flow.port}  {flow.purpose}")
    if env_values()["OPENIT_REGISTRY_MODE"] == "local":
        typer.echo(f"[--] 서버의 엔진 호스트마다 필요한 것: /etc/hosts 에 '{layout.platform.address} {reg_cfg().names[0]}', /etc/docker/certs.d/{reg_cfg().names[0]}:443/ca.crt 에 신뢰 목록의 루트(INSTALL.md)")


@app.command()
def doctor() -> None:
    """필요한 도구·버전·포트·비밀 파일이 갖춰졌는지 확인한다."""
    problems: list[str] = []

    def check(label: str, ok: bool, detail: str = "") -> None:
        typer.echo(f"[{'OK' if ok else 'FAIL'}] {label}" + (f" - {detail}" if detail and not ok else ""))
        if not ok:
            problems.append(label)

    for tool in ("git", "uv", "docker"):
        check(f"{tool} 설치", shutil.which(tool) is not None)
    try:
        env = dockerenv.docker_env()
        check("docker 격리 설정", True)
        typer.echo(f"      DOCKER_CONFIG={env['DOCKER_CONFIG']}")
    except dockerenv.DockerEnvError as error:
        check("docker 격리 설정", False, str(error))
        fail(f"doctor 실패: {len(problems)}건", EXIT_FAIL)
    engine = docker(["version", "--format", "{{.Server.Version}}"], capture_output=True)
    check("docker 엔진 응답", engine.returncode == 0, "엔진에 연결하지 못했다")
    buildx = docker(["buildx", "version"], capture_output=True)
    check("docker buildx", buildx.returncode == 0)
    compose_version = docker(["compose", "version"], capture_output=True)
    check("docker compose", compose_version.returncode == 0)
    missing = [name for name in SECRET_FILES_REQUIRED if not (SECRETS_DIR / name).is_file()]
    check("비밀 파일", not missing, f"없음: {', '.join(missing)} (./deploy secrets init)")
    sync_exposures()  # 왜 먼저: 이미지 라벨의 노출 선언이 입구 라우트(겹침·작업 인증 요구)로 풀리는지까지 본다. 이미지가 아직 없으면 건너뛴다
    platform_generated.cache_clear()
    try:
        generated = pf_generate.generate(pki.load_env(DEPLOY), DEPLOY, ROOT, registry_local=env_values()["OPENIT_REGISTRY_MODE"] == "local")
    except (pki.ConfigError, OSError, ValueError) as error:
        # 노출 선언·허용 목록·기계 호출자 표를 계약으로 검증하다 틀리면 여기서 [FAIL] 로 알리고 compose 가 읽는 생성 파일을 만들지 못하면 나머지 점검을 할 수 없어 여기서 멈춘다
        check("platform 설정 생성(노출 선언·허용 목록·기계 호출자 표 검증)", False, str(error))
        fail(f"doctor 실패: {len(problems)}건", EXIT_FAIL)
    check("platform 설정 생성(노출 선언·허용 목록·기계 호출자 표 검증)", True)
    typer.echo("      " + generated.summary.replace("\n", "\n      "))
    config = compose(["config", "--format", "json"], capture_output=True)
    check("compose config 검증", config.returncode == 0, config.stderr.strip()[-300:])
    if config.returncode == 0:
        model = json.loads(config.stdout)
        fixed = [
            f"{name}:{port.get('published')}"
            for name, svc in model.get("services", {}).items()
            for port in svc.get("ports", [])
            if port.get("published")
        ]
        if get_layout().multi:
            typer.echo("[OK] 고정 호스트 포트: 서버를 넘는 호출에 필요한 것만 서버 주소에 게시한다(아래 '서버 사이에 열어야 하는 포트')")
        else:
            check("고정 호스트 포트 없음", not fixed, ", ".join(fixed))
        unpinned = [n for n, s in model.get("services", {}).items() if "@sha256:" not in s.get("image", "")]
        check("compose 이미지 digest 고정", not unpinned, ", ".join(unpinned))
    if env_values()["OPENIT_INFERENCE_ENGINE_LOCAL"] not in ("true", "false"):
        check("추론 엔진 배치 설정", False, "OPENIT_INFERENCE_ENGINE_LOCAL 은 true 또는 false 다")
    elif env_values()["OPENIT_INFERENCE_ENGINE_LOCAL"] == "true" and not env_values()["OPENIT_BASE_MODEL"]:
        check("추론 엔진 배치 설정", False, "OPENIT_INFERENCE_ENGINE_LOCAL=true 인데 OPENIT_BASE_MODEL 이 비어 있다")
    else:
        typer.echo(f"[OK] 추론 엔진 배치: 이 서버에서 {'띄운다' if env_values()['OPENIT_INFERENCE_ENGINE_LOCAL'] == 'true' else '띄우지 않는다(서빙 GPU 서버 배치)'}")
    monitoring = docker(
        ["run", "--rm", "--network", "none", "--entrypoint", "sh", "-v", f"{PLATFORM / 'monitoring'}:/etc/prometheus:ro", prometheus_image(),
         "-c", "cd /etc/prometheus && promtool check config --lint=none prometheus.yml && promtool test rules rules.test.yml"],
        capture_output=True,
    )
    check("감시 설정·경보 규칙 검증(promtool)", monitoring.returncode == 0, (monitoring.stdout + monitoring.stderr).strip()[-300:])
    try:
        pki.ca_settings(env_values())
        pki.registry_settings(env_values())
        check("인증서·레지스트리 설정 검증", True)
    except pki.ConfigError as error:
        check("인증서·레지스트리 설정 검증", False, str(error))
    try:
        validate_device_ca(generated.settings.device_ca_file)
        check("기기 CA 파일", True)
    except typer.Exit:
        check("기기 CA 파일", False, "위 메시지를 본다")
    for label, ok, detail in validate_platform_configs():
        check(label, ok, detail)
    doctor_layout(check)
    if not generated.settings.alert_receiver_url:
        typer.echo("[--] 경보 수신처(OPENIT_ALERT_RECEIVER_URL)가 비어 있다. 경보를 어디로도 보내지 않고 서버 중단도 알릴 수 없다")
    if problems:
        fail(f"doctor 실패: {len(problems)}건", EXIT_FAIL)
    typer.echo("doctor 통과")


@secrets_app.command("init")
def secrets_init() -> None:
    """비밀 파일을 만든다. 이미 있는 파일은 건드리지 않는다. 값은 출력하지 않는다."""
    SECRETS_DIR.mkdir(parents=True, exist_ok=True)
    SECRETS_DIR.chmod(0o700)
    for name, size in SECRET_NAMES.items():
        path = SECRETS_DIR / name
        if path.exists():
            path.chmod(0o644)
            typer.echo(f"있음: {name}")
            continue
        # 왜 token_hex: PyPA/파이썬 문서가 비밀 생성에 권하는 secrets 모듈(CSPRNG). 16바이트면 oauth2-proxy 쿠키 비밀 길이 조건을 맞춘다
        path.write_text(pysecrets.token_hex(size // 2 if name == "oauth2_proxy_cookie_secret" else size), encoding="utf-8")
        # 왜 0644: compose 파일 비밀은 bind mount 라 호스트 권한이 그대로 보인다. 컨테이너 사용자(postgres 999, keycloak 1000 등)가
        # 읽으려면 읽기 가능해야 하고, 호스트 쪽 접근은 0700 폴더가 막는다(ADR 0008)
        path.chmod(0o644)
        typer.echo(f"만듦: {name}")
    ensure_special_secrets()
    ensure_machine_secrets()


def ensure_special_secrets() -> None:
    """무작위 16진수가 아닌 모양의 비밀을 만든다. 이미 있는 파일은 건드리지 않는다. 값은 출력하지 않는다."""
    from cryptography.hazmat.primitives import serialization  # noqa: PLC0415
    from cryptography.hazmat.primitives.asymmetric import ec  # noqa: PLC0415

    vapid = SECRETS_DIR / "vapid_private_key"
    if not vapid.exists():
        # 왜 P-256 PEM: 웹 푸시 서버 신원은 VAPID(RFC 8292)이고 JWT 서명은 ES256(P-256)이다. survey-service 의 link_push 가 이 PEM 을 읽는다
        key = ec.generate_private_key(ec.SECP256R1())
        vapid.write_bytes(key.private_bytes(serialization.Encoding.PEM, serialization.PrivateFormat.PKCS8, serialization.NoEncryption()))
        typer.echo("만듦: vapid_private_key")
    vapid.chmod(0o644)  # 왜 0644: 컨테이너 사용자(uid 10001)가 읽는다. 호스트 쪽 접근은 0700 폴더가 막는다(ADR 0008)
    credentials = SECRETS_DIR / "registry_credentials"
    if not credentials.exists():
        # 왜 한 줄 '사용자:비밀번호': 계약 ModelRuntimeEnv 의 레지스트리 자격 형식(OCI Distribution 의 HTTP 기본 인증, RFC 7617). 로컬 레지스트리에는 인증이 없어(ADR 0013) 아직 쓰이지 않는다
        credentials.write_text(f"model-runtime:{pysecrets.token_hex(16)}", encoding="utf-8")
        typer.echo("만듦: registry_credentials")
    credentials.chmod(0o644)


def ensure_machine_secrets() -> None:
    """기계 호출자(MachineTokenTable)마다 Keycloak 기계 클라이언트의 비밀 파일을 만든다. 이미 있는 파일은 건드리지 않는다. 값은 출력하지 않는다."""
    table_file = pki.resolve_path(DEPLOY, env_values()["OPENIT_MACHINE_TOKENS_FILE"])
    try:
        table = pf_identity.load_machine_table(table_file)
    except pki.ConfigError as error:
        fail(str(error))
    MACHINE_SECRETS_DIR.mkdir(parents=True, exist_ok=True)
    MACHINE_SECRETS_DIR.chmod(0o755)  # 왜 0755: 폴더째 컨테이너에 마운트되므로 컨테이너 사용자가 들어갈 수 있어야 한다. 호스트 쪽 접근은 부모 secrets/(0700)가 막는다(ADR 0008)
    for entry in table.tokens:
        path = MACHINE_SECRETS_DIR / entry.client.root
        if not path.exists():
            path.write_text(pysecrets.token_hex(32), encoding="utf-8")
            typer.echo(f"만듦: machine-clients/{entry.client.root}")
        path.chmod(0o644)


def trivy(args: list[str], stage: Path | None = None) -> subprocess.CompletedProcess[str]:
    """Trivy 를 공식 이미지(digest 고정, compose.tools.yaml 의 trivy 서비스)로 일회용 실행한다. 리포는 읽기 전용으로 /src 에 보인다.

    왜 compose.yaml 이 아닌가: 빌드는 설치 설정(기기 CA, 인증서, 영역 노출 선언)을 읽지 않는다. compose.yaml 은 platform 설정 생성을 거쳐야 읽힌다(release·run 단계).
    """
    TRIVY_CACHE.mkdir(exist_ok=True)
    command = ["compose", "--project-name", f"{project_name()}-tools", "--project-directory", str(DEPLOY), "-f", str(TOOLS_COMPOSE_FILE), "run", "--rm", "--no-deps", "-T", "--user", f"{os.getuid()}:{os.getgid()}",
               "-v", f"{ROOT}:/src:ro", "-v", f"{TRIVY_CACHE}:/cache"]
    if stage is not None:
        command += ["-v", f"{stage}:/w:ro"]
    return docker([*command, "trivy", *args, "--ignorefile", "/src/.trivyignore"], capture_output=True)


def trivy_or_fail(what: str, result: subprocess.CompletedProcess[str]) -> None:
    if result.returncode != 0:
        tail = (result.stdout + result.stderr).strip().splitlines()[-40:]
        fail(f"{what} 실패(rc={result.returncode}):\n" + "\n".join(tail))
    typer.echo(f"Trivy 통과: {what}")


def area_folder(name: str, kind: str) -> str:
    """대상 이름('_example', 'web-example')에 해당하는 폴더(리포 기준 상대 경로)."""
    base, prefix = {"web": ("web", "web-"), "job": ("jobs", ""), "service": ("services", "")}[kind]
    for child in sorted((ROOT / base).iterdir()):
        if child.is_dir() and (child / "Dockerfile").is_file() and (child.name if kind != "web" else prefix + child.name.lstrip("_")) == name:
            return f"{base}/{child.name}"
    fail(f"대상 '{name}' 의 폴더를 찾지 못했다")


def trivy_config_scan(names: list[str], targets: dict[str, str]) -> None:
    """빌드 전: Dockerfile 과 배포 구성(compose)의 보안 설정을 본다."""
    for name in names:
        folder = area_folder(name, targets[name])
        trivy_or_fail(f"trivy config {folder}", trivy(["config", "--severity", TRIVY_SEVERITY, "--exit-code", "1", *TRIVY_SKIP_LOCAL, f"/src/{folder}"]))
    trivy_or_fail("trivy config deploy", trivy(["config", "--severity", TRIVY_SEVERITY, "--exit-code", "1", "/src/deploy/compose.yaml"]))


def trivy_image_scan(names: list[str]) -> None:
    """빌드 뒤: 이미지의 알려진 취약점을 본다. 이미지는 docker save 한 파일로 넘긴다(도커 소켓을 Trivy 에 주지 않는다)."""
    stage = META_DIR / "scan"
    stage.mkdir(parents=True, exist_ok=True)
    for name in names:
        archive = stage / f"{name}.tar"
        if (saved := docker(["save", f"{local_image(name)}:local", "-o", str(archive)], capture_output=True)).returncode != 0:
            fail(f"{name} 저장 실패: {saved.stderr.strip()[-300:]}")
        result = trivy(["image", "--input", f"/w/{archive.name}", "--severity", TRIVY_SEVERITY, "--ignore-unfixed", "--exit-code", "1"], stage)
        archive.unlink(missing_ok=True)
        trivy_or_fail(f"trivy image {local_image(name)}", result)


def notices_scan(names: list[str], targets: dict[str, str]) -> None:
    """빌드 뒤: 이미지 안의 THIRD_PARTY_NOTICES 가 잠금 파일에서 만든 것과 같은지 본다(ADR 0018). 어긋나면 lock 에 digest 를 쓰지 않는다."""
    env = {k: v for k, v in os.environ.items() if k != "VIRTUAL_ENV"}  # 왜: deploy 자신의 uv 스크립트 환경이 tools/checks 의 uv run 에 섞여 경고가 나는 것을 막는다
    for name in names:
        result = subprocess.run(  # noqa: S603, S607
            ["uv", "run", "--project", str(ROOT / "tools" / "checks"), "--frozen", "openit-notices", "--root", str(ROOT),
             "image", str(ROOT / area_folder(name, targets[name])), "--image", f"{local_image(name)}:local"],
            cwd=ROOT, env=env, text=True, check=False,
        )  # fmt: skip
        if result.returncode != 0:
            fail(f"{name}: 이미지의 제3자 고지 점검 실패(rc={result.returncode})")


@app.command()
def build(
    service: Annotated[str | None, typer.Argument(help="빌드할 대상(없으면 전부)")] = None,
    check: Annotated[bool, typer.Option("--check", help="빌드하지 않고 Dockerfile 을 검사한다(docker buildx bake --check)")] = False,
) -> None:
    """이미지를 빌드하고 images.lock 을 갱신한다."""
    targets = area_targets()
    if not targets:
        no_target("services/·jobs/·web/ 에 Dockerfile 이 있는 영역이 없다")
    if service is not None and service not in targets:
        fail(f"알 수 없는 대상 '{service}'. 가능: {', '.join(targets)}", 2)
    names = [service] if service else list(targets)
    revision = git("rev-parse", "HEAD")
    contracts = git("rev-parse", "HEAD:contracts") if (ROOT / "contracts").is_dir() else ""
    if not contracts:
        fail("contracts/ 가 없어 계약 버전을 정할 수 없다")
    if not check:
        trivy_config_scan(names, targets)
    META_DIR.mkdir(exist_ok=True)
    meta = META_DIR / f"bake-{time.time_ns()}.json"
    env = dockerenv.docker_env()
    # 왜 git describe: 이미지 버전을 사람이 정한 숫자가 아니라 커밋(태그가 있으면 태그)에서 얻는다
    env.update(VERSION=git("describe", "--tags", "--always"), REVISION=revision, CONTRACTS_VERSION=contracts, SOURCE_URL=git("remote", "get-url", "origin"))
    env["AREA_DECLARATIONS"] = area_declarations()
    mode = ["--check"] if check else ["--load", "--metadata-file", str(meta)]
    result = subprocess.run(  # noqa: S603, S607
        ["docker", "buildx", "bake", "-f", str(ROOT / "docker-bake.hcl"), *mode, *names],
        env=env, cwd=ROOT, text=True, check=False,
    )
    if result.returncode != 0:
        fail(f"{'검사' if check else '빌드'} 실패(rc={result.returncode})")
    if check:
        typer.echo("Dockerfile 검사 통과")
        return
    notices_scan(names, targets)  # 왜 lock 을 쓰기 전: 고지가 없거나 잠금 파일과 다른 이미지의 digest 를 기록하지 않는다
    trivy_image_scan(names)  # 왜 lock 을 쓰기 전: 검사를 통과하지 못한 이미지의 digest 를 기록하지 않는다
    built = json.loads(meta.read_text(encoding="utf-8"))
    lock = read_lock()
    for name in names:
        info = built.get(name, {})
        digest = info.get("containerimage.digest") or info.get("containerimage.config.digest")
        if not digest:
            fail(f"{name}: 빌드 결과에서 digest 를 찾지 못했다")
        lock[name] = digest
    write_lock(lock)
    for name in names:
        typer.echo(f"빌드됨: {name} {lock[name]}")


