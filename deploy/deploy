def fail(message: str, code: int = EXIT_FAIL) -> NoReturn:
    typer.echo(message, err=True)
    raise typer.Exit(code)


def no_target(message: str) -> NoReturn:
    fail(f"대상 없음: {message}", EXIT_NO_TARGET)


def docker(args: list[str], **kwargs: object) -> subprocess.CompletedProcess[str]:
    try:
        return dockerenv.run_docker(args, **kwargs)
    except dockerenv.DockerEnvError as error:
        fail(f"docker 환경을 정하지 못했다: {error}")


def env_values() -> dict[str, str]:
    try:
        return pki.load_env(DEPLOY)
    except (pki.ConfigError, OSError) as error:
        fail(f"설정을 읽지 못했다: {error}")


def project_name() -> str:
    return env_values()["OPENIT_PROJECT_NAME"]


def compose_args() -> list[str]:
    args = ["compose", "--project-name", project_name(), "--project-directory", str(DEPLOY), "-f", str(COMPOSE_FILE),
            "--env-file", str(DEPLOY / "env.example")]
    if env_values()["OPENIT_REGISTRY_MODE"] == "local":
        args += ["--profile", "local-registry"]  # 왜: external 이면 레지스트리 서비스를 띄우지 않는다(ADR 0013)
    if (DEPLOY / ".env").exists():
        args += ["--env-file", str(DEPLOY / ".env")]  # 뒤의 파일이 앞을 덮는다(설치처 값)
    return args


def compose(args: list[str], **kwargs: object) -> subprocess.CompletedProcess[str]:
    return docker([*compose_args(), *args], **kwargs)


def git(*args: str) -> str:
    result = subprocess.run(["git", "-C", str(ROOT), *args], capture_output=True, text=True, check=False)  # noqa: S603, S607
    if result.returncode != 0:
        fail(f"git {' '.join(args)} 실패(rc={result.returncode}): {result.stderr.strip()}")
    return result.stdout.strip()


def area_targets() -> dict[str, str]:
    """bake 대상 이름 -> 종류. services/·web/ 폴더가 정본이다."""
    targets: dict[str, str] = {}
    for kind, folder, prefix in (("service", "services", ""), ("web", "web", "web-")):
        base = ROOT / folder
        if base.is_dir():
            for child in sorted(base.iterdir()):
                if child.is_dir() and (child / "Dockerfile").is_file():
                    name = child.name if kind == "service" else prefix + child.name.lstrip("_")
                    targets[name] = kind
    return targets


def read_lock() -> dict[str, str]:
    lock: dict[str, str] = {}
    if LOCK_FILE.exists():
        for line in LOCK_FILE.read_text(encoding="utf-8").splitlines():
            if line and not line.startswith("#"):
                key, _, value = line.partition(" ")
                lock[key] = value
    return lock


def write_lock(lock: dict[str, str]) -> None:
    header = "# `deploy/deploy build` 와 `deploy/deploy bootstrap` 이 쓴다. 한 줄 = <대상> <이미지 digest>. 직접 고치지 않는다.\n"
    LOCK_FILE.write_text(header + "".join(f"{k} {v}\n" for k, v in sorted(lock.items())), encoding="utf-8")


@app.command()
def doctor() -> None:
    """필요한 도구·버전·포트·비밀 파일이 갖춰졌는지 확인한다."""
    problems: list[str] = []

    def check(label: str, ok: bool, detail: str = "") -> None:
        typer.echo(f"[{'OK' if ok else 'FAIL'}] {label}" + (f" - {detail}" if detail and not ok else ""))
        if not ok:
            problems.append(label)

    for tool in ("git", "uv", "docker"):
        check(f"{tool} 설치", shutil.which(tool) is not None)
    try:
        env = dockerenv.docker_env()
        check("docker 격리 설정", True)
        typer.echo(f"      DOCKER_CONFIG={env['DOCKER_CONFIG']}")
    except dockerenv.DockerEnvError as error:
        check("docker 격리 설정", False, str(error))
        fail(f"doctor 실패: {len(problems)}건", EXIT_FAIL)
    engine = docker(["version", "--format", "{{.Server.Version}}"], capture_output=True)
    check("docker 엔진 응답", engine.returncode == 0, "엔진에 연결하지 못했다")
    buildx = docker(["buildx", "version"], capture_output=True)
    check("docker buildx", buildx.returncode == 0)
    compose_version = docker(["compose", "version"], capture_output=True)
    check("docker compose", compose_version.returncode == 0)
    missing = [name for name in SECRET_NAMES if not (SECRETS_DIR / name).is_file()]
    check("비밀 파일", not missing, f"없음: {', '.join(missing)} (./deploy secrets init)")
    config = compose(["config", "--format", "json"], capture_output=True)
    check("compose config 검증", config.returncode == 0, config.stderr.strip()[-300:])
    if config.returncode == 0:
        model = json.loads(config.stdout)
        fixed = [
            f"{name}:{port.get('published')}"
            for name, svc in model.get("services", {}).items()
            for port in svc.get("ports", [])
            if port.get("published")
        ]
        check("고정 호스트 포트 없음", not fixed, ", ".join(fixed))
        unpinned = [n for n, s in model.get("services", {}).items() if "@sha256:" not in s.get("image", "")]
        check("compose 이미지 digest 고정", not unpinned, ", ".join(unpinned))
    monitoring = docker(
        ["run", "--rm", "--network", "none", "--entrypoint", "sh", "-v", f"{DEPLOY / 'monitoring'}:/etc/prometheus:ro", prometheus_image(),
         "-c", "cd /etc/prometheus && promtool check config --lint=none prometheus.yml && promtool test rules rules.test.yml"],
        capture_output=True,
    )
    check("감시 설정·경보 규칙 검증(promtool)", monitoring.returncode == 0, (monitoring.stdout + monitoring.stderr).strip()[-300:])
    try:
        pki.ca_settings(env_values())
        pki.registry_settings(env_values())
        check("인증서·레지스트리 설정 검증", True)
    except pki.ConfigError as error:
        check("인증서·레지스트리 설정 검증", False, str(error))
    if problems:
        fail(f"doctor 실패: {len(problems)}건", EXIT_FAIL)
    typer.echo("doctor 통과")


@secrets_app.command("init")
def secrets_init() -> None:
    """비밀 파일을 만든다. 이미 있는 파일은 건드리지 않는다. 값은 출력하지 않는다."""
    SECRETS_DIR.mkdir(parents=True, exist_ok=True)
    SECRETS_DIR.chmod(0o700)
    for name, size in SECRET_NAMES.items():
        path = SECRETS_DIR / name
        if path.exists():
            path.chmod(0o644)
            typer.echo(f"있음: {name}")
            continue
        # 왜 token_hex: PyPA/파이썬 문서가 비밀 생성에 권하는 secrets 모듈(CSPRNG). 16바이트면 oauth2-proxy 쿠키 비밀 길이 조건을 맞춘다
        path.write_text(pysecrets.token_hex(size // 2 if name == "oauth2_proxy_cookie_secret" else size), encoding="utf-8")
        # 왜 0644: compose 파일 비밀은 bind mount 라 호스트 권한이 그대로 보인다. 컨테이너 사용자(postgres 999, keycloak 1000 등)가
        # 읽으려면 읽기 가능해야 하고, 호스트 쪽 접근은 0700 폴더가 막는다(ADR 0008)
        path.chmod(0o644)
        typer.echo(f"만듦: {name}")


def trivy(args: list[str], stage: Path | None = None) -> subprocess.CompletedProcess[str]:
    """Trivy 를 공식 이미지(digest 고정, compose 의 trivy 서비스)로 일회용 실행한다. 리포는 읽기 전용으로 /src 에 보인다."""
    TRIVY_CACHE.mkdir(exist_ok=True)
    command = [*compose_args(), "--profile", "tools", "run", "--rm", "--no-deps", "-T", "--user", f"{os.getuid()}:{os.getgid()}",
               "-v", f"{ROOT}:/src:ro", "-v", f"{TRIVY_CACHE}:/cache"]
    if stage is not None:
        command += ["-v", f"{stage}:/w:ro"]
    return docker([*command, "trivy", *args, "--ignorefile", "/src/.trivyignore"], capture_output=True)


def trivy_or_fail(what: str, result: subprocess.CompletedProcess[str]) -> None:
    if result.returncode != 0:
        tail = (result.stdout + result.stderr).strip().splitlines()[-40:]
        fail(f"{what} 실패(rc={result.returncode}):\n" + "\n".join(tail))
    typer.echo(f"Trivy 통과: {what}")


def area_folder(name: str, kind: str) -> str:
    """대상 이름('_example', 'web-example')에 해당하는 폴더(리포 기준 상대 경로)."""
    base, prefix = ("web", "web-") if kind == "web" else ("services", "")
    for child in sorted((ROOT / base).iterdir()):
        if child.is_dir() and (child / "Dockerfile").is_file() and (child.name if kind == "service" else prefix + child.name.lstrip("_")) == name:
            return f"{base}/{child.name}"
    fail(f"대상 '{name}' 의 폴더를 찾지 못했다")


def trivy_config_scan(names: list[str], targets: dict[str, str]) -> None:
    """빌드 전: Dockerfile 과 배포 구성(compose)의 보안 설정을 본다."""
    for name in names:
        folder = area_folder(name, targets[name])
        trivy_or_fail(f"trivy config {folder}", trivy(["config", "--severity", TRIVY_SEVERITY, "--exit-code", "1", f"/src/{folder}"]))
    trivy_or_fail("trivy config deploy", trivy(["config", "--severity", TRIVY_SEVERITY, "--exit-code", "1", "/src/deploy/compose.yaml"]))


def trivy_image_scan(names: list[str]) -> None:
    """빌드 뒤: 이미지의 알려진 취약점을 본다. 이미지는 docker save 한 파일로 넘긴다(도커 소켓을 Trivy 에 주지 않는다)."""
    stage = META_DIR / "scan"
    stage.mkdir(parents=True, exist_ok=True)
    for name in names:
        archive = stage / f"{name}.tar"
        if (saved := docker(["save", f"{local_image(name)}:local", "-o", str(archive)], capture_output=True)).returncode != 0:
            fail(f"{name} 저장 실패: {saved.stderr.strip()[-300:]}")
        result = trivy(["image", "--input", f"/w/{archive.name}", "--severity", TRIVY_SEVERITY, "--ignore-unfixed", "--exit-code", "1"], stage)
        archive.unlink(missing_ok=True)
        trivy_or_fail(f"trivy image {local_image(name)}", result)


def notices_scan(names: list[str], targets: dict[str, str]) -> None:
    """빌드 뒤: 이미지 안의 THIRD_PARTY_NOTICES 가 잠금 파일에서 만든 것과 같은지 본다(ADR 0018). 어긋나면 lock 에 digest 를 쓰지 않는다."""
    env = {k: v for k, v in os.environ.items() if k != "VIRTUAL_ENV"}  # 왜: deploy 자신의 uv 스크립트 환경이 tools/checks 의 uv run 에 섞여 경고가 나는 것을 막는다
    for name in names:
        result = subprocess.run(  # noqa: S603, S607
            ["uv", "run", "--project", str(ROOT / "tools" / "checks"), "--frozen", "openit-notices", "--root", str(ROOT),
             "image", str(ROOT / area_folder(name, targets[name])), "--image", f"{local_image(name)}:local"],
            cwd=ROOT, env=env, text=True, check=False,
        )  # fmt: skip
        if result.returncode != 0:
            fail(f"{name}: 이미지의 제3자 고지 점검 실패(rc={result.returncode})")


@app.command()
def build(
    service: Annotated[str | None, typer.Argument(help="빌드할 대상(없으면 전부)")] = None,
    check: Annotated[bool, typer.Option("--check", help="빌드하지 않고 Dockerfile 을 검사한다(docker buildx bake --check)")] = False,
) -> None:
    """이미지를 빌드하고 images.lock 을 갱신한다."""
    targets = area_targets()
    if not targets:
        no_target("services/·web/ 에 Dockerfile 이 있는 영역이 없다")
    if service is not None and service not in targets:
        fail(f"알 수 없는 대상 '{service}'. 가능: {', '.join(targets)}", 2)
    names = [service] if service else list(targets)
    revision = git("rev-parse", "HEAD")
    contracts = git("rev-parse", "HEAD:contracts") if (ROOT / "contracts").is_dir() else ""
    if not contracts:
        fail("contracts/ 가 없어 계약 버전을 정할 수 없다")
    if not check:
        trivy_config_scan(names, targets)
    META_DIR.mkdir(exist_ok=True)
    meta = META_DIR / f"bake-{time.time_ns()}.json"
    env = dockerenv.docker_env()
    # 왜 git describe: 이미지 버전을 사람이 정한 숫자가 아니라 커밋(태그가 있으면 태그)에서 얻는다
    env.update(VERSION=git("describe", "--tags", "--always"), REVISION=revision, CONTRACTS_VERSION=contracts, SOURCE_URL=git("remote", "get-url", "origin"))
    mode = ["--check"] if check else ["--load", "--metadata-file", str(meta)]
    result = subprocess.run(  # noqa: S603, S607
        ["docker", "buildx", "bake", "-f", str(ROOT / "docker-bake.hcl"), *mode, *names],
        env=env, cwd=ROOT, text=True, check=False,
    )
    if result.returncode != 0:
        fail(f"{'검사' if check else '빌드'} 실패(rc={result.returncode})")
    if check:
        typer.echo("Dockerfile 검사 통과")
        return
    notices_scan(names, targets)  # 왜 lock 을 쓰기 전: 고지가 없거나 잠금 파일과 다른 이미지의 digest 를 기록하지 않는다
    trivy_image_scan(names)  # 왜 lock 을 쓰기 전: 검사를 통과하지 못한 이미지의 digest 를 기록하지 않는다
    built = json.loads(meta.read_text(encoding="utf-8"))
    lock = read_lock()
    for name in names:
        info = built.get(name, {})
        digest = info.get("containerimage.digest") or info.get("containerimage.config.digest")
        if not digest:
            fail(f"{name}: 빌드 결과에서 digest 를 찾지 못했다")
        lock[name] = digest
    write_lock(lock)
    for name in names:
        typer.echo(f"빌드됨: {name} {lock[name]}")


@app.command()
def up() -> None:
    """compose 로 띄운다(health 가 될 때까지 기다린다)."""
    if not (SECRETS_DIR / next(iter(SECRET_NAMES))).is_file() or not (CA_DIR / "ca.json").is_file():
        fail("비밀 파일이나 CA 파일이 없다. 먼저 ./deploy bootstrap", EXIT_FAIL)
    result = compose(["up", "-d", "--wait"])
    if result.returncode != 0:
        fail(f"up 실패(rc={result.returncode}). 진단을 위해 컨테이너와 로그를 남겨 두었다: ./deploy status", EXIT_FAIL)


@app.command()
def down() -> None:
    """이 프로젝트(openit)의 컨테이너를 내린다. 볼륨은 지우지 않는다."""
    result = compose(["down"])
    if result.returncode != 0:
        fail(f"down 실패(rc={result.returncode})")


@app.command()
def status() -> None:
    """컨테이너 상태와 health 를 보인다."""
    listing = compose(["ps", "--all", "--format", "json"], capture_output=True)
    if listing.returncode != 0:
        fail(f"status 실패(rc={listing.returncode}): {listing.stderr.strip()}")
    rows = [json.loads(line) for line in listing.stdout.splitlines() if line.strip()]
    if not rows:
        no_target("떠 있는 컨테이너가 없다(./deploy up)")
    unhealthy = 0
    for row in rows:
        health = row.get("Health") or "-"
        typer.echo(f"{row['Service']:<16} {row['State']:<10} health={health}")
        if row["State"] != "running" or health not in ("healthy", "-"):
            unhealthy += 1
    if unhealthy:
        fail(f"정상이 아닌 컨테이너 {unhealthy}개", EXIT_FAIL)


@app.command()
def job(name: Annotated[str, typer.Argument(help="잡 이름(jobs/<이름>)")]) -> None:
    """잡을 한 번 실행한다(스케줄러가 부르는 것과 같다)."""
    if not (ROOT / "jobs" / name).is_dir():
        no_target(f"jobs/{name} 가 없다")
    services = compose(["config", "--services"], capture_output=True).stdout.split()
    if name not in services:
        no_target(f"compose 에 잡 서비스 '{name}' 이 없다")
    result = compose(["run", "--rm", name])
    if result.returncode != 0:
        fail(f"잡 {name} 실패(rc={result.returncode})", result.returncode)


DB_NAME_RE = re.compile(r"^[A-Za-z0-9_]+$")


def psql(sql: str, database: str = "template1", stdin: str | None = None) -> subprocess.CompletedProcess[str]:
    args = ["exec", "-T", "postgres", "psql", "--username", "postgres", "--dbname", database, "--no-psqlrc", "--quiet"]
    if stdin is None:
        args += ["--tuples-only", "--no-align", "--set", "ON_ERROR_STOP=1", "--command", sql]
    return compose(args, input=stdin, capture_output=True)


@app.command()
def backup() -> None:
    """PostgreSQL 을 deploy/backups/postgres-<시각>/ 에 저장한다(역할 globals.sql + 데이터베이스마다 <이름>.sql.gz).

    왜 pg_dumpall 한 파일이 아닌가: --clean 덤프는 쓰는 중인 데이터베이스와 현재 사용자를 지우려다 복원이 실패한다(시험에서 확인).
    """
    listing = psql("select datname || '|' || pg_get_userbyid(datdba) from pg_database where not datistemplate")
    if listing.returncode != 0:
        fail(f"백업 실패(rc={listing.returncode}). postgres 가 떠 있는지 ./deploy status")
    target = BACKUP_DIR / f"postgres-{time.strftime('%Y%m%dT%H%M%S')}"
    target.mkdir(parents=True)
    target.chmod(0o700)
    globals_dump = compose(["exec", "-T", "postgres", "pg_dumpall", "--username", "postgres", "--globals-only"], capture_output=True)
    if globals_dump.returncode != 0:
        fail(f"역할 백업 실패(rc={globals_dump.returncode})")
    (target / "globals.sql").write_text(globals_dump.stdout, encoding="utf-8")
    owners: dict[str, str] = {}
    for line in listing.stdout.split():
        name, _, owner = line.partition("|")
        if not DB_NAME_RE.match(name) or not DB_NAME_RE.match(owner):
            fail("데이터베이스·소유자 이름이 [A-Za-z0-9_] 가 아니라 백업할 수 없다")
        dump = compose(["exec", "-T", "postgres", "pg_dump", "--username", "postgres", "--dbname", name, "--format=plain"],
                       capture_output=True)
        if dump.returncode != 0:
            fail(f"{name} 백업 실패(rc={dump.returncode})")
        with gzip.open(target / f"{name}.sql.gz", "wt", encoding="utf-8") as handle:
            handle.write(dump.stdout)
        owners[name] = owner
    (target / "owners.json").write_text(json.dumps(owners, indent=2), encoding="utf-8")
    typer.echo(f"백업: {target.relative_to(ROOT)} (데이터베이스 {len(owners)}개)")


@app.command()
def restore(
    folder: Annotated[Path, typer.Argument(help="backup 이 만든 폴더")],
    yes: Annotated[bool, typer.Option("--yes", help="덮어쓰기를 확인했다")] = False,
) -> None:
    """백업에서 PostgreSQL 을 복원한다(백업에 있는 데이터베이스를 지우고 다시 만든다)."""
    if not (folder / "owners.json").is_file():
        fail(f"백업 폴더가 아니다: {folder}")
    if not yes:
        fail("복원은 기존 데이터를 덮어쓴다. 확인했으면 --yes 를 붙인다", 2)
    owners: dict[str, str] = json.loads((folder / "owners.json").read_text(encoding="utf-8"))
    # 왜 먼저 멈춘다: 서비스가 붙어 있으면 데이터가 복원 도중 바뀐다
    others = [s for s in compose(["config", "--services"], capture_output=True).stdout.split() if s != "postgres"]
    if others and compose(["stop", *others]).returncode != 0:
        fail("postgres 를 쓰는 서비스를 멈추지 못했다")
    # 역할은 이미 있으면 CREATE ROLE 이 실패하고 건너뛴다(ON_ERROR_STOP 없음). 같은 역할은 그대로 둔다
    psql("", stdin=(folder / "globals.sql").read_text(encoding="utf-8"))
    for name, owner in owners.items():
        # 왜 WITH (FORCE): PostgreSQL 13+ 표준 옵션으로 남은 연결을 끊고 지운다
        steps = [f'DROP DATABASE IF EXISTS "{name}" WITH (FORCE)', f'CREATE DATABASE "{name}" OWNER "{owner}"']
        for step in steps:
            if (result := psql(step)).returncode != 0:
                fail(f"{name} 복원 실패(rc={result.returncode}): {result.stderr.strip()[-300:]}")
        with gzip.open(folder / f"{name}.sql.gz", "rt", encoding="utf-8") as handle:
            sql = handle.read()
        result = compose(["exec", "-T", "postgres", "psql", "--username", "postgres", "--dbname", name, "--no-psqlrc", "--quiet",
                          "--set", "ON_ERROR_STOP=1"], input=sql, capture_output=True)
        if result.returncode != 0:
            fail(f"{name} 복원 실패(rc={result.returncode}): {result.stderr.strip()[-300:]}")
    typer.echo("복원 완료. 멈춘 서비스는 ./deploy up 으로 다시 띄운다")


# ---------------------------------------------------------------- 신뢰의 뿌리: 사설 CA(ADR 0014, 0015)


def ca_cfg() -> pki.CaSettings:
    try:
        return pki.ca_settings(env_values())
    except pki.ConfigError as error:
        fail(f"인증서 설정이 틀렸다: {error}")


def reg_cfg() -> pki.RegistrySettings:
    try:
        return pki.registry_settings(env_values())
    except pki.ConfigError as error:
        fail(f"레지스트리 설정이 틀렸다: {error}")


def bundle_path() -> Path:
    return pki.resolve_path(DEPLOY, env_values()["OPENIT_TRUST_BUNDLE_PATH"])


def extra_trust_dir() -> Path:
    return pki.resolve_path(DEPLOY, env_values()["OPENIT_TRUST_EXTRA_DIR"])


def service_image(name: str) -> str:
    config = compose(["config", "--format", "json"], capture_output=True)
    if config.returncode != 0:
        fail(f"compose config 실패: {config.stderr.strip()[-300:]}")
    return json.loads(config.stdout)["services"][name]["image"]


def prometheus_image() -> str:
    return service_image("prometheus")


def private_dir(path: Path) -> None:
    path.mkdir(parents=True, exist_ok=True)
    path.chmod(0o700)


def step_cli(args: list[str], *, rw: dict[Path, str] | None = None, ro: dict[Path, str] | None = None) -> subprocess.CompletedProcess[str]:
    """step CLI 를 일회용 컨테이너에서 돌린다(네트워크 없음, 읽기 전용 루트, 호출자 uid). 인증서 만들기는 CA 도구가 맡는다."""
    command = ["run", "--rm", "--network", "none", "--read-only", "--tmpfs", "/tmp", "--cap-drop", "ALL",
               "--user", f"{os.getuid()}:{os.getgid()}", "-e", "HOME=/tmp", "-e", "STEPPATH=/tmp/.step", "--entrypoint", "step"]
    for host, inside in (rw or {}).items():
        command += ["-v", f"{host}:{inside}"]
    for host, inside in (ro or {}).items():
        command += ["-v", f"{host}:{inside}:ro"]
    return docker([*command, service_image(STEP_IMAGE_SERVICE), *args], capture_output=True)


def step_or_fail(what: str, result: subprocess.CompletedProcess[str]) -> None:
    if result.returncode != 0:
        fail(f"{what} 실패(rc={result.returncode}): {(result.stderr or result.stdout).strip()[-400:]}")


def read_password(name: str) -> bytes:
    return (SECRETS_DIR / name).read_text(encoding="utf-8").strip().encode()


def bounded_minutes(configured: int, root_cert: object) -> int:
    """중간 CA 수명(분). 설정 값이되 루트의 남은 수명을 넘지 않는다(RFC 5280 6.1.3: 하위는 상위보다 오래 살 수 없다)."""
    left = int(pki.remaining(root_cert).total_seconds() // 60) - 60  # type: ignore[arg-type]
    if left < 2 * ca_cfg().leaf_minutes:
        fail("루트 CA 의 남은 수명이 리프 수명의 두 배보다 짧아 중간 CA 를 만들 수 없다. 루트 교체가 먼저다(docs/CA.md 의 '루트 교체')")
    return min(configured, left)


def create_root(cfg: pki.CaSettings) -> None:
    result = step_cli(
        ["certificate", "create", f"{cfg.name} Root CA", "/pki/root_ca.crt", "/pki/root_ca.key", "--profile", "root-ca",
         "--not-after", pki.fmt_minutes(cfg.root_minutes), "--password-file", "/run/pw/root"],
        rw={PKI_DIR: "/pki"}, ro={SECRETS_DIR / "step_ca_root_password": "/run/pw/root"},
    )
    step_or_fail("루트 CA 생성", result)
    (PKI_DIR / "root_ca.key").chmod(0o600)


def create_intermediate(cfg: pki.CaSettings) -> None:
    """self 방식: 루트가 서명한 새 중간 CA 를 pending/ 에 만든다."""
    root = pki.load_cert(PKI_DIR / "root_ca.crt")
    private_dir(PENDING_DIR)
    for leftover in ("intermediate_ca.crt", "intermediate_ca.key"):
        (PENDING_DIR / leftover).unlink(missing_ok=True)
    result = step_cli(
        ["certificate", "create", f"{cfg.name} Intermediate CA", "/out/intermediate_ca.crt", "/out/intermediate_ca.key",
         "--profile", "intermediate-ca", "--ca", "/pki/root_ca.crt", "--ca-key", "/pki/root_ca.key", "--ca-password-file", "/run/pw/root",
         "--password-file", "/run/pw/ca", "--not-after", pki.fmt_minutes(bounded_minutes(cfg.intermediate_minutes, root))],
        rw={PENDING_DIR: "/out"},
        ro={PKI_DIR / "root_ca.crt": "/pki/root_ca.crt", PKI_DIR / "root_ca.key": "/pki/root_ca.key",
            SECRETS_DIR / "step_ca_root_password": "/run/pw/root", SECRETS_DIR / "step_ca_password": "/run/pw/ca"},
    )
    step_or_fail("중간 CA 생성", result)


def create_csr(cfg: pki.CaSettings) -> Path:
    """institution 방식: 중간 CA 키와 서명 요청(CSR)을 pending/ 에 만든다. 기관 CA 가 서명한다."""
    private_dir(PENDING_DIR)
    for leftover in ("intermediate.csr", "intermediate_ca.key", "intermediate_ca.crt"):
        (PENDING_DIR / leftover).unlink(missing_ok=True)
    result = step_cli(
        ["certificate", "create", f"{cfg.name} Intermediate CA", "/out/intermediate.csr", "/out/intermediate_ca.key", "--csr",
         "--password-file", "/run/pw/ca"],
        rw={PENDING_DIR: "/out"}, ro={SECRETS_DIR / "step_ca_password": "/run/pw/ca"},
    )
    step_or_fail("CSR 생성", result)
    return PENDING_DIR / "intermediate.csr"


def archive_current_ca() -> Path | None:
    files = [p for p in (CA_DIR / "intermediate_ca.crt", CA_DIR / "intermediate_ca.key", CA_DIR / "root_ca.crt") if p.is_file()]
    if not files:
        return None
    target = ARCHIVE_DIR / time.strftime("%Y%m%dT%H%M%S")
    private_dir(ARCHIVE_DIR)
    private_dir(target)
    for path in files:
        shutil.copy2(path, target / path.name)
    return target


def install_intermediate(cert_file: Path, key_file: Path, root_file: Path) -> None:
    """검증한 뒤 ca/ 에 설치한다. 검증: 사슬(각 인증서가 위의 것이 서명했고 CA 로 쓸 수 있다), 개인 키 일치, 유효 기간."""
    chain = pki.load_certs(cert_file)
    root = pki.load_cert(root_file)
    problems: list[str] = []
    for index, cert in enumerate(chain):
        issuer = chain[index + 1] if index + 1 < len(chain) else root
        problems += [f"{pki.subject_text(cert)}: {item}" for item in pki.check_intermediate(cert, issuer)]
    try:
        if not pki.key_matches_cert(key_file, read_password("step_ca_password"), chain[0]):
            problems.append("개인 키가 첫 인증서와 짝이 아니다")
    except (ValueError, TypeError) as error:
        problems.append(f"개인 키를 열지 못했다(암호가 다르거나 키가 아니다): {error}")
    if problems:
        fail("설치할 수 없다:\n  " + "\n  ".join(problems))
    archived = archive_current_ca()
    private_dir(CA_DIR)
    # 왜 파일을 덮어 쓴다(rename 아님): 컨테이너 마운트는 파일 단위라 새 inode 가 되면 보이지 않는다. 어차피 step-ca 는 다시 만든다
    (CA_DIR / "intermediate_ca.crt").write_text(pki.pem_text(chain), encoding="ascii")
    shutil.copyfile(key_file, CA_DIR / "intermediate_ca.key")
    (CA_DIR / "root_ca.crt").write_text(pki.pem_text([root]), encoding="ascii")
    # 왜 0644: 키는 암호로 잠겨 있고, 컨테이너 사용자가 읽으려면 읽기 가능해야 한다. 호스트 쪽 접근은 0700 폴더가 막는다(ADR 0008)
    for name in ("intermediate_ca.crt", "intermediate_ca.key", "root_ca.crt"):
        (CA_DIR / name).chmod(0o644)
    for leftover in PENDING_DIR.glob("*") if PENDING_DIR.is_dir() else []:
        leftover.unlink()
    typer.echo(f"설치함: 중간 CA {pki.subject_text(chain[0])}" + (f" (이전 파일 보관: {archived.relative_to(ROOT)})" if archived else ""))


def write_if_changed(path: Path, text: str, mode: int = 0o644) -> bool:
    if path.is_file() and path.read_text(encoding="utf-8") == text:
        return False
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding="utf-8")
    path.chmod(mode)
    return True


def write_bundle() -> bool:
    text = pki.build_bundle([CA_DIR / "root_ca.crt"], extra_trust_dir())
    return write_if_changed(bundle_path(), text)


def write_tls_targets(reg: pki.RegistrySettings) -> bool:
    # 왜 renewal 라벨: ACME 로 받는 리프는 만료 24시간 전 경보를 건다. step-ca 자신의 서버 인증서는 step-ca 가 24시간 수명으로 스스로 갱신해
    # 남은 시간이 늘 24시간 아래라 같은 규칙을 걸면 항상 경보다(시험에서 확인). 그것은 접속·검증 성공(probe_success)만 본다
    text = "- targets: ['step-ca:9000']\n  labels: {renewal: ca-self}\n"
    if reg.mode == "local":
        text += "- targets: ['registry:443']\n  labels: {renewal: acme}\n"
    return write_if_changed(DEPLOY / "generated" / "tls-targets.yml", text)


def ensure_pki(cfg: pki.CaSettings, reg: pki.RegistrySettings) -> bool:
    """신뢰의 뿌리를 갖춘다. 이미 있는 것은 건드리지 않는다(멱등). step-ca 가 읽는 파일이 바뀌었으면 True."""
    secrets_init()
    private_dir(PKI_DIR)
    private_dir(CA_DIR)
    extra_trust_dir().mkdir(parents=True, exist_ok=True)
    changed = False
    if cfg.mode == "self":
        if (PKI_DIR / "root_ca.crt").is_file() != (PKI_DIR / "root_ca.key").is_file():
            fail("deploy/pki/ 에 루트 인증서와 키 중 하나만 있다. 직접 확인하고 보관본에서 복구한다(자동으로 덮어쓰지 않는다)")
        if not (PKI_DIR / "root_ca.crt").is_file():
            create_root(cfg)
            typer.echo("만듦: 루트 CA(개인 키는 deploy/pki/root_ca.key, 이 관리 노드에만 둔다)")
        if not (CA_DIR / "intermediate_ca.crt").is_file():
            create_intermediate(cfg)
            install_intermediate(PENDING_DIR / "intermediate_ca.crt", PENDING_DIR / "intermediate_ca.key", PKI_DIR / "root_ca.crt")
            changed = True
        else:
            typer.echo("있음: 중간 CA")
    elif not (CA_DIR / "intermediate_ca.crt").is_file():
        csr = PENDING_DIR / "intermediate.csr"
        if not csr.is_file():
            create_csr(cfg)
        fail(
            f"기관 CA 가 서명한 중간 CA 가 아직 없다. 서명 요청: {csr.relative_to(ROOT)}\n"
            "  기관 CA 에 이 요청을 서명받은 뒤(CA 인증서, pathlen 0 이상, 기간은 리프 수명 이상):\n"
            "  ./deploy ca install --cert <서명된 인증서(사슬 포함 가능)> --root <기관 루트 인증서>  그리고 ./deploy bootstrap 을 다시 실행한다"
        )
    changed |= write_if_changed(CA_DIR / "ca.json", pki.render_ca_json_text(cfg))
    changed |= write_bundle()
    write_tls_targets(reg)
    return changed


# ---------------------------------------------------------------- 레지스트리(ADR 0013)


def published_endpoint(service: str, port: int) -> tuple[str, int] | None:
    result = compose(["port", service, str(port)], capture_output=True)
    text = result.stdout.strip()
    if result.returncode != 0 or ":" not in text:
        return None
    host, _, number = text.rpartition(":")
    return ("127.0.0.1" if host in ("", "0.0.0.0", "::", "[::]") else host.strip("[]")), int(number)


def engine_host() -> str:
    """docker 엔진이 있는 호스트. 원격 엔진(docker context, SSH)이면 게시된 포트는 그 호스트에 있다."""
    env = dockerenv.docker_env()
    endpoint = env.get("DOCKER_HOST", "")
    if endpoint.startswith(("ssh://", "tcp://")):
        return endpoint.split("://", 1)[1].rpartition("@")[2].split(":")[0]
    return "127.0.0.1"


class Registry:
    """이미지를 올리고 내려받을 레지스트리. local 은 compose 안쪽 이름(registry:443), external 은 설정의 주소."""

    def __init__(self, prefix: str, local: bool) -> None:
        self.prefix = prefix  # 이미지 이름 앞부분
        self.local = local


def registry_target(reg: pki.RegistrySettings) -> Registry:
    if reg.mode == "external":
        return Registry(reg.address, False)
    return Registry(f"{reg.names[0]}:443", True)


def crane(args: list[str], stage: Path | None = None) -> subprocess.CompletedProcess[str]:
    """레지스트리 클라이언트(crane, 일회용 컨테이너)를 compose 안쪽 네트워크에서 돌린다. 인증서는 신뢰 목록으로 검증한다.

    왜 데몬의 push 가 아닌가: 데몬이 게시된 포트에 닿는지는 설치 환경에 달렸다(Docker Desktop 에서는 닿지 않는 것을 확인했다). 안쪽 네트워크의 이름으로 접속하면
    어느 환경에서나 같고, 데몬에 루트 인증서를 설치(certs.d)하지 않아도 TLS 를 완전히 검증한다(ADR 0013).
    """
    command = [*compose_args(), "--profile", "tools", "run", "--rm", "--no-deps", "-T", "--user", f"{os.getuid()}:{os.getgid()}"]
    if stage is not None:
        command += ["-v", f"{stage}:/w"]
    return docker([*command, "registry-client", *args], capture_output=True)


def registry_has(target: Registry, repo: str, digest: str) -> bool:
    """레지스트리에 그 digest 의 매니페스트가 있는가. 확인하지 못하면 False(올리기는 멱등이다)."""
    reference = f"{target.prefix}/{repo}@{digest}"
    if target.local:
        return crane(["manifest", reference]).returncode == 0
    return docker(["buildx", "imagetools", "inspect", reference], capture_output=True).returncode == 0


def verify_registry_tls(reg: pki.RegistrySettings) -> None:
    """레지스트리의 인증서를 신뢰 목록으로 검증하고(예외 없이) 유효 기간을 보인다."""
    endpoint = published_endpoint("registry", 443)
    if endpoint is None:
        fail("레지스트리가 떠 있지 않다(./deploy bootstrap)")
    try:
        leaf = pki.fetch_leaf(engine_host(), endpoint[1], reg.names[0], bundle_path())
    except (OSError, ssl.SSLError) as error:
        fail(f"레지스트리 TLS 검증 실패(신뢰 목록으로 이름 '{reg.names[0]}' 을 검증): {error}")
    typer.echo(f"레지스트리 TLS 검증 통과: {reg.names[0]} 남은 {pki.remaining(leaf).total_seconds() / 3600:.1f}시간")


def local_image(name: str) -> str:
    return f"openit/{name.lstrip('_')}"


def push_images(reg: pki.RegistrySettings) -> None:
    targets = area_targets()
    if not targets:
        typer.echo("올릴 이미지 없음(services/·web/ 에 Dockerfile 이 있는 영역이 없다)")
        return
    target = registry_target(reg)
    lock = read_lock()
    for name in targets:
        repo = local_image(name)
        if name in lock and registry_has(target, repo, lock[name]):
            typer.echo(f"레지스트리에 있음: {name} {lock[name]}")
            continue
        if docker(["image", "inspect", f"{repo}:local"], capture_output=True).returncode != 0:
            build(name, False)  # 왜 여기서 빌드: 로컬에 이미지가 없으면 올릴 것이 없다. 빌드는 lock 도 갱신한다
        remote = f"{target.prefix}/{repo}:local"
        if target.local:
            stage = META_DIR / "push"
            stage.mkdir(parents=True, exist_ok=True)
            archive = stage / f"{name}.tar"
            if (saved := docker(["save", f"{repo}:local", "-o", str(archive)], capture_output=True)).returncode != 0:
                fail(f"{name} 저장 실패: {saved.stderr.strip()[-300:]}")
            pushed = crane(["push", f"/w/{archive.name}", remote], stage)
            archive.unlink(missing_ok=True)
        else:
            if (tag := docker(["tag", f"{repo}:local", remote], capture_output=True)).returncode != 0:
                fail(f"{name} 태그 실패: {tag.stderr.strip()[-300:]}")
            pushed = docker(["push", remote], capture_output=True)
        if pushed.returncode != 0:
            fail(f"{name} push 실패(rc={pushed.returncode}): {(pushed.stderr or pushed.stdout).strip()[-400:]}")
        found = re.search(r"(sha256:[0-9a-f]{64})", pushed.stdout if target.local else pushed.stdout + pushed.stderr)
        if not found:
            fail(f"{name}: push 결과에서 digest 를 찾지 못했다")
        lock = read_lock()
        lock[name] = found.group(1)  # 왜 push 가 준 digest: 내려받을 때 쓰는 값은 레지스트리의 매니페스트 digest 다
        write_lock(lock)
        typer.echo(f"올림: {name} {found.group(1)}")


@app.command()
def pull(service: Annotated[str | None, typer.Argument(help="내려받을 대상(없으면 lock 의 전부)")] = None) -> None:
    """images.lock 의 digest 로 레지스트리에서 이미지를 내려받는다(태그가 아니라 digest 로). local 은 안쪽 네트워크에서 받아 docker load 한다."""
    reg = reg_cfg()
    target = registry_target(reg)
    lock = read_lock()
    names = [service] if service else list(lock)
    if not names:
        no_target("images.lock 이 비어 있다")
    stage = META_DIR / "pull"
    stage.mkdir(parents=True, exist_ok=True)
    for name in names:
        if name not in lock:
            fail(f"images.lock 에 '{name}' 이 없다", 2)
        reference = f"{target.prefix}/{local_image(name)}@{lock[name]}"
        if target.local:
            archive = stage / f"{name}.tar"
            result = crane(["pull", reference, f"/w/{archive.name}"], stage)
            if result.returncode == 0:
                result = docker(["load", "--input", str(archive)], capture_output=True)
            archive.unlink(missing_ok=True)
        else:
            result = docker(["pull", "--quiet", reference], capture_output=True)
        if result.returncode != 0:
            fail(f"{name} pull 실패(rc={result.returncode}): {(result.stderr or result.stdout).strip()[-400:]}")
        typer.echo(f"받음: {reference}")


@app.command()
def bootstrap() -> None:
    """관리 노드에서 처음부터 설치한다: 신뢰의 뿌리 -> 레지스트리 -> 이미지 push·digest 기록 -> 서비스 기동. 이미 된 단계는 건너뛴다(멱등)."""
    cfg, reg = ca_cfg(), reg_cfg()
    typer.echo("[1/4] 신뢰의 뿌리")
    changed = ensure_pki(cfg, reg)
    typer.echo(f"      CA 방식 {cfg.mode}, 신뢰 목록 {bundle_path()}")
    typer.echo("[2/4] 레지스트리")
    if reg.mode == "external":
        typer.echo(f"      외부 레지스트리 {reg.address} 를 쓴다(레지스트리 단계를 건너뛴다)")
    else:
        running = compose(["ps", "--quiet", "step-ca"], capture_output=True).stdout.strip()
        if changed and running:
            # 왜 다시 만든다: step-ca 가 읽는 파일이 바뀌었다(중간 CA 교체, 설정 변경). 컨테이너는 시작할 때 읽는다
            if compose(["up", "-d", "--wait", "--force-recreate", "--no-deps", "step-ca"]).returncode != 0:
                fail("step-ca 를 다시 만들지 못했다. ./deploy status 와 로그를 본다")
        if compose(["up", "-d", "--wait", "step-ca", "registry-store", "registry"]).returncode != 0:
            fail("레지스트리를 띄우지 못했다. 진단을 위해 컨테이너와 로그를 남겨 두었다: ./deploy status")
        verify_registry_tls(reg)
    typer.echo("[3/4] 이미지 올리기와 digest 기록")
    push_images(reg)
    typer.echo("[4/4] 서비스 기동")
    up()
    typer.echo("인증서 상태")
    ca_status()
    typer.echo("bootstrap 완료")


