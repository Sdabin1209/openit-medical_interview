@ca_app.command("status")
def ca_status() -> None:
    """루트·중간·리프 인증서의 만료까지 남은 기간을 보인다. 기준 미만이거나 검증이 실패하면 rc=1."""
    cfg, reg = ca_cfg(), reg_cfg()
    if not (CA_DIR / "intermediate_ca.crt").is_file():
        no_target("deploy/pki/ca/ 가 없다(./deploy bootstrap)")
    problems = 0

    def line(label: str, cert: object, warn_minutes: int, extra: str = "") -> None:
        nonlocal problems
        left = pki.remaining(cert)  # type: ignore[arg-type]
        hours = left.total_seconds() / 3600
        ok = hours * 60 >= warn_minutes
        problems += not ok
        shown = f"{left.days}일" if hours >= 48 else f"{hours:.1f}시간"
        typer.echo(f"[{'OK' if ok else 'FAIL'}] {label}: 남은 {shown} (기준 {pki.fmt_minutes(warn_minutes)}) {extra}".rstrip())

    root = pki.load_cert(CA_DIR / "root_ca.crt")
    chain = pki.load_certs(CA_DIR / "intermediate_ca.crt")
    line(f"루트 CA {pki.subject_text(root)}", root, cfg.warn_root_minutes)
    line(f"중간 CA {pki.subject_text(chain[0])}", chain[0], cfg.warn_intermediate_minutes)
    issues = pki.check_intermediate(chain[0], chain[1] if len(chain) > 1 else root)
    try:
        if not pki.key_matches_cert(CA_DIR / "intermediate_ca.key", read_password("step_ca_password"), chain[0]):
            issues.append("중간 CA 개인 키가 인증서와 짝이 아니다")
    except (ValueError, TypeError, OSError) as error:
        issues.append(f"중간 CA 개인 키를 열지 못했다: {error}")
    if (CA_DIR / "ca.json").read_text(encoding="utf-8") != pki.render_ca_json_text(cfg):
        issues.append("ca.json 이 설정과 다르다(./deploy bootstrap 으로 맞춘다)")
    bundle = bundle_path()
    if not bundle.is_file() or pki.build_bundle([CA_DIR / "root_ca.crt"], extra_trust_dir()) != bundle.read_text(encoding="utf-8"):
        issues.append("신뢰 목록이 현재 루트와 다르다(./deploy ca bundle)")
    for issue in issues:
        typer.echo(f"[FAIL] {issue}")
    problems += len(issues)
    if not issues:
        typer.echo("[OK] 사슬: 루트 -> 중간 CA 서명·CA 확장·키 짝·ca.json·신뢰 목록이 맞다")
    for extra in sorted(p for p in extra_trust_dir().glob("*") if p.suffix in {".crt", ".pem"}) if extra_trust_dir().is_dir() else []:
        for cert in pki.load_certs(extra):
            line(f"추가 신뢰 루트 {extra.name} {pki.subject_text(cert)}", cert, cfg.warn_root_minutes)
    kiosk = env_values()["OPENIT_DEVICE_CA_CERTIFICATE_FILE"]
    if kiosk:
        kiosk_path = pki.resolve_path(DEPLOY, kiosk)
        if not kiosk_path.is_file():
            typer.echo(f"[FAIL] OPENIT_DEVICE_CA_CERTIFICATE_FILE 파일이 없다: {kiosk_path}")
            problems += 1
        else:
            for cert in pki.load_certs(kiosk_path):
                line(f"키오스크 클라이언트 CA {pki.subject_text(cert)}", cert, cfg.warn_root_minutes)
    ingress = platform_generated().settings
    ingress_endpoint = published_endpoint("ingress-acme", ingress.listen_port)
    if ingress_endpoint is None:
        typer.echo("[FAIL] 입구 인증서: 입구가 떠 있지 않아 읽지 못했다")
        problems += 1
    else:
        try:
            ingress_leaf = pki.fetch_leaf(engine_host(), ingress_endpoint[1], ingress.public_host, bundle)
        except (OSError, ssl.SSLError) as error:
            typer.echo(f"[FAIL] 입구 인증서: 신뢰 목록으로 검증하지 못했다: {error}")
            problems += 1
        else:
            warn = ORGANIZATION_CERT_WARN_MINUTES if ingress.ingress_mode == "organization" else cfg.warn_leaf_minutes
            line(f"입구 인증서 {ingress.public_host}({ingress.ingress_mode})", ingress_leaf, warn,
                 f"serial={format(ingress_leaf.serial_number, 'x')[:12]} 발급={ingress_leaf.not_valid_before_utc:%Y-%m-%dT%H:%M:%SZ}")
    if reg.mode == "local":
        endpoint = published_endpoint("registry", 443)
        if endpoint is None:
            typer.echo("[FAIL] 레지스트리 리프: 레지스트리가 떠 있지 않아 읽지 못했다")
            problems += 1
        else:
            try:
                leaf = pki.fetch_leaf(engine_host(), endpoint[1], reg.names[0], bundle)
            except (OSError, ssl.SSLError) as error:
                typer.echo(f"[FAIL] 레지스트리 리프: 신뢰 목록으로 검증하지 못했다: {error}")
                problems += 1
            else:
                line(f"리프 {reg.names[0]}", leaf, cfg.warn_leaf_minutes,
                     f"serial={format(leaf.serial_number, 'x')[:12]} 발급={leaf.not_valid_before_utc:%Y-%m-%dT%H:%M:%SZ}")
    else:
        typer.echo(f"[--] 리프: 외부 레지스트리 {reg.address} 의 인증서는 그 운영처가 관리한다")
    if problems:
        fail(f"인증서 점검 실패 {problems}건", EXIT_FAIL)
    typer.echo("인증서 점검 통과")


