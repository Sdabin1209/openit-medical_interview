def fail(message: str, code: int = EXIT_FAIL) -> NoReturn:
    typer.echo(message, err=True)
    raise typer.Exit(code)


def no_target(message: str) -> NoReturn:
    fail(f"대상 없음: {message}", EXIT_NO_TARGET)


CURRENT_SERVER: dlayout.Server | None = None  # 이 서버의 엔진으로 docker 를 부른다. None 이면 관리 노드의 기본 엔진(빌드 엔진)이다


def server_environ(server: dlayout.Server | None) -> dict[str, str] | None:
    """여러 서버일 때 서버의 docker context 로 엔진을 고른다(ADR 0009 규칙 1: DOCKER_CONTEXT 가 DOCKER_HOST 보다 앞선다). 서버 이름이 context 이름이다."""
    if server is None or not get_layout().multi:
        return None
    return {**os.environ, "DOCKER_CONTEXT": server.name}


@contextlib.contextmanager
def on_server(server: dlayout.Server | None):  # type: ignore[no-untyped-def]
    global CURRENT_SERVER  # noqa: PLW0603
    previous, CURRENT_SERVER = CURRENT_SERVER, server
    try:
        yield
    finally:
        CURRENT_SERVER = previous


def docker(args: list[str], **kwargs: object) -> subprocess.CompletedProcess[str]:
    environ = server_environ(CURRENT_SERVER)
    if environ is not None:
        kwargs["environ"] = environ
    try:
        return dockerenv.run_docker(args, **kwargs)
    except dockerenv.DockerEnvError as error:
        fail(f"docker 환경을 정하지 못했다: {error}")


def docker_bytes(args: list[str], data: bytes) -> subprocess.CompletedProcess[bytes]:
    """표준 입력으로 바이트를 넘겨 docker 를 부른다(원격 엔진의 볼륨에 tar 를 올린다). 엔진 선택은 docker() 와 같다."""
    try:
        env = dockerenv.docker_env(server_environ(CURRENT_SERVER))
    except dockerenv.DockerEnvError as error:
        fail(f"docker 환경을 정하지 못했다: {error}")
    return subprocess.run(["docker", *args], env=env, input=data, capture_output=True, check=False)  # noqa: S603, S607


