# ---------------------------------------------------------------- 백업과 복구(ADR 0027)

BACKUP_ENV = GENERATED / "backup.env"
BACKUP_HTPASSWD = GENERATED / "backup" / "htpasswd"
RESTIC_SECRETS = ("password_file", "http_credentials_file", "encryption_key_file", "offsite_credentials_file")
EXIT_TEMPFAIL = 75  # 계약 JobExitCode: 일시적 실패(다음 실행에서 다시 한다, sysexits.h EX_TEMPFAIL)
RESTIC_EXIT_LOCKED = 11  # restic 종료 코드: 저장소 잠금을 얻지 못함(다른 실행이 쓰는 중)
RESTIC_EXIT_NO_REPOSITORY = 10  # restic 종료 코드: 저장소가 없다


class JobFailure(Exception):
    """잡이 실패했다. code 는 계약 JobExitCode(1 실패, 75 일시적 실패)."""

    def __init__(self, message: str, code: int = EXIT_FAIL) -> None:
        super().__init__(message)
        self.code = code


class JobRun:
    def __init__(self) -> None:
        self.started = utc_now()
        self.processed: int | None = None
        self.snapshot: str | None = None


def utc_now() -> str:
    return datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ")


@contextlib.contextmanager
def job_run(job: str):  # type: ignore[no-untyped-def]
    """잡 한 번: 끝날 때 표준 출력에 JobRunResult 한 줄(JSON Lines)을 낸다. 실패하면 메시지는 표준 오류, 종료 코드는 0·75·1(D130)."""
    run = JobRun()
    code = 0
    try:
        yield run
    except JobFailure as failure:
        typer.echo(str(failure), err=True)
        code = failure.code
    except typer.Exit as exit_:
        code = exit_.exit_code or 0
    except dbackup.BackupConfigError as error:
        typer.echo(f"CRIT: {error}", err=True)  # 왜 CRIT: 설정이 틀려 백업을 시작하지 못한 것은 경고가 아니다(D88 U6)
        code = EXIT_FAIL
    typer.echo(dbackup.job_result_line(job, code, run.started, utc_now(), run.processed, run.snapshot))
    if code:
        raise typer.Exit(code)


def secret_file_problems(cfg: dlayout.Backup) -> list[str]:
    problems: list[str] = []
    for name in RESTIC_SECRETS:
        path = Path(getattr(cfg, name))
        if not path.is_file():
            problems.append(f"backup.{name} 파일이 없다: {path}")
        elif path.stat().st_mode & 0o077:
            problems.append(f"backup.{name} 파일이 다른 사용자에게 읽힌다(권한 0600 으로): {path}")
        elif not path.read_text(encoding="utf-8").strip():
            problems.append(f"backup.{name} 파일이 비어 있다: {path}")
    return problems


def backup_settings(cfg: dlayout.Backup) -> tuple[dbackup.Repository, tuple[str, str], tuple[str, str]]:
    """배치 설정의 backup 칸을 읽는다: 저장소, 저장소 자격, 서버 밖 자격. 틀리면 BackupConfigError(문제를 모두 담는다)."""
    problems = secret_file_problems(cfg)
    repository = None
    local_credentials = remote_credentials = ("", "")
    try:
        repository = dbackup.parse_repository(cfg.repository_url)
        dbackup.offsite_repository(cfg.offsite_url)
        if not problems:
            local_credentials = dbackup.parse_credentials(Path(cfg.http_credentials_file).read_text(encoding="utf-8"), repository)
            remote_credentials = dbackup.parse_user_password(Path(cfg.offsite_credentials_file).read_text(encoding="utf-8"))
    except dbackup.BackupConfigError as error:
        problems.append(str(error))
    if repository is not None and not dbackup.allowed_name(repository.host, [n.strip() for n in env_values()["OPENIT_CA_ALLOWED_DNS"].split(",") if n.strip()]):
        problems.append(f"저장소 이름 {repository.host} 이 OPENIT_CA_ALLOWED_DNS 에 없다(사설 CA 가 이 이름의 인증서를 발급하지 않는다)")
    if problems or repository is None:
        raise dbackup.BackupConfigError("; ".join(problems))
    return repository, local_credentials, remote_credentials


def sync_backup_files() -> bool:
    """compose 가 읽는 백업 값(generated/backup.env)과 저장소의 인증 파일(htpasswd)을 쓴다. 백업 저장소를 띄울 수 있으면 True.

    배치 설정이 없거나 backup 칸이 틀리면 저장소를 띄우지 않는다(False). 틀린 설정을 알리는 것은 doctor 와 up 이다(compose 를 부르는 모든 명령이 여기를 지나므로 여기서 멈추지 않는다).
    """
    cfg = get_layout().backup
    host, port, ready = "backup", 8000, False
    if cfg is not None:
        try:
            repository, (user, password), _ = backup_settings(cfg)
        except (dbackup.BackupConfigError, OSError):
            pass
        else:
            host, port, ready = repository.host, repository.port, True
            existing = BACKUP_HTPASSWD.read_text(encoding="utf-8") if BACKUP_HTPASSWD.is_file() else None
            write_if_changed(BACKUP_HTPASSWD, dbackup.htpasswd_line(user, password, existing))
    if write_if_changed(BACKUP_ENV, f"# ./deploy 가 만든다. 백업 저장소의 이름과 포트(배치 설정의 backup.repository_url)다. 손으로 고치지 않는다.\nOPENIT_BACKUP_HOST={host}\nOPENIT_BACKUP_PORT={port}\n"):
        PENDING_CHANGES.add("backup.env")
    return ready


def require_backup_config() -> None:
    """배치 설정 파일이 있으면 그 backup 칸이 맞아야 서비스를 띄운다(백업 없이 운영이 시작되는 것을 막는다, D88 U6)."""
    cfg = get_layout().backup
    if cfg is None:
        return
    try:
        backup_settings(cfg)
    except dbackup.BackupConfigError as error:
        fail(f"배치 설정의 backup 이 틀렸다: {error}")


def ensure_backup_secrets(cfg: dlayout.Backup) -> None:
    """배치 설정이 가리키는 백업 비밀 파일 중 없는 것을 만든다(이미 있는 것은 건드리지 않는다. 값은 출력하지 않는다). 서버 밖 자격은 서버 밖 대상이 주는 것이라 만들지 않는다.

    저장소 암호를 잃으면 백업을 읽을 수 없다. 관리 노드의 비밀 파일을 따로 보관한다(INSTALL.md 10절).
    """
    try:
        repository = dbackup.parse_repository(cfg.repository_url)
    except dbackup.BackupConfigError:
        return  # 틀린 주소는 doctor 가 알린다
    wanted = {
        "password_file": pysecrets.token_hex(32),  # 왜 무작위 16진수: 비밀 파일과 같은 방식(PyPA secrets 모듈, CSPRNG)
        "encryption_key_file": pysecrets.token_hex(32),
        "http_credentials_file": f"{repository.path}:{pysecrets.token_hex(16)}",  # 한 줄 '사용자:비밀번호'(RFC 7617). 사용자는 저장소 이름이다
    }
    for name, value in wanted.items():
        path = Path(getattr(cfg, name))
        if path.exists():
            continue
        try:
            path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
            descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        except OSError as error:
            typer.echo(f"만들지 못함: backup.{name} ({error.strerror}). 파일을 직접 둔다: {path}", err=True)
            continue
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(value)
        typer.echo(f"만듦: backup.{name}")


def engine_run(server: dlayout.Server, args: list[str], **kwargs: object) -> subprocess.CompletedProcess[bytes]:
    """서버의 compose 프로젝트로 docker compose 를 부른다(바이트 입출력). docker() 는 글자(text)라 덤프에 쓰지 못한다."""
    with on_server(server):
        argv = ["docker", *compose_args(server), *args]
    try:
        environ = dockerenv.docker_env(server_environ(server))
    except dockerenv.DockerEnvError as error:
        raise JobFailure(f"docker 환경을 정하지 못했다: {error}") from error
    return subprocess.run(argv, env=environ, check=False, **kwargs)  # type: ignore[call-overload, no-any-return]  # noqa: S603


def tail(data: bytes | None) -> str:
    return (data or b"").decode(errors="replace").strip()[-300:]


def is_service_running(server: dlayout.Server, service: str) -> bool:
    return bool(compose(["ps", "--quiet", "--status", "running", service], server, capture_output=True).stdout.strip())


def backup_targets() -> list[tuple[dlayout.Server, str, str, str]]:
    """백업할 영역 데이터베이스: (서버, 소유 영역, compose 서비스, 슈퍼유저). 서버마다 그 서버의 compose 에서 라벨 io.openit.backup=postgres 인 서비스를 찾는다(D126)."""
    found: list[tuple[dlayout.Server, str, str, str]] = []
    for server in get_layout().order():
        for owner, service, user in dbackup.targets_in(compose_model(server), {}):
            if owner in server.services:
                found.append((server, owner, service, user))
    return found


def backup_volumes() -> list[tuple[dlayout.Server, str, str, str, tuple[str, ...]]]:
    """백업할 영역 상태 파일: (서버, 소유 영역, compose 볼륨 키, 엔진의 볼륨 이름, 경로들). 서버마다 그 서버의 compose 에서 라벨 io.openit.backup=files 인 서비스를 찾는다(D126)."""
    found: list[tuple[dlayout.Server, str, str, str, tuple[str, ...]]] = []
    for server in get_layout().order():
        for owner, _service, key, name, paths in dbackup.files_in(compose_model(server)):
            if owner in server.services:
                found.append((server, owner, key, name, paths))
    return found


def pg_query(server: dlayout.Server, service: str, user: str, sql: str, database: str = "template1") -> str:
    result = engine_run(server, ["exec", "-T", service, "psql", "--username", user, "--dbname", database, "--no-psqlrc", "--quiet", "--tuples-only", "--no-align",
                                 "--set", "ON_ERROR_STOP=1", "--command", sql], capture_output=True)
    if result.returncode != 0:
        raise JobFailure(f"{service} 에서 질의 실패(rc={result.returncode}): {tail(result.stderr)}")
    return result.stdout.decode().strip()


def dump_target(server: dlayout.Server, owner: str, service: str, user: str, stage: Path) -> dbackup.Target:
    """한 영역 DB 의 역할(globals.sql)과 데이터베이스마다 pg_dump(custom 형식)를 stage/<영역>/ 에 쓴다. 목차의 테이블 수도 센다(복구 시험의 기준)."""
    if not is_service_running(server, service):
        raise JobFailure(f"{owner} 의 {service} 가 서버 {server.name} 에서 떠 있지 않다(./deploy status)", EXIT_TEMPFAIL)
    folder = stage / owner
    folder.mkdir(mode=0o700)
    names = pg_query(server, service, user, "select datname from pg_database where not datistemplate order by 1").split()
    for name in names:
        if not dbackup.DB_NAME.fullmatch(name):
            raise JobFailure(f"데이터베이스 이름이 [A-Za-z0-9_] 가 아니라 백업할 수 없다: {name!r}")
    with (folder / "globals.sql").open("wb") as out:
        roles = engine_run(server, ["exec", "-T", service, "pg_dumpall", "--username", user, "--globals-only"], stdout=out, stderr=subprocess.PIPE)
    if roles.returncode != 0:
        raise JobFailure(f"{owner} 의 역할 백업 실패(rc={roles.returncode}): {tail(roles.stderr)}")
    databases: list[tuple[str, int]] = []
    for name in names:
        path = folder / f"{name}.dump"
        # 왜 custom 형식: pg_dump 문서의 압축·선택 복구 형식이고 pg_restore 가 읽는다(plain SQL 은 --create 와 소유자 복구를 psql 에 맡긴다)
        with path.open("wb") as out:
            dump = engine_run(server, ["exec", "-T", service, "pg_dump", "--username", user, "--dbname", name, "--format=custom"], stdout=out, stderr=subprocess.PIPE)
        if dump.returncode != 0:
            raise JobFailure(f"{owner} 의 {name} 백업 실패(rc={dump.returncode}): {tail(dump.stderr)}")
        with path.open("rb") as handle:
            toc = engine_run(server, ["exec", "-T", service, "pg_restore", "--list"], stdin=handle, capture_output=True)
        if toc.returncode != 0:
            raise JobFailure(f"{owner} 의 {name} 덤프를 읽지 못했다(rc={toc.returncode}): {tail(toc.stderr)}")
        databases.append((name, dbackup.toc_table_count(toc.stdout.decode())))
    return dbackup.Target(owner, service, user, server.name, tuple(databases))


def volume_run(server: dlayout.Server, args: list[str], **kwargs: object) -> subprocess.CompletedProcess[bytes]:
    """서버의 엔진으로 docker 를 부른다(compose 가 아니다. 상태 볼륨을 일회용 컨테이너에 마운트할 때)."""
    try:
        environ = dockerenv.docker_env(server_environ(server))
    except dockerenv.DockerEnvError as error:
        raise JobFailure(f"docker 환경을 정하지 못했다: {error}") from error
    return subprocess.run(["docker", *args], env=environ, check=False, **kwargs)  # type: ignore[call-overload, no-any-return]  # noqa: S603, S607


def volume_exists(server: dlayout.Server, volume: str) -> bool:
    return volume_run(server, ["volume", "inspect", volume], capture_output=True).returncode == 0


def volume_helper(volume: str, *, writable: bool, caps: tuple[str, ...], interactive: bool = False) -> list[str]:
    """상태 볼륨을 /data 에 마운트하는 일회용 컨테이너의 docker run 인자(entrypoint 앞까지). 네트워크 없음, 읽기 전용 루트, 필요한 권한만.

    왜 /vol: 이미지에 없는 경로라야 빈 볼륨에 이미지의 내용이 복사돼 들어가지 않는다(caddy 이미지의 /data 는 있다).
    왜 root: 파일의 소유자는 영역 사용자(uid 10001, 모드 0600)라 다른 사용자는 읽지 못한다. 권한(capability)은 모두 버리고 읽기(DAC_READ_SEARCH)나 쓰기(CHOWN·DAC_OVERRIDE·FOWNER)에 필요한 것만 더한다.
    왜 caddy 이미지(tool_image): 모든 서버가 이미 가진 digest 고정 이미지이고 busybox 의 tar·find 가 있다(파일 올리기와 같다, ADR 0026).
    """
    command = ["run", "--rm", "--network", "none", "--read-only", "--cap-drop", "ALL", "--security-opt", "no-new-privileges:true", "--user", "0:0",
               "-v", f"{volume}:/vol{'' if writable else ':ro'}"]
    for cap in caps:
        command += ["--cap-add", cap]
    if interactive:
        command.append("-i")
    return command


# 왜 부모 폴더도 넣는다: 볼륨이 통째로 사라진 뒤 복구하면 부모 폴더(예: cache)가 없다. tar 가 만들면 root 소유라 영역 사용자가 그 안에 새 폴더를 못 만든다.
# 그래서 경로의 부모 폴더 항목(소유자·모드)을 재귀 없이 함께 담는다(busybox tar --no-recursion). 정렬하면 부모가 자식보다 앞선다
TAR_PATHS_SCRIPT = (
    'cd /vol && list=$(for p in "$@"; do [ -e "$p" ] || continue; d=$p; while [ "$d" != "${d%/*}" ]; do d=${d%/*}; echo "$d"; done; find "$p"; done | sort -u)'
    ' && { [ -z "$list" ] || printf \'%s\\n\' "$list" | tar -cf - --no-recursion -T -; }'  # 왜 비면 건너뛴다: 목록이 비면 busybox tar 가 'empty archive' 로 실패한다(출력 없음 = 파일 없음)
)


def dump_volume(server: dlayout.Server, owner: str, key: str, volume: str, paths: tuple[str, ...], stage: Path) -> dbackup.VolumeTarget:
    """영역 상태 볼륨의 경로들을 tar 로 stage/<영역>/<볼륨 키>.tar 에 쓰고 안의 일반 파일(경로·크기·SHA-256)을 센다(복구 시험의 기준).

    볼륨이나 경로가 아직 없으면(서비스가 한 번도 쓰지 않았다) 있는 것만 담고 없으면 빈 tar 다. 백업이 볼륨을 만들지 않는다(compose 라벨 없는 볼륨이 생기지 않게).
    """
    folder = stage / owner
    folder.mkdir(mode=0o700, exist_ok=True)
    path = folder / f"{key}.tar"
    if volume_exists(server, volume):
        with path.open("wb") as out:
            result = volume_run(server, [*volume_helper(volume, writable=False, caps=("DAC_READ_SEARCH",)), "--entrypoint", "sh", tool_image(), "-c", TAR_PATHS_SCRIPT, "sh", *paths],
                                stdout=out, stderr=subprocess.PIPE)
        if result.returncode != 0:
            message = tail(result.stderr)
            # 왜 75: 쓰는 중인 파일이 읽는 동안 바뀌면 tar 가 그렇게 알린다. 다음 실행에서 다시 하면 된다
            raise JobFailure(f"{owner} 의 볼륨 {key} 백업 실패(rc={result.returncode}): {message}", EXIT_TEMPFAIL if "changed as we read it" in message else EXIT_FAIL)
    if not path.exists() or path.stat().st_size == 0:  # 볼륨이나 경로가 없으면 출력이 없다. 빈 tar 로 쓴다(복구는 그 경로를 비우기만 한다)
        with tarfile.open(path, "w"):
            pass
    with path.open("rb") as handle:
        return dbackup.VolumeTarget(owner, key, server.name, paths, tuple(dbackup.archive_entries(handle)))


class Restic:
    """restic 클라이언트(일회용 컨테이너, 관리 노드의 빌드 엔진)를 부른다. 저장소 주소(자격 포함)와 암호는 파일로만 준다(명령줄·환경 변수에 비밀이 없다, D84)."""

    def __init__(self, directory: Path, main: str, copy_from_local: bool, setup: tuple[dlayout.Backup, dbackup.Repository, tuple[str, str], tuple[str, str]]) -> None:
        cfg, repository, local, remote = setup
        self.mounts: list[tuple[Path, str]] = []
        self.env: dict[str, str] = {}
        local_file = directory / "local-repository"
        local_file.write_text(dbackup.with_credentials(repository.url, *local), encoding="utf-8")
        offsite_file = directory / "offsite-repository"
        offsite_file.write_text(dbackup.with_credentials(dbackup.offsite_repository(cfg.offsite_url), *remote), encoding="utf-8")
        local_pair = (local_file, Path(cfg.password_file))
        offsite_pair = (offsite_file, Path(cfg.encryption_key_file))
        main_pair, from_pair = (offsite_pair, local_pair if copy_from_local else None) if main == "offsite" else (local_pair, None)
        self.mounts += [(main_pair[0], "/run/restic/repository"), (main_pair[1], "/run/restic/password")]
        self.env |= {"RESTIC_REPOSITORY_FILE": "/run/restic/repository", "RESTIC_PASSWORD_FILE": "/run/restic/password"}
        if from_pair:
            self.mounts += [(from_pair[0], "/run/restic/from-repository"), (from_pair[1], "/run/restic/from-password")]
            self.env |= {"RESTIC_FROM_REPOSITORY_FILE": "/run/restic/from-repository", "RESTIC_FROM_PASSWORD_FILE": "/run/restic/from-password"}
        self.repository = repository

    def argv(self, args: list[str], *, stage: Path | None = None, interactive: bool = False) -> list[str]:
        layout = get_layout()
        image = yaml.safe_load(COMPOSE_FILE.read_text(encoding="utf-8"))["services"]["backup-client"]["image"]
        command = ["docker", "run", "--rm", "--read-only", "--cap-drop", "ALL", "--security-opt", "no-new-privileges:true", "--user", f"{os.getuid()}:{os.getgid()}",
                   "--tmpfs", "/tmp", "-e", "RESTIC_CACHE_DIR=/tmp/restic-cache", "-e", "SSL_CERT_FILE=/etc/openit/trust-bundle.pem",
                   "-v", f"{bundle_path()}:/etc/openit/trust-bundle.pem:ro"]
        for name, value in self.env.items():
            command += ["-e", f"{name}={value}"]
        for source, target in self.mounts:
            command += ["-v", f"{source}:{target}:ro"]
        if stage is not None:
            command += ["-v", f"{stage}:{dbackup.STAGE_DIR}:ro"]
        if layout.multi:
            # 왜 서버 주소로 풀어 넣는다: 저장소는 플랫폼 서버에 게시된 포트로 닿는다(서버 사이 포트, ADR 0026 와 같은 방식). 인증서는 같은 신뢰 목록으로 검증한다
            command += ["--add-host", f"{self.repository.host}:{dlayout.resolve_ip(layout.platform.address)}"]
        else:
            # 왜 edge 네트워크: 서버 한 대 배치에서는 호스트 포트를 게시하지 않고 compose 네트워크의 이름으로 닿는다. edge 는 바깥으로 나갈 수 있어 서버 밖 대상에도 닿는다(crane 과 같은 이유, ADR 0013)
            command += ["--network", f"{project_name()}_edge"]
        if interactive:
            command.append("-i")
        return [*command, "--entrypoint", "restic", image, *args]

    def run(self, args: list[str], *, stage: Path | None = None, **kwargs: object) -> subprocess.CompletedProcess[bytes]:
        try:
            environ = dockerenv.docker_env(None)
        except dockerenv.DockerEnvError as error:
            raise JobFailure(f"docker 환경을 정하지 못했다: {error}") from error
        return subprocess.run(self.argv(args, stage=stage, interactive="stdin" in kwargs), env=environ, check=False, **kwargs)  # type: ignore[call-overload, no-any-return]  # noqa: S603

    def ok(self, what: str, args: list[str], *, stage: Path | None = None) -> subprocess.CompletedProcess[bytes]:
        result = self.run(args, stage=stage, capture_output=True)
        if result.returncode != 0:
            raise JobFailure(f"{what} 실패(restic rc={result.returncode}): {tail(result.stderr)}", EXIT_TEMPFAIL if result.returncode == RESTIC_EXIT_LOCKED else EXIT_FAIL)
        return result

    def ensure_repository(self, *, copy_from_local: bool = False) -> None:
        """저장소가 없으면 만든다(있으면 그대로). 서버 밖 저장소는 로컬 저장소의 쪼개기 값을 따른다(restic copy 문서: 중복 제거가 되려면 같아야 한다)."""
        exists = self.run(["cat", "config"], capture_output=True)
        if exists.returncode == 0:
            return
        if exists.returncode != RESTIC_EXIT_NO_REPOSITORY:
            raise JobFailure(f"저장소를 열지 못했다(restic rc={exists.returncode}): {tail(exists.stderr)}", EXIT_TEMPFAIL)
        self.ok("저장소 만들기", ["init", "--quiet", *(["--copy-chunker-params"] if copy_from_local else [])])

    def snapshots(self) -> list[dict[str, str]]:
        """이 설치의 스냅샷(시각순)."""
        listing = json.loads(self.ok("스냅샷 목록", ["snapshots", "--json", "--host", project_name(), "--tag", BACKUP_TAG]).stdout or b"[]") or []  # 없으면 null
        return sorted(listing, key=lambda item: item["time"])  # type: ignore[no-any-return]

    def forget(self) -> None:
        # 왜 --keep-within 만: 백업이 성공한 직후에만 부르므로 방금 만든 스냅샷은 항상 남는다(보관 기간 상한, OPEN_GAPS U30·D130). 이 설치의 스냅샷만 본다(--host, --tag)
        self.ok("보관 기간 정리", ["forget", "--host", project_name(), "--tag", BACKUP_TAG, "--keep-within", dbackup.RETENTION_WITHIN, "--prune", "--quiet"])

    def dump_argv(self, snapshot: str, path: str) -> list[str]:
        return self.argv(["dump", snapshot, path])


BACKUP_TAG = "openit"


@contextlib.contextmanager
def restic_session(*, offsite: bool = False, copy_from_local: bool = False):  # type: ignore[no-untyped-def]
    """저장소 주소 파일을 임시 폴더(0700)에 쓰고 Restic 을 돌려준다. 끝나면 지운다."""
    layout = get_layout()
    if layout.backup is None:
        raise dbackup.BackupConfigError("배치 설정 파일(deploy/layout.json)이 없어 백업 설정(backup)이 없다. 서버 밖 백업 대상이 없으면 백업을 시작하지 않는다(D88 U6)")
    repository, local, remote = backup_settings(layout.backup)
    META_DIR.mkdir(parents=True, exist_ok=True)
    directory = Path(tempfile.mkdtemp(prefix="backup-", dir=META_DIR))
    directory.chmod(0o700)
    try:
        yield Restic(directory, "offsite" if offsite else "local", copy_from_local, (layout.backup, repository, local, remote))
    finally:
        shutil.rmtree(directory, ignore_errors=True)


@app.command()
def backup() -> None:
    """모든 영역 데이터베이스(그 영역이 있는 서버마다)를 백업 저장소(restic)에 한 스냅샷으로 저장하고 보관 기간(14일)이 지난 것을 정리한다. 잡 BACKUP."""
    with job_run("BACKUP") as run:
        layout = get_layout()
        if layout.backup is None:
            raise dbackup.BackupConfigError("배치 설정 파일(deploy/layout.json)이 없어 백업 설정(backup)이 없다. 서버 밖 백업 대상이 없으면 백업을 시작하지 않는다(D88 U6)")
        backup_settings(layout.backup)  # 왜 먼저: 설정이 틀리면 덤프를 뜨기 전에 멈춘다
        targets = backup_targets()
        volumes = backup_volumes()
        if not targets and not volumes:
            raise JobFailure("백업할 영역 저장소가 없다(compose 라벨 io.openit.backup: 서비스는 postgres, 볼륨은 files)")
        BACKUP_DIR.mkdir(parents=True, exist_ok=True)
        BACKUP_DIR.chmod(0o700)
        # 왜 임시 폴더: 한 스냅샷(계약 BackupSnapshotId 하나)에 모든 DB 를 담으려면 덤프를 한곳에 모아야 한다. 평문이라 0700 이고 restic 에 올린 직후 지운다
        stage = Path(tempfile.mkdtemp(prefix="stage-", dir=BACKUP_DIR))
        try:
            dumped = [dump_target(server, owner, service, user, stage) for server, owner, service, user in targets]
            dumped_volumes = [dump_volume(server, owner, key, name, paths, stage) for server, owner, key, name, paths in volumes]
            major = pg_query(targets[0][0], targets[0][2], targets[0][3], "select current_setting('server_version_num')::int / 10000") if targets else ""
            (stage / "manifest.json").write_text(dbackup.manifest_json(utc_now(), project_name(), major, dumped, dumped_volumes), encoding="utf-8")
            with restic_session() as restic:
                restic.ensure_repository()
                result = restic.ok("스냅샷 만들기", ["backup", dbackup.STAGE_DIR, "--host", project_name(), "--tag", BACKUP_TAG, "--json", "--quiet"], stage=stage)
                summary = [json.loads(line) for line in result.stdout.decode().splitlines() if line.startswith("{")]
                run.snapshot = next(item["snapshot_id"] for item in reversed(summary) if item.get("message_type") == "summary")
                restic.forget()
        finally:
            shutil.rmtree(stage, ignore_errors=True)
        databases = sum(len(target.databases) for target in dumped)
        run.processed = databases + len(dumped_volumes)
        files = sum(len(volume.files) for volume in dumped_volumes)
        typer.echo(f"백업: 스냅샷 {run.snapshot[:8]} (데이터베이스 {databases}개, 상태 볼륨 {len(dumped_volumes)}개의 파일 {files}개, 보관 {dbackup.RETENTION_WITHIN})")


@app.command("offsite-sync")
def offsite_sync() -> None:
    """백업 저장소의 스냅샷을 서버 밖 대상(offsite_url)으로 옮기고(restic copy) 같은 보관 기간으로 정리한다. 잡 OFFSITE_SYNC."""
    with job_run("OFFSITE_SYNC") as run, restic_session(offsite=True, copy_from_local=True) as restic:
        restic.ensure_repository(copy_from_local=True)
        copied = restic.ok("서버 밖으로 복사", ["copy", "--host", project_name(), "--tag", BACKUP_TAG])
        run.processed = copied.stdout.decode().count("copied from source snapshot")
        restic.forget()
        typer.echo(f"서버 밖 동기화: 스냅샷 {run.processed}개 복사, 보관 {dbackup.RETENTION_WITHIN}")


def resolve_snapshot(restic: Restic, wanted: str) -> str:
    snapshots = restic.snapshots()
    if not snapshots:
        raise JobFailure("저장소에 이 설치의 스냅샷이 없다")
    if wanted == "latest":
        return snapshots[-1]["id"]
    if not dbackup.SNAPSHOT_ID.fullmatch(wanted):
        raise JobFailure(f"스냅샷 ID 가 아니다: {wanted}")
    matches = [item["id"] for item in snapshots if item["id"].startswith(wanted)]
    if len(matches) != 1:
        raise JobFailure(f"스냅샷 {wanted} 을 저장소에서 {'찾지 못했다' if not matches else '하나로 정하지 못했다'}")
    return matches[0]


def read_manifest(restic: Restic, snapshot: str) -> dbackup.Manifest:
    result = restic.ok("manifest 읽기", ["dump", snapshot, f"{dbackup.STAGE_DIR}/manifest.json"])
    return dbackup.parse_manifest(result.stdout.decode())


def stream_dump(restic: Restic, snapshot: str, path: str, consumer: Callable[[object], subprocess.CompletedProcess[bytes]]) -> None:
    """저장소의 파일 하나(restic dump)를 consumer 의 표준 입력으로 흘려 보낸다. 두 쪽 종료 코드를 모두 본다."""
    try:
        environ = dockerenv.docker_env(None)
    except dockerenv.DockerEnvError as error:
        raise JobFailure(f"docker 환경을 정하지 못했다: {error}") from error
    with tempfile.TemporaryFile() as errors:
        source = subprocess.Popen(restic.dump_argv(snapshot, path), env=environ, stdout=subprocess.PIPE, stderr=errors)  # noqa: S603
        try:
            result = consumer(source.stdout)
        finally:
            if source.stdout:
                source.stdout.close()
            code = source.wait()
        errors.seek(0)
        if code != 0:
            raise JobFailure(f"저장소에서 {path} 를 읽지 못했다(restic rc={code}): {tail(errors.read())}")
    if result.returncode != 0:
        raise JobFailure(f"{path} 복구 실패(rc={result.returncode}): {tail(result.stderr)}")


def restore_roles_and_databases(restic: Restic, snapshot: str, target: dbackup.Target, run_in: Callable[..., subprocess.CompletedProcess[bytes]]) -> None:
    """한 영역 DB 에 역할과 데이터베이스를 복구한다. run_in(args, **kw) 은 DB 컨테이너 안에서 명령을 실행한다."""
    base = f"{dbackup.STAGE_DIR}/{target.owner}"

    def psql(*extra: str, **kwargs: object) -> subprocess.CompletedProcess[bytes]:
        return run_in(["psql", "--username", target.user, "--dbname", "template1", "--no-psqlrc", "--quiet", *extra], **kwargs)

    # 역할은 이미 있으면 CREATE ROLE 이 실패하고 건너뛴다(ON_ERROR_STOP 없음). 같은 역할은 그대로 둔다
    stream_dump(restic, snapshot, f"{base}/globals.sql", lambda stdin: psql(stdin=stdin, capture_output=True))
    for name, _ in target.databases:
        # 왜 WITH (FORCE): PostgreSQL 13+ 표준 옵션으로 남은 연결을 끊고 지운다
        dropped = psql("--set", "ON_ERROR_STOP=1", "--command", f'DROP DATABASE IF EXISTS "{name}" WITH (FORCE)', capture_output=True)
        if dropped.returncode != 0:
            raise JobFailure(f"{target.owner} 의 {name} 을 지우지 못했다(rc={dropped.returncode}): {tail(dropped.stderr)}")
        stream_dump(restic, snapshot, f"{base}/{name}.dump",
                    lambda stdin: run_in(["pg_restore", "--username", target.user, "--dbname", "template1", "--create", "--exit-on-error", "--no-password"],
                                         stdin=stdin, capture_output=True))


def restore_volume(restic: Restic, snapshot: str, volume: dbackup.VolumeTarget) -> None:
    """영역 상태 볼륨을 스냅샷의 tar 로 되돌린다: 볼륨을 쓰는 서비스를 멈추고, 백업한 경로를 비우고, tar 를 풀고, 다시 띄운다.

    왜 비우고 푼다: 백업 때 없던 파일이 남으면 상태가 백업 시점과 달라진다(백업한 경로 밖은 건드리지 않는다: 받은 패키지 같은 캐시). 왜 서비스를 멈춘다: 파일을 시작할 때
    읽는 서비스(model-runtime)는 풀린 파일을 다시 읽어야 한다.
    """
    if volume.owner not in dlayout.SERVICE_NAMES:
        raise JobFailure(f"백업의 영역 {volume.owner} 가 이 배치에 없다")
    server = get_layout().server_of(volume.owner)
    model = compose_model(server)
    spec = (model.get("volumes") or {}).get(volume.volume)  # type: ignore[attr-defined]
    if spec is None:
        raise JobFailure(f"서버 {server.name} 의 compose 에 볼륨 {volume.volume} 이 없다")
    name = (spec or {}).get("name") or volume.volume
    here = set(selected_services(server, model))
    users = [service for service in dbackup.services_using(model, volume.volume) if service in here]
    stopped = sorted({*users, *(dependent for service in users for dependent in dbackup.dependents(model, service) if dependent in here)})
    if stopped:
        typer.echo(f"[{server.name}] 복구 동안 멈춘다: {', '.join(stopped)}")
        if compose(["stop", *stopped], server).returncode != 0:
            raise JobFailure("볼륨을 쓰는 서비스를 멈추지 못했다")
    if not volume_exists(server, name) and users and compose(["create", "--no-deps", *users], server).returncode != 0:
        raise JobFailure(f"볼륨 {volume.volume} 을 만들지 못했다")  # 왜 compose 로: compose 가 만든 볼륨이어야 나중에 up 이 거절하지 않는다
    helper = [*volume_helper(name, writable=True, caps=("CHOWN", "DAC_OVERRIDE", "FOWNER"), interactive=True), "--entrypoint", "sh", tool_image(), "-c",
              'cd /vol && for p in "$@"; do rm -rf -- "$p"; done && tar -x -p -f - -C /vol', "sh", *volume.paths]
    stream_dump(restic, snapshot, volume.archive, lambda stdin: volume_run(server, helper, stdin=stdin, capture_output=True))
    typer.echo(f"[{server.name}] {volume.owner}: 상태 볼륨 {volume.volume} 복구(파일 {len(volume.files)}개)")
    for tier in dlayout.tiers(model, stopped):  # type: ignore[arg-type]
        if compose(["up", "-d", "--wait", "--no-deps", *tier], server).returncode != 0:
            raise JobFailure(f"멈춘 서비스를 다시 띄우지 못했다: {', '.join(tier)} (./deploy up)")


def verify_volume_archive(restic: Restic, snapshot: str, volume: dbackup.VolumeTarget) -> None:
    """스냅샷의 tar 를 읽어 파일 목록(경로·크기·SHA-256)이 백업 때 manifest 와 같은지 본다. 운영 볼륨은 건드리지 않는다."""
    try:
        environ = dockerenv.docker_env(None)
    except dockerenv.DockerEnvError as error:
        raise JobFailure(f"docker 환경을 정하지 못했다: {error}") from error
    with tempfile.TemporaryFile() as errors:
        source = subprocess.Popen(restic.dump_argv(snapshot, volume.archive), env=environ, stdout=subprocess.PIPE, stderr=errors)  # noqa: S603
        try:
            assert source.stdout is not None  # noqa: S101
            found = dbackup.archive_entries(source.stdout)
            while source.stdout.read(1 << 20):  # 왜 끝까지 읽는다: tar 끝 표지 뒤의 나머지를 비워야 restic 이 정상 종료한다
                pass
        finally:
            if source.stdout:
                source.stdout.close()
            code = source.wait()
        errors.seek(0)
        if code != 0:
            raise JobFailure(f"저장소에서 {volume.archive} 를 읽지 못했다(restic rc={code}): {tail(errors.read())}")
    if found != sorted(volume.files, key=lambda entry: entry.path):
        raise JobFailure(f"{volume.owner} 의 볼륨 {volume.volume}: 복구한 파일 목록(경로·크기·SHA-256)이 백업 때와 다르다")


@app.command()
def restore(
    snapshot: Annotated[str, typer.Argument(help="복구할 스냅샷 ID(없으면 가장 최근). --offsite 이면 서버 밖 저장소의 ID")] = "latest",
    yes: Annotated[bool, typer.Option("--yes", help="덮어쓰기를 확인했다")] = False,
    offsite: Annotated[bool, typer.Option("--offsite", help="백업 저장소 대신 서버 밖 저장소에서 읽는다(백업 저장소를 잃었을 때)")] = False,
) -> None:
    """스냅샷의 모든 영역 데이터베이스를 복구한다(백업에 있는 데이터베이스를 지우고 다시 만든다). 그 DB 를 쓰는 서비스는 멈췄다가 다시 띄운다. 잡 RESTORE."""
    if not yes:
        fail("복원은 기존 데이터를 덮어쓴다. 확인했으면 --yes 를 붙인다", 2)
    with job_run("RESTORE") as run, restic_session(offsite=offsite) as restic:
        chosen = resolve_snapshot(restic, snapshot)
        manifest = read_manifest(restic, chosen)
        layout = get_layout()
        count = 0
        for target in manifest.targets:
            if target.owner not in dlayout.SERVICE_NAMES:
                raise JobFailure(f"백업의 영역 {target.owner} 가 이 배치에 없다")
            server = layout.server_of(target.owner)
            model = compose_model(server)
            if target.service not in model["services"]:  # type: ignore[operator]
                raise JobFailure(f"서버 {server.name} 에 compose 서비스 {target.service} 가 없다")
            chosen_here = set(selected_services(server, model))
            # 왜 돌고 있는지와 무관하게 멈춘다: DB 가 지워지며 재시작을 반복하는 서비스도 복구 도중 다시 붙으면 안 된다. 복구 뒤에는 모두 다시 띄운다
            dependents = [name for name in dbackup.dependents(model, target.service) if name in chosen_here]
            if dependents:
                typer.echo(f"[{server.name}] 복구 동안 멈춘다: {', '.join(dependents)}")
                if compose(["stop", *dependents], server).returncode != 0:
                    raise JobFailure("DB 를 쓰는 서비스를 멈추지 못했다")
            if not is_service_running(server, target.service):
                if compose(["up", "-d", "--wait", "--no-deps", target.service], server).returncode != 0:
                    raise JobFailure(f"{target.service} 를 띄우지 못했다")
            restore_roles_and_databases(restic, chosen, target, lambda args, _s=server, _t=target, **kw: engine_run(_s, ["exec", "-T", _t.service, *args], **kw))
            count += len(target.databases)
            typer.echo(f"[{server.name}] {target.owner}: 데이터베이스 {len(target.databases)}개 복구")
            if dependents:
                for tier in dlayout.tiers(model, dependents):  # type: ignore[arg-type]
                    if compose(["up", "-d", "--wait", "--no-deps", *tier], server).returncode != 0:
                        raise JobFailure(f"멈춘 서비스를 다시 띄우지 못했다: {', '.join(tier)} (./deploy up)")
        volumes = 0
        for volume in manifest.volumes:
            restore_volume(restic, chosen, volume)
            volumes += 1
        run.processed = count + volumes
        typer.echo(f"복구 완료: 스냅샷 {chosen[:8]}, 데이터베이스 {count}개, 상태 볼륨 {volumes}개")


@app.command("restore-test")
def restore_test(
    snapshot: Annotated[str, typer.Argument(help="시험할 스냅샷 ID(없으면 가장 최근)")] = "latest",
    offsite: Annotated[bool, typer.Option("--offsite", help="서버 밖 저장소의 스냅샷을 시험한다")] = False,
) -> None:
    """스냅샷을 일회용 PostgreSQL 컨테이너(네트워크 없음)에 복구해 되는지 시험한다. 운영 DB 는 건드리지 않는다. 잡 RESTORE_TEST.

    확인: 모든 데이터베이스가 pg_restore 로 복구되고 복구된 테이블 수가 백업 때 목차의 테이블 수와 같다. 상태 볼륨은 tar 를 읽어 파일의 경로·크기·SHA-256 이 백업 때와 같은지 본다.
    """
    with job_run("RESTORE_TEST") as run, restic_session(offsite=offsite) as restic:
        chosen = resolve_snapshot(restic, snapshot)
        manifest = read_manifest(restic, chosen)
        targets = manifest.targets
        try:
            environ = dockerenv.docker_env(None)
        except dockerenv.DockerEnvError as error:
            raise JobFailure(f"docker 환경을 정하지 못했다: {error}") from error
        model = compose_model(get_layout().platform)
        count = 0
        for target in targets:
            image = model["services"][target.service]["image"]  # type: ignore[index]  # 왜 같은 이미지: 운영 DB 와 같은 PostgreSQL 이어야 복구가 되는지가 맞다
            name = f"{project_name()}-restore-test-{pysecrets.token_hex(4)}"
            started = subprocess.run(["docker", "run", "-d", "--rm", "--name", name, "--network", "none", "--tmpfs", "/var/lib/postgresql/data",
                                      "-e", f"POSTGRES_USER={target.user}", "-e", "POSTGRES_HOST_AUTH_METHOD=trust", image],  # 왜 trust: 네트워크가 없는 일회용 컨테이너라 닿는 곳이 없다
                                     env=environ, capture_output=True, check=False)  # noqa: S603, S607
            if started.returncode != 0:
                raise JobFailure(f"일회용 PostgreSQL 을 띄우지 못했다: {tail(started.stderr)}")
            try:
                def run_in(args: list[str], _name: str = name, _env: dict[str, str] = environ, **kwargs: object) -> subprocess.CompletedProcess[bytes]:
                    return subprocess.run(["docker", "exec", *(["-i"] if "stdin" in kwargs else []), _name, *args], env=_env, check=False, **kwargs)  # type: ignore[call-overload, no-any-return]  # noqa: S603, S607

                wait_for_postgres(run_in, target.user)
                restore_roles_and_databases(restic, chosen, target, run_in)
                for database, tables in target.databases:
                    restored = run_in(["psql", "--username", target.user, "--dbname", database, "--no-psqlrc", "--quiet", "--tuples-only", "--no-align", "--command",
                                       "select count(*) from information_schema.tables where table_type = 'BASE TABLE' and table_schema not in ('pg_catalog', 'information_schema')"],
                                      capture_output=True)
                    found = int(restored.stdout.decode().strip() or -1)
                    if found != tables:
                        raise JobFailure(f"{target.owner} 의 {database}: 복구된 테이블 {found}개가 백업 때 목차의 {tables}개와 다르다")
                    count += 1
            finally:
                subprocess.run(["docker", "rm", "-f", "-v", name], env=environ, capture_output=True, check=False)  # noqa: S603, S607
        for volume in manifest.volumes:
            verify_volume_archive(restic, chosen, volume)
        run.processed = count + len(manifest.volumes)
        typer.echo(f"복구 시험 통과: 스냅샷 {chosen[:8]}, 데이터베이스 {count}개를 일회용 PostgreSQL 에 복구해 테이블 수가 같고, 상태 볼륨 {len(manifest.volumes)}개의 파일(경로·크기·SHA-256)이 백업 때와 같다")


POSTGRES_READY_SECONDS = 60  # 일회용 PostgreSQL 이 TCP 로 받을 때까지의 상한(초기화 포함). 측정하지 않았다. 되면 곧바로 넘어간다


def wait_for_postgres(run_in: Callable[..., subprocess.CompletedProcess[bytes]], user: str) -> None:
    """초기화 중의 임시 서버는 유닉스 소켓만 듣는다. 127.0.0.1 로 닿으면 최종 서버가 선 것이다."""
    deadline = time.monotonic() + POSTGRES_READY_SECONDS
    while time.monotonic() < deadline:
        if run_in(["pg_isready", "--host", "127.0.0.1", "--username", user, "--quiet"], capture_output=True).returncode == 0:
            return
        time.sleep(0.5)
    raise JobFailure(f"일회용 PostgreSQL 이 {POSTGRES_READY_SECONDS}초 안에 서지 않았다")


# ---------------------------------------------------------------- 신뢰의 뿌리: 사설 CA(ADR 0014, 0015)


def ca_cfg() -> pki.CaSettings:
    try:
        return pki.ca_settings(env_values())
    except pki.ConfigError as error:
        fail(f"인증서 설정이 틀렸다: {error}")


def reg_cfg() -> pki.RegistrySettings:
    try:
        return pki.registry_settings(env_values())
    except pki.ConfigError as error:
        fail(f"레지스트리 설정이 틀렸다: {error}")


def bundle_path() -> Path:
    return pki.resolve_path(DEPLOY, env_values()["OPENIT_TRUST_LIST_FILE"])


def extra_trust_dir() -> Path:
    return pki.resolve_path(DEPLOY, env_values()["OPENIT_TRUST_EXTRA_DIR"])


def service_image(name: str) -> str:
    config = compose(["config", "--format", "json"], capture_output=True)
    if config.returncode != 0:
        fail(f"compose config 실패: {config.stderr.strip()[-300:]}")
    return json.loads(config.stdout)["services"][name]["image"]


def prometheus_image() -> str:
    return service_image("prometheus")


def private_dir(path: Path) -> None:
    path.mkdir(parents=True, exist_ok=True)
    path.chmod(0o700)


def step_cli(args: list[str], *, rw: dict[Path, str] | None = None, ro: dict[Path, str] | None = None) -> subprocess.CompletedProcess[str]:
    """step CLI 를 일회용 컨테이너에서 돌린다(네트워크 없음, 읽기 전용 루트, 호출자 uid). 인증서 만들기는 CA 도구가 맡는다."""
    command = ["run", "--rm", "--network", "none", "--read-only", "--tmpfs", "/tmp", "--cap-drop", "ALL",
               "--user", f"{os.getuid()}:{os.getgid()}", "-e", "HOME=/tmp", "-e", "STEPPATH=/tmp/.step", "--entrypoint", "step"]
    for host, inside in (rw or {}).items():
        command += ["-v", f"{host}:{inside}"]
    for host, inside in (ro or {}).items():
        command += ["-v", f"{host}:{inside}:ro"]
    return docker([*command, service_image(STEP_IMAGE_SERVICE), *args], capture_output=True)


def step_or_fail(what: str, result: subprocess.CompletedProcess[str]) -> None:
    if result.returncode != 0:
        fail(f"{what} 실패(rc={result.returncode}): {(result.stderr or result.stdout).strip()[-400:]}")


def read_password(name: str) -> bytes:
    return (SECRETS_DIR / name).read_text(encoding="utf-8").strip().encode()


def bounded_minutes(configured: int, root_cert: object) -> int:
    """중간 CA 수명(분). 설정 값이되 루트의 남은 수명을 넘지 않는다(RFC 5280 6.1.3: 하위는 상위보다 오래 살 수 없다)."""
    left = int(pki.remaining(root_cert).total_seconds() // 60) - 60  # type: ignore[arg-type]
    if left < 2 * ca_cfg().leaf_minutes:
        fail("루트 CA 의 남은 수명이 리프 수명의 두 배보다 짧아 중간 CA 를 만들 수 없다. 루트 교체가 먼저다(docs/CA.md 의 '루트 교체')")
    return min(configured, left)


def create_root(cfg: pki.CaSettings) -> None:
    result = step_cli(
        ["certificate", "create", f"{cfg.name} Root CA", "/pki/root_ca.crt", "/pki/root_ca.key", "--profile", "root-ca",
         "--not-after", pki.fmt_minutes(cfg.root_minutes), "--password-file", "/run/pw/root"],
        rw={PKI_DIR: "/pki"}, ro={SECRETS_DIR / "step_ca_root_password": "/run/pw/root"},
    )
    step_or_fail("루트 CA 생성", result)
    (PKI_DIR / "root_ca.key").chmod(0o600)


def create_intermediate(cfg: pki.CaSettings) -> None:
    """self 방식: 루트가 서명한 새 중간 CA 를 pending/ 에 만든다."""
    root = pki.load_cert(PKI_DIR / "root_ca.crt")
    private_dir(PENDING_DIR)
    for leftover in ("intermediate_ca.crt", "intermediate_ca.key"):
        (PENDING_DIR / leftover).unlink(missing_ok=True)
    result = step_cli(
        ["certificate", "create", f"{cfg.name} Intermediate CA", "/out/intermediate_ca.crt", "/out/intermediate_ca.key",
         "--profile", "intermediate-ca", "--ca", "/pki/root_ca.crt", "--ca-key", "/pki/root_ca.key", "--ca-password-file", "/run/pw/root",
         "--password-file", "/run/pw/ca", "--not-after", pki.fmt_minutes(bounded_minutes(cfg.intermediate_minutes, root))],
        rw={PENDING_DIR: "/out"},
        ro={PKI_DIR / "root_ca.crt": "/pki/root_ca.crt", PKI_DIR / "root_ca.key": "/pki/root_ca.key",
            SECRETS_DIR / "step_ca_root_password": "/run/pw/root", SECRETS_DIR / "step_ca_password": "/run/pw/ca"},
    )
    step_or_fail("중간 CA 생성", result)


def create_csr(cfg: pki.CaSettings) -> Path:
    """organization 방식: 중간 CA 키와 서명 요청(CSR)을 pending/ 에 만든다. 기관 CA 가 서명한다."""
    private_dir(PENDING_DIR)
    for leftover in ("intermediate.csr", "intermediate_ca.key", "intermediate_ca.crt"):
        (PENDING_DIR / leftover).unlink(missing_ok=True)
    result = step_cli(
        ["certificate", "create", f"{cfg.name} Intermediate CA", "/out/intermediate.csr", "/out/intermediate_ca.key", "--csr",
         "--password-file", "/run/pw/ca"],
        rw={PENDING_DIR: "/out"}, ro={SECRETS_DIR / "step_ca_password": "/run/pw/ca"},
    )
    step_or_fail("CSR 생성", result)
    return PENDING_DIR / "intermediate.csr"


def archive_current_ca() -> Path | None:
    files = [p for p in (CA_DIR / "intermediate_ca.crt", CA_DIR / "intermediate_ca.key", CA_DIR / "root_ca.crt") if p.is_file()]
    if not files:
        return None
    target = ARCHIVE_DIR / time.strftime("%Y%m%dT%H%M%S")
    private_dir(ARCHIVE_DIR)
    private_dir(target)
    for path in files:
        shutil.copy2(path, target / path.name)
    return target


def install_intermediate(cert_file: Path, key_file: Path, root_file: Path) -> None:
    """검증한 뒤 ca/ 에 설치한다. 검증: 사슬(각 인증서가 위의 것이 서명했고 CA 로 쓸 수 있다), 개인 키 일치, 유효 기간."""
    chain = pki.load_certs(cert_file)
    root = pki.load_cert(root_file)
    problems: list[str] = []
    for index, cert in enumerate(chain):
        issuer = chain[index + 1] if index + 1 < len(chain) else root
        problems += [f"{pki.subject_text(cert)}: {item}" for item in pki.check_intermediate(cert, issuer)]
    try:
        if not pki.key_matches_cert(key_file, read_password("step_ca_password"), chain[0]):
            problems.append("개인 키가 첫 인증서와 짝이 아니다")
    except (ValueError, TypeError) as error:
        problems.append(f"개인 키를 열지 못했다(암호가 다르거나 키가 아니다): {error}")
    if problems:
        fail("설치할 수 없다:\n  " + "\n  ".join(problems))
    archived = archive_current_ca()
    private_dir(CA_DIR)
    # 왜 파일을 덮어 쓴다(rename 아님): 컨테이너 마운트는 파일 단위라 새 inode 가 되면 보이지 않는다. 어차피 step-ca 는 다시 만든다
    (CA_DIR / "intermediate_ca.crt").write_text(pki.pem_text(chain), encoding="ascii")
    shutil.copyfile(key_file, CA_DIR / "intermediate_ca.key")
    (CA_DIR / "root_ca.crt").write_text(pki.pem_text([root]), encoding="ascii")
    # 왜 0644: 키는 암호로 잠겨 있고, 컨테이너 사용자가 읽으려면 읽기 가능해야 한다. 호스트 쪽 접근은 0700 폴더가 막는다(ADR 0008)
    for name in ("intermediate_ca.crt", "intermediate_ca.key", "root_ca.crt"):
        (CA_DIR / name).chmod(0o644)
    for leftover in PENDING_DIR.glob("*") if PENDING_DIR.is_dir() else []:
        leftover.unlink()
    typer.echo(f"설치함: 중간 CA {pki.subject_text(chain[0])}" + (f" (이전 파일 보관: {archived.relative_to(ROOT)})" if archived else ""))


def write_if_changed(path: Path, text: str, mode: int = 0o644) -> bool:
    if path.is_file() and path.read_text(encoding="utf-8") == text:
        return False
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding="utf-8")
    path.chmod(mode)
    return True


def write_bundle() -> bool:
    text = pki.build_bundle([CA_DIR / "root_ca.crt"], extra_trust_dir())
    return write_if_changed(bundle_path(), text)


def ensure_pki(cfg: pki.CaSettings) -> bool:
    """신뢰의 뿌리를 갖춘다. 이미 있는 것은 건드리지 않는다(멱등). step-ca 가 읽는 파일이 바뀌었으면 True."""
    secrets_init()
    private_dir(PKI_DIR)
    private_dir(CA_DIR)
    extra_trust_dir().mkdir(parents=True, exist_ok=True)
    changed = False
    if cfg.mode == "self":
        if (PKI_DIR / "root_ca.crt").is_file() != (PKI_DIR / "root_ca.key").is_file():
            fail("deploy/pki/ 에 루트 인증서와 키 중 하나만 있다. 직접 확인하고 보관본에서 복구한다(자동으로 덮어쓰지 않는다)")
        if not (PKI_DIR / "root_ca.crt").is_file():
            create_root(cfg)
            typer.echo("만듦: 루트 CA(개인 키는 deploy/pki/root_ca.key, 이 관리 노드에만 둔다)")
        if not (CA_DIR / "intermediate_ca.crt").is_file():
            create_intermediate(cfg)
            install_intermediate(PENDING_DIR / "intermediate_ca.crt", PENDING_DIR / "intermediate_ca.key", PKI_DIR / "root_ca.crt")
            changed = True
        else:
            typer.echo("있음: 중간 CA")
    elif not (CA_DIR / "intermediate_ca.crt").is_file():
        csr = PENDING_DIR / "intermediate.csr"
        if not csr.is_file():
            create_csr(cfg)
        fail(
            f"기관 CA 가 서명한 중간 CA 가 아직 없다. 서명 요청: {csr.relative_to(ROOT)}\n"
            "  기관 CA 에 이 요청을 서명받은 뒤(CA 인증서, pathlen 0 이상, 기간은 리프 수명 이상):\n"
            "  ./deploy ca install --cert <서명된 인증서(사슬 포함 가능)> --root <기관 루트 인증서>  그리고 ./deploy bootstrap 을 다시 실행한다"
        )
    changed |= write_if_changed(CA_DIR / "ca.json", pki.render_ca_json_text(cfg))
    changed |= write_bundle()
    sync_generated()
    return changed


# ---------------------------------------------------------------- 레지스트리(ADR 0013)


def published_endpoint(service: str, port: int) -> tuple[str, int] | None:
    layout = get_layout()
    if layout.multi and service in ("registry", "ingress-acme"):
        # 왜 서버 주소와 같은 포트: 여러 서버일 때 플랫폼 서버는 이 포트를 고정으로 게시한다(다른 서버가 이름으로 찾는다, ADR 0026)
        return (layout.platform.address, port) if is_running(service) else None
    result = compose(["port", service, str(port)], capture_output=True)
    text = result.stdout.strip()
    if result.returncode != 0 or ":" not in text:
        return None
    host, _, number = text.rpartition(":")
    return ("127.0.0.1" if host in ("", "0.0.0.0", "::", "[::]") else host.strip("[]")), int(number)


def engine_host() -> str:
    """docker 엔진이 있는 호스트. 원격 엔진(docker context, SSH)이면 게시된 포트는 그 호스트에 있다."""
    if get_layout().multi:
        return get_layout().platform.address  # 왜: 여러 서버면 레지스트리와 입구는 플랫폼 서버의 주소로 닿는다
    env = dockerenv.docker_env()
    endpoint = env.get("DOCKER_HOST", "")
    if endpoint.startswith(("ssh://", "tcp://")):
        return endpoint.split("://", 1)[1].rpartition("@")[2].split(":")[0]
    return "127.0.0.1"


class Registry:
    """이미지를 올리고 내려받을 레지스트리. local 은 compose 안쪽 이름(registry:443), external 은 설정의 주소."""

    def __init__(self, prefix: str, local: bool) -> None:
        self.prefix = prefix  # 이미지 이름 앞부분
        self.local = local


def registry_target(reg: pki.RegistrySettings) -> Registry:
    if reg.mode == "external":
        return Registry(reg.address, False)
    return Registry(f"{reg.names[0]}:443", True)


def crane(args: list[str], stage: Path | None = None) -> subprocess.CompletedProcess[str]:
    """레지스트리 클라이언트(crane, 일회용 컨테이너)를 compose 안쪽 네트워크에서 돌린다. 인증서는 신뢰 목록으로 검증한다.

    왜 데몬의 push 가 아닌가: 데몬이 게시된 포트에 닿는지는 설치 환경에 달렸다(Docker Desktop 에서는 닿지 않는 것을 확인했다). 안쪽 네트워크의 이름으로 접속하면
    어느 환경에서나 같고, 데몬에 루트 인증서를 설치(certs.d)하지 않아도 TLS 를 완전히 검증한다(ADR 0013).
    """
    if get_layout().multi:
        return crane_on_build_engine(args, stage)
    command = [*compose_args(), "--profile", "tools", "run", "--rm", "--no-deps", "-T", "--user", f"{os.getuid()}:{os.getgid()}"]
    if stage is not None:
        command += ["-v", f"{stage}:/w"]
    return docker([*command, "registry-client", *args], capture_output=True)


def crane_on_build_engine(args: list[str], stage: Path | None) -> subprocess.CompletedProcess[str]:
    """여러 서버일 때의 레지스트리 클라이언트: 레지스트리는 플랫폼 서버에 있어 compose 안쪽 네트워크로 닿지 못한다. 빌드 엔진의 일회용 컨테이너가 레지스트리 이름을
    플랫폼 서버 주소로 풀어(--add-host) 접속한다. 인증서는 같은 신뢰 목록으로 검증한다(검증을 끄지 않는다)."""
    layout = get_layout()
    reg = reg_cfg()
    image = yaml.safe_load(COMPOSE_FILE.read_text(encoding="utf-8"))["services"]["registry-client"]["image"]
    command = ["run", "--rm", "--read-only", "--cap-drop", "ALL", "--security-opt", "no-new-privileges:true", "--user", f"{os.getuid()}:{os.getgid()}",
               "-e", "SSL_CERT_FILE=/etc/openit/trust-bundle.pem", "-v", f"{bundle_path()}:/etc/openit/trust-bundle.pem:ro",
               "--add-host", f"{reg.names[0]}:{dlayout.resolve_ip(layout.platform.address)}"]
    if stage is not None:
        command += ["-v", f"{stage}:/w"]
    return docker([*command, image, *args], capture_output=True)


def registry_has(target: Registry, repo: str, digest: str) -> bool:
    """레지스트리에 그 digest 의 매니페스트가 있는가. 확인하지 못하면 False(올리기는 멱등이다)."""
    reference = f"{target.prefix}/{repo}@{digest}"
    if target.local:
        return crane(["manifest", reference]).returncode == 0
    return docker(["buildx", "imagetools", "inspect", reference], capture_output=True).returncode == 0


def verify_registry_tls(reg: pki.RegistrySettings) -> None:
    """레지스트리의 인증서를 신뢰 목록으로 검증하고(예외 없이) 유효 기간을 보인다."""
    endpoint = published_endpoint("registry", 443)
    if endpoint is None:
        fail("레지스트리가 떠 있지 않다(./deploy bootstrap)")
    try:
        leaf = pki.fetch_leaf(engine_host(), endpoint[1], reg.names[0], bundle_path())
    except (OSError, ssl.SSLError) as error:
        fail(f"레지스트리 TLS 검증 실패(신뢰 목록으로 이름 '{reg.names[0]}' 을 검증): {error}")
    typer.echo(f"레지스트리 TLS 검증 통과: {reg.names[0]} 남은 {pki.remaining(leaf).total_seconds() / 3600:.1f}시간")


def local_image(name: str) -> str:
    return f"openit/{name.lstrip('_')}"


def push_images(reg: pki.RegistrySettings) -> None:
    targets = area_targets()
    if not targets:
        typer.echo("올릴 이미지 없음(services/·jobs/·web/ 에 Dockerfile 이 있는 영역이 없다)")
        return
    target = registry_target(reg)
    lock = read_lock()
    for name in targets:
        repo = local_image(name)
        if name in lock and registry_has(target, repo, lock[name]):
            typer.echo(f"레지스트리에 있음: {name} {lock[name]}")
            continue
        if docker(["image", "inspect", f"{repo}:local"], capture_output=True).returncode != 0:
            build(name, False)  # 왜 여기서 빌드: 로컬에 이미지가 없으면 올릴 것이 없다. 빌드는 lock 도 갱신한다
        remote = f"{target.prefix}/{repo}:local"
        if target.local:
            stage = META_DIR / "push"
            stage.mkdir(parents=True, exist_ok=True)
            archive = stage / f"{name}.tar"
            if (saved := docker(["save", f"{repo}:local", "-o", str(archive)], capture_output=True)).returncode != 0:
                fail(f"{name} 저장 실패: {saved.stderr.strip()[-300:]}")
            pushed = crane(["push", f"/w/{archive.name}", remote], stage)
            archive.unlink(missing_ok=True)
        else:
            if (tag := docker(["tag", f"{repo}:local", remote], capture_output=True)).returncode != 0:
                fail(f"{name} 태그 실패: {tag.stderr.strip()[-300:]}")
            pushed = docker(["push", remote], capture_output=True)
        if pushed.returncode != 0:
            fail(f"{name} push 실패(rc={pushed.returncode}): {(pushed.stderr or pushed.stdout).strip()[-400:]}")
        found = re.search(r"(sha256:[0-9a-f]{64})", pushed.stdout if target.local else pushed.stdout + pushed.stderr)
        if not found:
            fail(f"{name}: push 결과에서 digest 를 찾지 못했다")
        lock = read_lock()
        lock[name] = found.group(1)  # 왜 push 가 준 digest: 내려받을 때 쓰는 값은 레지스트리의 매니페스트 digest 다
        write_lock(lock)
        typer.echo(f"올림: {name} {found.group(1)}")


@app.command()
def pull(service: Annotated[str | None, typer.Argument(help="내려받을 대상(없으면 lock 의 전부)")] = None) -> None:
    """images.lock 의 digest 로 레지스트리에서 이미지를 내려받는다(태그가 아니라 digest 로). local 은 안쪽 네트워크에서 받아 docker load 한다."""
    reg = reg_cfg()
    target = registry_target(reg)
    lock = read_lock()
    names = [service] if service else list(lock)
    if not names:
        no_target("images.lock 이 비어 있다")
    stage = META_DIR / "pull"
    stage.mkdir(parents=True, exist_ok=True)
    for name in names:
        if name not in lock:
            fail(f"images.lock 에 '{name}' 이 없다", 2)
        reference = f"{target.prefix}/{local_image(name)}@{lock[name]}"
        loaded = reference
        if target.local:
            archive = stage / f"{name}.tar"
            result = crane(["pull", reference, f"/w/{archive.name}"], stage)
            if result.returncode == 0:
                result = docker(["load", "--input", str(archive)], capture_output=True)
                found = re.search(r"Loaded image: (\S+)", result.stdout)
                loaded = found.group(1) if found else ""
            archive.unlink(missing_ok=True)
        else:
            result = docker(["pull", "--quiet", reference], capture_output=True)
        if result.returncode == 0:
            # 왜 이름을 붙인다: compose 는 이 엔진의 `openit/<대상>:local` 이미지를 digest 로 고정해 띄운다(sync_image_env)
            if not loaded or docker(["tag", loaded, f"{local_image(name)}:local"], capture_output=True).returncode != 0:
                fail(f"{name}: 내려받은 이미지에 이름을 붙이지 못했다")
        if result.returncode != 0:
            fail(f"{name} pull 실패(rc={result.returncode}): {(result.stderr or result.stdout).strip()[-400:]}")
        typer.echo(f"받음: {reference}")


@app.command()
def bootstrap() -> None:
    """관리 노드에서 처음부터 설치한다: 신뢰의 뿌리 -> 레지스트리 -> 이미지 push·digest 기록 -> 서비스 기동. 이미 된 단계는 건너뛴다(멱등)."""
    cfg, reg = ca_cfg(), reg_cfg()
    typer.echo("[1/4] 신뢰의 뿌리")
    changed = ensure_pki(cfg)
    typer.echo(f"      CA 방식 {cfg.mode}, 신뢰 목록 {bundle_path()}")
    typer.echo("[2/4] 레지스트리")
    if reg.mode == "external":
        typer.echo(f"      외부 레지스트리 {reg.address} 를 쓴다(레지스트리 단계를 건너뛴다)")
    else:
        if get_layout().multi:
            stage_server(get_layout().platform)  # 왜 먼저: 플랫폼 서버의 엔진이 읽는 파일(CA 설정, 신뢰 목록)을 올려야 step-ca 가 뜬다
        running = compose(["ps", "--quiet", "step-ca"], capture_output=True).stdout.strip()
        if changed and running:
            # 왜 다시 만든다: step-ca 가 읽는 파일이 바뀌었다(중간 CA 교체, 설정 변경). 컨테이너는 시작할 때 읽는다
            if compose(["up", "-d", "--wait", "--force-recreate", "--no-deps", "step-ca"]).returncode != 0:
                fail("step-ca 를 다시 만들지 못했다. ./deploy status 와 로그를 본다")
        if compose(["up", "-d", "--wait", "step-ca", "registry-store", "registry"]).returncode != 0:
            fail("레지스트리를 띄우지 못했다. 진단을 위해 컨테이너와 로그를 남겨 두었다: ./deploy status")
        verify_registry_tls(reg)
    typer.echo("[3/4] 이미지 올리기와 digest 기록")
    push_images(reg)
    typer.echo("[4/4] 서비스 기동")
    up()
    typer.echo("인증서 상태")
    ca_status()
    typer.echo("bootstrap 완료")


