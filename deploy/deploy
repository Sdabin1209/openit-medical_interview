LENIENT_GENERATION = False  # down 처럼 정리하는 명령은 설정이 틀려도 이미 만든 파일로 컨테이너를 내릴 수 있어야 한다
PENDING_CHANGES: set[str] = set()  # 이 실행에서 바뀐 생성 파일. up() 이 이것으로 돌고 있는 서비스를 다시 만든다


def sync_generated() -> list[str]:
    """platform 생성기가 만드는 파일을 generated/ 에 쓴다. 바뀐 파일 이름을 돌려준다(같은 입력이면 비어 있다)."""
    generated = platform_generated()
    changed: list[str] = []
    for relative, text in generated.files.items():
        changed += [relative] if write_if_changed(GENERATED / relative, text) else []
    device_ca = pf_generate.device_ca_copy(generated.settings)
    changed += ["gateway/device-ca.pem"] if write_if_changed(GENERATED / pf_generate.DEVICE_CA_PLACEHOLDER, device_ca) else []
    PENDING_CHANGES.update(changed)
    return changed


UNBUILT_DIGEST = "sha256:" + "0" * 64  # 아직 빌드되지 않은 이미지의 자리(compose 설정은 읽히고 up 이 막는다)


def deployed_images() -> dict[str, str]:
    """compose 가 띄우는 이미지 대상 -> compose 변수 이름. 밑줄로 시작하는 틀 시험 영역은 띄우지 않는다."""
    names: dict[str, str] = {}
    for name, kind in area_targets().items():
        if Path(area_folder(name, kind)).name.startswith("_") or kind == "job":
            continue
        names[name] = "OPENIT_IMAGE_" + re.sub(r"[^A-Z0-9]", "_", name.upper())
    return names


def local_image_digest(name: str) -> str | None:
    """이 엔진에 있는 `openit/<대상>:local` 이미지의 digest(containerd 이미지 저장소에서 이미지 ID 가 매니페스트 digest 다). 없으면 None."""
    result = docker(["image", "inspect", "--format", "{{.Id}}", f"{local_image(name)}:local"], capture_output=True)
    digest = result.stdout.strip()
    return digest if result.returncode == 0 and re.fullmatch(r"sha256:[0-9a-f]{64}", digest) else None


def sync_image_env(server: dlayout.Server | None = None) -> list[str]:
    """영역 이미지 참조를 generated/images.env 에 쓴다: `openit/<대상>@<이 엔진에 있는 이미지의 digest>`(태그가 아니라 digest 로 띄운다, ADR 0004).

    왜 lock 이 아니라 엔진의 이미지: images.lock 의 digest 는 레지스트리에 올린 매니페스트의 digest 라 다른 서버가 내려받는 값이고(ADR 0013),
    같은 내용이어도 이 엔진에 있는 이미지의 digest 와 다를 수 있다(레지스트리가 푸시 때 매니페스트를 다시 쓴다). 띄우는 것은 이 엔진의 이미지이므로 그 digest 로 고정한다.
    `pull` 은 내려받은 이미지를 `openit/<대상>:local` 로 이름 붙여 같은 길을 쓴다. 엔진에 없는 대상은 0 으로 채운 자리를 두고(up 이 막는다) 이름을 돌려준다.
    """
    server = server or active_server()
    lines, unbuilt = [], []
    for name, variable in deployed_images().items():
        digest = local_image_digest(name)
        if digest is None and image_service(name) in server.services:
            unbuilt.append(name)  # 왜 이 서버의 서비스만: 다른 서버의 이미지는 이 엔진에 없어도 된다
        lines.append(f"{variable}={local_image(name)}@{digest or UNBUILT_DIGEST}\n")
    write_if_changed(images_env_file(server), "# ./deploy 가 이 엔진의 이미지에서 만든다. 손으로 고치지 않는다.\n" + "".join(lines))
    return unbuilt


def image_service(name: str) -> str:
    """이미지 대상 이름 -> 계약 ServiceName(화면은 web- 접두어)."""
    return name.removeprefix("web-")


def images_env_file(server: dlayout.Server) -> Path:
    return LAYOUT_DIR / f"{server.name}.images.env" if get_layout().multi else GENERATED / "images.env"


AREA_SERVICES = ("survey-service", "model-runtime", "admin-console", "kiosk-frontend")  # 영역 게이트웨이를 가진 서비스 영역(compose.yaml)


def sync_area_env() -> None:
    """영역 게이트웨이와 서비스가 compose 에서 읽는 파생 값을 generated/areas.env 에 쓴다.

    인증서·키 경로와 건강 확인은 platform 의 영역 게이트웨이 규칙(area_gateway.py)이고, 나가는 터널 주소는 platform 이 만든 egress-proxies.json 이다.
    compose 는 JSON 을 읽지 못해 여기서 변수로 옮긴다. 터널이 없는 영역(노출 선언의 egress 가 비었다)은 빈 값이다.
    """
    env = env_values()
    acme = env["OPENIT_INTERNAL_ACME_DIRECTORY_URL"]
    manifest_file = GENERATED / "gateway" / "egress-proxies.json"
    egress = json.loads(manifest_file.read_text(encoding="utf-8")) if manifest_file.is_file() else {}
    lines: list[str] = []
    for area in AREA_SERVICES:
        suffix = re.sub(r"[^A-Z0-9]", "_", area.upper())
        crt, key = pf_area_gateway.certificate_paths(area, acme)
        lines += [f"OPENIT_AREA_CRT_{suffix}={crt}\n", f"OPENIT_AREA_KEY_{suffix}={key}\n",
                  f"OPENIT_AREA_HEALTH_{suffix}={pf_area_gateway.healthcheck_command(area, acme)}\n",
                  f"OPENIT_EGRESS_PROXY_{suffix}={egress.get(area, '')}\n"]
    # 왜 첫 이름: 레지스트리 인증서의 첫 이름이 영역 서비스가 부르는 이름이다(external 이면 설치처 주소의 호스트)
    registry = (env["OPENIT_REGISTRY_ADDRESS"].split("/")[0] if env["OPENIT_REGISTRY_MODE"] == "external" else env["OPENIT_REGISTRY_NAMES"].split(",")[0].strip())
    lines.append(f"OPENIT_REGISTRY_HOST={registry}\n")
    changed = write_if_changed(GENERATED / "areas.env", "# ./deploy 가 만든다. 영역 게이트웨이·서비스가 compose 에서 읽는 파생 값이다. 손으로 고치지 않는다.\n" + "".join(lines))
    if changed:
        PENDING_CHANGES.add("areas.env")


def compose_args(server: dlayout.Server | None = None, *, staged: bool = True) -> list[str]:
    """이 서버의 compose 프로젝트에 줄 인자. 서버 한 대(기본)면 제품 compose 그대로, 여럿이면 서버마다 덮개와 이름 표를 더한다(ADR 0026)."""
    server = server or active_server()
    layout = get_layout()
    env = env_values()
    is_platform = server is layout.platform
    args = ["compose", "--project-name", server_project(server), "--project-directory", str(DEPLOY), "-f", str(COMPOSE_FILE),
            "--env-file", str(DEPLOY / "env.example")]
    if env["OPENIT_REGISTRY_MODE"] == "local" and is_platform:
        args += ["--profile", "local-registry"]  # 왜: external 이면 레지스트리 서비스를 띄우지 않는다(ADR 0013). 레지스트리는 플랫폼 서버에 있다
    try:
        sync_generated()  # 왜 여기서: compose 는 생성된 파생 값(generated/platform.env)과 입구 에이전트 이름(compose.platform.yaml)을 읽는다
    except typer.Exit:
        if not LENIENT_GENERATION:
            raise
        typer.echo("경고: platform 설정을 새로 만들지 못해 이전에 만든 파일로 진행한다", err=True)
    sync_image_env(server)
    sync_area_env()
    args += ["-f", str(GENERATED / "compose.platform.yaml"), "--env-file", str(GENERATED / "platform.env"), "--env-file", str(images_env_file(server)),
             "--env-file", str(GENERATED / "areas.env")]
    if env["OPENIT_INFERENCE_ENGINE_LOCAL"] == "true" and "model-runtime" in server.services:
        args += ["--profile", "inference-engine"]  # 왜: 추론 엔진(vLLM)은 서빙 GPU 서버 배치다. 이 서버에서 안 띄우면 false(design.md 6절)
    if layout.multi:
        files = prepare_layout(server)
        args += ["--profile", "layout-edge", "-f", str(files["override"]), "--env-file", str(files["env"])]
        if staged and files["stage"].is_file():
            args += ["-f", str(files["stage"])]
    if (DEPLOY / ".env").exists():
        args += ["--env-file", str(DEPLOY / ".env")]  # 뒤의 파일이 앞을 덮는다(설치처 값)
    return args


def compose(args: list[str], server: dlayout.Server | None = None, **kwargs: object) -> subprocess.CompletedProcess[str]:
    """서버의 compose 프로젝트로 docker compose 를 부른다. 서버를 안 주면 지금 서버(없으면 플랫폼 서버)다."""
    server = server or active_server()
    with on_server(server):
        return docker([*compose_args(server), *args], **kwargs)


