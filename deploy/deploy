def step_cli(args: list[str], *, rw: dict[Path, str] | None = None, ro: dict[Path, str] | None = None) -> subprocess.CompletedProcess[str]:
    """step CLI 를 일회용 컨테이너에서 돌린다(네트워크 없음, 읽기 전용 루트, 호출자 uid). 인증서 만들기는 CA 도구가 맡는다."""
    command = ["run", "--rm", "--network", "none", "--read-only", "--tmpfs", "/tmp", "--cap-drop", "ALL",
               "--user", f"{os.getuid()}:{os.getgid()}", "-e", "HOME=/tmp", "-e", "STEPPATH=/tmp/.step", "--entrypoint", "step"]
    for host, inside in (rw or {}).items():
        command += ["-v", f"{host}:{inside}"]
    for host, inside in (ro or {}).items():
        command += ["-v", f"{host}:{inside}:ro"]
    return docker([*command, service_image(STEP_IMAGE_SERVICE), *args], capture_output=True)


def step_or_fail(what: str, result: subprocess.CompletedProcess[str]) -> None:
    if result.returncode != 0:
        fail(f"{what} 실패(rc={result.returncode}): {(result.stderr or result.stdout).strip()[-400:]}")


def read_password(name: str) -> bytes:
    return (SECRETS_DIR / name).read_text(encoding="utf-8").strip().encode()


def bounded_minutes(configured: int, root_cert: object) -> int:
    """중간 CA 수명(분). 설정 값이되 루트의 남은 수명을 넘지 않는다(RFC 5280 6.1.3: 하위는 상위보다 오래 살 수 없다)."""
    left = int(pki.remaining(root_cert).total_seconds() // 60) - 60  # type: ignore[arg-type]
    if left < 2 * ca_cfg().leaf_minutes:
        fail("루트 CA 의 남은 수명이 리프 수명의 두 배보다 짧아 중간 CA 를 만들 수 없다. 루트 교체가 먼저다(docs/CA.md 의 '루트 교체')")
    return min(configured, left)


def create_root(cfg: pki.CaSettings) -> None:
    result = step_cli(
        ["certificate", "create", f"{cfg.name} Root CA", "/pki/root_ca.crt", "/pki/root_ca.key", "--profile", "root-ca",
         "--not-after", pki.fmt_minutes(cfg.root_minutes), "--password-file", "/run/pw/root"],
        rw={PKI_DIR: "/pki"}, ro={SECRETS_DIR / "step_ca_root_password": "/run/pw/root"},
    )
    step_or_fail("루트 CA 생성", result)
    (PKI_DIR / "root_ca.key").chmod(0o600)


def create_intermediate(cfg: pki.CaSettings) -> None:
    """self 방식: 루트가 서명한 새 중간 CA 를 pending/ 에 만든다."""
    root = pki.load_cert(PKI_DIR / "root_ca.crt")
    private_dir(PENDING_DIR)
    for leftover in ("intermediate_ca.crt", "intermediate_ca.key"):
        (PENDING_DIR / leftover).unlink(missing_ok=True)
    result = step_cli(
        ["certificate", "create", f"{cfg.name} Intermediate CA", "/out/intermediate_ca.crt", "/out/intermediate_ca.key",
         "--profile", "intermediate-ca", "--ca", "/pki/root_ca.crt", "--ca-key", "/pki/root_ca.key", "--ca-password-file", "/run/pw/root",
         "--password-file", "/run/pw/ca", "--not-after", pki.fmt_minutes(bounded_minutes(cfg.intermediate_minutes, root))],
        rw={PENDING_DIR: "/out"},
        ro={PKI_DIR / "root_ca.crt": "/pki/root_ca.crt", PKI_DIR / "root_ca.key": "/pki/root_ca.key",
            SECRETS_DIR / "step_ca_root_password": "/run/pw/root", SECRETS_DIR / "step_ca_password": "/run/pw/ca"},
    )
    step_or_fail("중간 CA 생성", result)


def create_csr(cfg: pki.CaSettings) -> Path:
    """organization 방식: 중간 CA 키와 서명 요청(CSR)을 pending/ 에 만든다. 기관 CA 가 서명한다."""
    private_dir(PENDING_DIR)
    for leftover in ("intermediate.csr", "intermediate_ca.key", "intermediate_ca.crt"):
        (PENDING_DIR / leftover).unlink(missing_ok=True)
    result = step_cli(
        ["certificate", "create", f"{cfg.name} Intermediate CA", "/out/intermediate.csr", "/out/intermediate_ca.key", "--csr",
         "--password-file", "/run/pw/ca"],
        rw={PENDING_DIR: "/out"}, ro={SECRETS_DIR / "step_ca_password": "/run/pw/ca"},
    )
    step_or_fail("CSR 생성", result)
    return PENDING_DIR / "intermediate.csr"


def archive_current_ca() -> Path | None:
    files = [p for p in (CA_DIR / "intermediate_ca.crt", CA_DIR / "intermediate_ca.key", CA_DIR / "root_ca.crt") if p.is_file()]
    if not files:
        return None
    target = ARCHIVE_DIR / time.strftime("%Y%m%dT%H%M%S")
    private_dir(ARCHIVE_DIR)
    private_dir(target)
    for path in files:
        shutil.copy2(path, target / path.name)
    return target


def install_intermediate(cert_file: Path, key_file: Path, root_file: Path) -> None:
    """검증한 뒤 ca/ 에 설치한다. 검증: 사슬(각 인증서가 위의 것이 서명했고 CA 로 쓸 수 있다), 개인 키 일치, 유효 기간."""
    chain = pki.load_certs(cert_file)
    root = pki.load_cert(root_file)
    problems: list[str] = []
    for index, cert in enumerate(chain):
        issuer = chain[index + 1] if index + 1 < len(chain) else root
        problems += [f"{pki.subject_text(cert)}: {item}" for item in pki.check_intermediate(cert, issuer)]
    try:
        if not pki.key_matches_cert(key_file, read_password("step_ca_password"), chain[0]):
            problems.append("개인 키가 첫 인증서와 짝이 아니다")
    except (ValueError, TypeError) as error:
        problems.append(f"개인 키를 열지 못했다(암호가 다르거나 키가 아니다): {error}")
    if problems:
        fail("설치할 수 없다:\n  " + "\n  ".join(problems))
    archived = archive_current_ca()
    private_dir(CA_DIR)
    # 왜 파일을 덮어 쓴다(rename 아님): 컨테이너 마운트는 파일 단위라 새 inode 가 되면 보이지 않는다. 어차피 step-ca 는 다시 만든다
    (CA_DIR / "intermediate_ca.crt").write_text(pki.pem_text(chain), encoding="ascii")
    shutil.copyfile(key_file, CA_DIR / "intermediate_ca.key")
    (CA_DIR / "root_ca.crt").write_text(pki.pem_text([root]), encoding="ascii")
    # 왜 0644: 키는 암호로 잠겨 있고, 컨테이너 사용자가 읽으려면 읽기 가능해야 한다. 호스트 쪽 접근은 0700 폴더가 막는다(ADR 0008)
    for name in ("intermediate_ca.crt", "intermediate_ca.key", "root_ca.crt"):
        (CA_DIR / name).chmod(0o644)
    for leftover in PENDING_DIR.glob("*") if PENDING_DIR.is_dir() else []:
        leftover.unlink()
    typer.echo(f"설치함: 중간 CA {pki.subject_text(chain[0])}" + (f" (이전 파일 보관: {archived.relative_to(ROOT)})" if archived else ""))


def write_if_changed(path: Path, text: str, mode: int = 0o644) -> bool:
    if path.is_file() and path.read_text(encoding="utf-8") == text:
        return False
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text, encoding="utf-8")
    path.chmod(mode)
    return True


def write_bundle() -> bool:
    text = pki.build_bundle([CA_DIR / "root_ca.crt"], extra_trust_dir())
    return write_if_changed(bundle_path(), text)


def ensure_pki(cfg: pki.CaSettings) -> bool:
    """신뢰의 뿌리를 갖춘다. 이미 있는 것은 건드리지 않는다(멱등). step-ca 가 읽는 파일이 바뀌었으면 True."""
    secrets_init()
    private_dir(PKI_DIR)
    private_dir(CA_DIR)
    extra_trust_dir().mkdir(parents=True, exist_ok=True)
    changed = False
    if cfg.mode == "self":
        if (PKI_DIR / "root_ca.crt").is_file() != (PKI_DIR / "root_ca.key").is_file():
            fail("deploy/pki/ 에 루트 인증서와 키 중 하나만 있다. 직접 확인하고 보관본에서 복구한다(자동으로 덮어쓰지 않는다)")
        if not (PKI_DIR / "root_ca.crt").is_file():
            create_root(cfg)
            typer.echo("만듦: 루트 CA(개인 키는 deploy/pki/root_ca.key, 이 관리 노드에만 둔다)")
        if not (CA_DIR / "intermediate_ca.crt").is_file():
            create_intermediate(cfg)
            install_intermediate(PENDING_DIR / "intermediate_ca.crt", PENDING_DIR / "intermediate_ca.key", PKI_DIR / "root_ca.crt")
            changed = True
        else:
            typer.echo("있음: 중간 CA")
    elif not (CA_DIR / "intermediate_ca.crt").is_file():
        csr = PENDING_DIR / "intermediate.csr"
        if not csr.is_file():
            create_csr(cfg)
        fail(
            f"기관 CA 가 서명한 중간 CA 가 아직 없다. 서명 요청: {csr.relative_to(ROOT)}\n"
            "  기관 CA 에 이 요청을 서명받은 뒤(CA 인증서, pathlen 0 이상, 기간은 리프 수명 이상):\n"
            "  ./deploy ca install --cert <서명된 인증서(사슬 포함 가능)> --root <기관 루트 인증서>  그리고 ./deploy bootstrap 을 다시 실행한다"
        )
    changed |= write_if_changed(CA_DIR / "ca.json", pki.render_ca_json_text(cfg))
    changed |= write_bundle()
    sync_generated()
    return changed


# ---------------------------------------------------------------- 레지스트리(ADR 0013)


def published_endpoint(service: str, port: int) -> tuple[str, int] | None:
    layout = get_layout()
    if layout.multi and service in ("registry", "ingress-acme"):
        # 왜 서버 주소와 같은 포트: 여러 서버일 때 플랫폼 서버는 이 포트를 고정으로 게시한다(다른 서버가 이름으로 찾는다, ADR 0026)
        return (layout.platform.address, port) if is_running(service) else None
    result = compose(["port", service, str(port)], capture_output=True)
    text = result.stdout.strip()
    if result.returncode != 0 or ":" not in text:
        return None
    host, _, number = text.rpartition(":")
    return ("127.0.0.1" if host in ("", "0.0.0.0", "::", "[::]") else host.strip("[]")), int(number)


def engine_host() -> str:
    """docker 엔진이 있는 호스트. 원격 엔진(docker context, SSH)이면 게시된 포트는 그 호스트에 있다."""
    if get_layout().multi:
        return get_layout().platform.address  # 왜: 여러 서버면 레지스트리와 입구는 플랫폼 서버의 주소로 닿는다
    env = dockerenv.docker_env()
    endpoint = env.get("DOCKER_HOST", "")
    if endpoint.startswith(("ssh://", "tcp://")):
        return endpoint.split("://", 1)[1].rpartition("@")[2].split(":")[0]
    return "127.0.0.1"


class Registry:
    """이미지를 올리고 내려받을 레지스트리. local 은 compose 안쪽 이름(registry:443), external 은 설정의 주소."""

    def __init__(self, prefix: str, local: bool) -> None:
        self.prefix = prefix  # 이미지 이름 앞부분
        self.local = local


def registry_target(reg: pki.RegistrySettings) -> Registry:
    if reg.mode == "external":
        return Registry(reg.address, False)
    return Registry(f"{reg.names[0]}:443", True)


def crane(args: list[str], stage: Path | None = None) -> subprocess.CompletedProcess[str]:
    """레지스트리 클라이언트(crane, 일회용 컨테이너)를 compose 안쪽 네트워크에서 돌린다. 인증서는 신뢰 목록으로 검증한다.

    왜 데몬의 push 가 아닌가: 데몬이 게시된 포트에 닿는지는 설치 환경에 달렸다(Docker Desktop 에서는 닿지 않는 것을 확인했다). 안쪽 네트워크의 이름으로 접속하면
    어느 환경에서나 같고, 데몬에 루트 인증서를 설치(certs.d)하지 않아도 TLS 를 완전히 검증한다(ADR 0013).
    """
    if get_layout().multi:
        return crane_on_build_engine(args, stage)
    command = [*compose_args(), "--profile", "tools", "run", "--rm", "--no-deps", "-T", "--user", f"{os.getuid()}:{os.getgid()}"]
    if stage is not None:
        command += ["-v", f"{stage}:/w"]
    return docker([*command, "registry-client", *args], capture_output=True)


def crane_on_build_engine(args: list[str], stage: Path | None) -> subprocess.CompletedProcess[str]:
    """여러 서버일 때의 레지스트리 클라이언트: 레지스트리는 플랫폼 서버에 있어 compose 안쪽 네트워크로 닿지 못한다. 빌드 엔진의 일회용 컨테이너가 레지스트리 이름을
    플랫폼 서버 주소로 풀어(--add-host) 접속한다. 인증서는 같은 신뢰 목록으로 검증한다(검증을 끄지 않는다)."""
    layout = get_layout()
    reg = reg_cfg()
    image = yaml.safe_load(COMPOSE_FILE.read_text(encoding="utf-8"))["services"]["registry-client"]["image"]
    command = ["run", "--rm", "--read-only", "--cap-drop", "ALL", "--security-opt", "no-new-privileges:true", "--user", f"{os.getuid()}:{os.getgid()}",
               "-e", "SSL_CERT_FILE=/etc/openit/trust-bundle.pem", "-v", f"{bundle_path()}:/etc/openit/trust-bundle.pem:ro",
               "--add-host", f"{reg.names[0]}:{dlayout.resolve_ip(layout.platform.address)}"]
    if stage is not None:
        command += ["-v", f"{stage}:/w"]
    return docker([*command, image, *args], capture_output=True)


def registry_has(target: Registry, repo: str, digest: str) -> bool:
    """레지스트리에 그 digest 의 매니페스트가 있는가. 확인하지 못하면 False(올리기는 멱등이다)."""
    reference = f"{target.prefix}/{repo}@{digest}"
    if target.local:
        return crane(["manifest", reference]).returncode == 0
    return docker(["buildx", "imagetools", "inspect", reference], capture_output=True).returncode == 0


def verify_registry_tls(reg: pki.RegistrySettings) -> None:
    """레지스트리의 인증서를 신뢰 목록으로 검증하고(예외 없이) 유효 기간을 보인다."""
    endpoint = published_endpoint("registry", 443)
    if endpoint is None:
        fail("레지스트리가 떠 있지 않다(./deploy bootstrap)")
    try:
        leaf = pki.fetch_leaf(engine_host(), endpoint[1], reg.names[0], bundle_path())
    except (OSError, ssl.SSLError) as error:
        fail(f"레지스트리 TLS 검증 실패(신뢰 목록으로 이름 '{reg.names[0]}' 을 검증): {error}")
    typer.echo(f"레지스트리 TLS 검증 통과: {reg.names[0]} 남은 {pki.remaining(leaf).total_seconds() / 3600:.1f}시간")


def local_image(name: str) -> str:
    return f"openit/{name.lstrip('_')}"


def push_images(reg: pki.RegistrySettings) -> None:
    targets = area_targets()
    if not targets:
        typer.echo("올릴 이미지 없음(services/·jobs/·web/ 에 Dockerfile 이 있는 영역이 없다)")
        return
    target = registry_target(reg)
    lock = read_lock()
    for name in targets:
        repo = local_image(name)
        if name in lock and registry_has(target, repo, lock[name]):
            typer.echo(f"레지스트리에 있음: {name} {lock[name]}")
            continue
        if docker(["image", "inspect", f"{repo}:local"], capture_output=True).returncode != 0:
            build(name, False)  # 왜 여기서 빌드: 로컬에 이미지가 없으면 올릴 것이 없다. 빌드는 lock 도 갱신한다
        remote = f"{target.prefix}/{repo}:local"
        if target.local:
            stage = META_DIR / "push"
            stage.mkdir(parents=True, exist_ok=True)
            archive = stage / f"{name}.tar"
            if (saved := docker(["save", f"{repo}:local", "-o", str(archive)], capture_output=True)).returncode != 0:
                fail(f"{name} 저장 실패: {saved.stderr.strip()[-300:]}")
            pushed = crane(["push", f"/w/{archive.name}", remote], stage)
            archive.unlink(missing_ok=True)
        else:
            if (tag := docker(["tag", f"{repo}:local", remote], capture_output=True)).returncode != 0:
                fail(f"{name} 태그 실패: {tag.stderr.strip()[-300:]}")
            pushed = docker(["push", remote], capture_output=True)
        if pushed.returncode != 0:
            fail(f"{name} push 실패(rc={pushed.returncode}): {(pushed.stderr or pushed.stdout).strip()[-400:]}")
        found = re.search(r"(sha256:[0-9a-f]{64})", pushed.stdout if target.local else pushed.stdout + pushed.stderr)
        if not found:
            fail(f"{name}: push 결과에서 digest 를 찾지 못했다")
        lock = read_lock()
        lock[name] = found.group(1)  # 왜 push 가 준 digest: 내려받을 때 쓰는 값은 레지스트리의 매니페스트 digest 다
        write_lock(lock)
        typer.echo(f"올림: {name} {found.group(1)}")


@app.command()
def pull(service: Annotated[str | None, typer.Argument(help="내려받을 대상(없으면 lock 의 전부)")] = None) -> None:
    """images.lock 의 digest 로 레지스트리에서 이미지를 내려받는다(태그가 아니라 digest 로). local 은 안쪽 네트워크에서 받아 docker load 한다."""
    reg = reg_cfg()
    target = registry_target(reg)
    lock = read_lock()
    names = [service] if service else list(lock)
    if not names:
        no_target("images.lock 이 비어 있다")
    stage = META_DIR / "pull"
    stage.mkdir(parents=True, exist_ok=True)
    for name in names:
        if name not in lock:
            fail(f"images.lock 에 '{name}' 이 없다", 2)
        reference = f"{target.prefix}/{local_image(name)}@{lock[name]}"
        loaded = reference
        if target.local:
            archive = stage / f"{name}.tar"
            result = crane(["pull", reference, f"/w/{archive.name}"], stage)
            if result.returncode == 0:
                result = docker(["load", "--input", str(archive)], capture_output=True)
                found = re.search(r"Loaded image: (\S+)", result.stdout)
                loaded = found.group(1) if found else ""
            archive.unlink(missing_ok=True)
        else:
            result = docker(["pull", "--quiet", reference], capture_output=True)
        if result.returncode == 0:
            # 왜 이름을 붙인다: compose 는 이 엔진의 `openit/<대상>:local` 이미지를 digest 로 고정해 띄운다(sync_image_env)
            if not loaded or docker(["tag", loaded, f"{local_image(name)}:local"], capture_output=True).returncode != 0:
                fail(f"{name}: 내려받은 이미지에 이름을 붙이지 못했다")
        if result.returncode != 0:
            fail(f"{name} pull 실패(rc={result.returncode}): {(result.stderr or result.stdout).strip()[-400:]}")
        typer.echo(f"받음: {reference}")


@app.command()
def bootstrap() -> None:
    """관리 노드에서 처음부터 설치한다: 신뢰의 뿌리 -> 레지스트리 -> 이미지 push·digest 기록 -> 서비스 기동. 이미 된 단계는 건너뛴다(멱등)."""
    cfg, reg = ca_cfg(), reg_cfg()
    typer.echo("[1/4] 신뢰의 뿌리")
    changed = ensure_pki(cfg)
    typer.echo(f"      CA 방식 {cfg.mode}, 신뢰 목록 {bundle_path()}")
    typer.echo("[2/4] 레지스트리")
    if reg.mode == "external":
        typer.echo(f"      외부 레지스트리 {reg.address} 를 쓴다(레지스트리 단계를 건너뛴다)")
    else:
        if get_layout().multi:
            stage_server(get_layout().platform)  # 왜 먼저: 플랫폼 서버의 엔진이 읽는 파일(CA 설정, 신뢰 목록)을 올려야 step-ca 가 뜬다
        running = compose(["ps", "--quiet", "step-ca"], capture_output=True).stdout.strip()
        if changed and running:
            # 왜 다시 만든다: step-ca 가 읽는 파일이 바뀌었다(중간 CA 교체, 설정 변경). 컨테이너는 시작할 때 읽는다
            if compose(["up", "-d", "--wait", "--force-recreate", "--no-deps", "step-ca"]).returncode != 0:
                fail("step-ca 를 다시 만들지 못했다. ./deploy status 와 로그를 본다")
        if compose(["up", "-d", "--wait", "step-ca", "registry-store", "registry"]).returncode != 0:
            fail("레지스트리를 띄우지 못했다. 진단을 위해 컨테이너와 로그를 남겨 두었다: ./deploy status")
        verify_registry_tls(reg)
    typer.echo("[3/4] 이미지 올리기와 digest 기록")
    push_images(reg)
    typer.echo("[4/4] 서비스 기동")
    up()
    typer.echo("인증서 상태")
    ca_status()
    typer.echo("bootstrap 완료")


# ---------------------------------------------------------------- ca 하위 명령


@ca_app.command("status")
def ca_status() -> None:
    """루트·중간·리프 인증서의 만료까지 남은 기간을 보인다. 기준 미만이거나 검증이 실패하면 rc=1."""
    cfg, reg = ca_cfg(), reg_cfg()
    if not (CA_DIR / "intermediate_ca.crt").is_file():
        no_target("deploy/pki/ca/ 가 없다(./deploy bootstrap)")
    problems = 0

    def line(label: str, cert: object, warn_minutes: int, extra: str = "") -> None:
        nonlocal problems
        left = pki.remaining(cert)  # type: ignore[arg-type]
        hours = left.total_seconds() / 3600
        ok = hours * 60 >= warn_minutes
        problems += not ok
        shown = f"{left.days}일" if hours >= 48 else f"{hours:.1f}시간"
        typer.echo(f"[{'OK' if ok else 'FAIL'}] {label}: 남은 {shown} (기준 {pki.fmt_minutes(warn_minutes)}) {extra}".rstrip())

    root = pki.load_cert(CA_DIR / "root_ca.crt")
    chain = pki.load_certs(CA_DIR / "intermediate_ca.crt")
    line(f"루트 CA {pki.subject_text(root)}", root, cfg.warn_root_minutes)
    line(f"중간 CA {pki.subject_text(chain[0])}", chain[0], cfg.warn_intermediate_minutes)
    issues = pki.check_intermediate(chain[0], chain[1] if len(chain) > 1 else root)
    try:
        if not pki.key_matches_cert(CA_DIR / "intermediate_ca.key", read_password("step_ca_password"), chain[0]):
            issues.append("중간 CA 개인 키가 인증서와 짝이 아니다")
    except (ValueError, TypeError, OSError) as error:
        issues.append(f"중간 CA 개인 키를 열지 못했다: {error}")
    if (CA_DIR / "ca.json").read_text(encoding="utf-8") != pki.render_ca_json_text(cfg):
        issues.append("ca.json 이 설정과 다르다(./deploy bootstrap 으로 맞춘다)")
    bundle = bundle_path()
    if not bundle.is_file() or pki.build_bundle([CA_DIR / "root_ca.crt"], extra_trust_dir()) != bundle.read_text(encoding="utf-8"):
        issues.append("신뢰 목록이 현재 루트와 다르다(./deploy ca bundle)")
    for issue in issues:
        typer.echo(f"[FAIL] {issue}")
    problems += len(issues)
    if not issues:
        typer.echo("[OK] 사슬: 루트 -> 중간 CA 서명·CA 확장·키 짝·ca.json·신뢰 목록이 맞다")
    for extra in sorted(p for p in extra_trust_dir().glob("*") if p.suffix in {".crt", ".pem"}) if extra_trust_dir().is_dir() else []:
        for cert in pki.load_certs(extra):
            line(f"추가 신뢰 루트 {extra.name} {pki.subject_text(cert)}", cert, cfg.warn_root_minutes)
    kiosk = env_values()["OPENIT_DEVICE_CA_CERTIFICATE_FILE"]
    if kiosk:
        kiosk_path = pki.resolve_path(DEPLOY, kiosk)
        if not kiosk_path.is_file():
            typer.echo(f"[FAIL] OPENIT_DEVICE_CA_CERTIFICATE_FILE 파일이 없다: {kiosk_path}")
            problems += 1
        else:
            for cert in pki.load_certs(kiosk_path):
                line(f"키오스크 클라이언트 CA {pki.subject_text(cert)}", cert, cfg.warn_root_minutes)
    ingress = platform_generated().settings
    ingress_endpoint = published_endpoint("ingress-acme", ingress.listen_port)
    if ingress_endpoint is None:
        typer.echo("[FAIL] 입구 인증서: 입구가 떠 있지 않아 읽지 못했다")
        problems += 1
    else:
        try:
            ingress_leaf = pki.fetch_leaf(engine_host(), ingress_endpoint[1], ingress.public_host, bundle)
        except (OSError, ssl.SSLError) as error:
            typer.echo(f"[FAIL] 입구 인증서: 신뢰 목록으로 검증하지 못했다: {error}")
            problems += 1
        else:
            warn = ORGANIZATION_CERT_WARN_MINUTES if ingress.ingress_mode == "organization" else cfg.warn_leaf_minutes
            line(f"입구 인증서 {ingress.public_host}({ingress.ingress_mode})", ingress_leaf, warn,
                 f"serial={format(ingress_leaf.serial_number, 'x')[:12]} 발급={ingress_leaf.not_valid_before_utc:%Y-%m-%dT%H:%M:%SZ}")
    if reg.mode == "local":
        endpoint = published_endpoint("registry", 443)
        if endpoint is None:
            typer.echo("[FAIL] 레지스트리 리프: 레지스트리가 떠 있지 않아 읽지 못했다")
            problems += 1
        else:
            try:
                leaf = pki.fetch_leaf(engine_host(), endpoint[1], reg.names[0], bundle)
            except (OSError, ssl.SSLError) as error:
                typer.echo(f"[FAIL] 레지스트리 리프: 신뢰 목록으로 검증하지 못했다: {error}")
                problems += 1
            else:
                line(f"리프 {reg.names[0]}", leaf, cfg.warn_leaf_minutes,
                     f"serial={format(leaf.serial_number, 'x')[:12]} 발급={leaf.not_valid_before_utc:%Y-%m-%dT%H:%M:%SZ}")
    else:
        typer.echo(f"[--] 리프: 외부 레지스트리 {reg.address} 의 인증서는 그 운영처가 관리한다")
    if problems:
        fail(f"인증서 점검 실패 {problems}건", EXIT_FAIL)
    typer.echo("인증서 점검 통과")


@ca_app.command("bundle")
def ca_bundle() -> None:
    """신뢰 목록을 다시 만든다(이 설치의 루트 + OPENIT_TRUST_EXTRA_DIR 의 루트). 바뀌었으면 쓰는 서비스를 다시 만들라고 알린다."""
    ca_cfg()
    if not (CA_DIR / "root_ca.crt").is_file():
        no_target("deploy/pki/ca/root_ca.crt 가 없다(./deploy bootstrap)")
    if write_bundle():
        typer.echo(f"신뢰 목록 갱신: {bundle_path()}\n서비스가 새 목록을 읽게 하려면 ./deploy up 후 해당 서비스를 다시 만든다(docker compose up -d --force-recreate)")
    else:
        typer.echo(f"신뢰 목록 그대로: {bundle_path()}")


@ca_app.command("csr")
def ca_csr() -> None:
    """organization 방식: 중간 CA 서명 요청(CSR)을 만든다. 처음 설치와 교체 모두 이 요청을 기관 CA 에 낸다."""
    cfg = ca_cfg()
    if cfg.mode != "organization":
        fail("csr 은 OPENIT_CA_MODE=organization 에서만 쓴다(self 는 ./deploy ca rotate 가 알아서 서명한다)", 2)
    private_dir(PKI_DIR)
    typer.echo(f"서명 요청: {create_csr(cfg).relative_to(ROOT)}\n기관 CA 가 서명하면 ./deploy ca install --cert <서명된 인증서> --root <기관 루트 인증서>")


@ca_app.command("install")
def ca_install(
    cert: Annotated[Path, typer.Option(help="서명된 중간 CA 인증서(PEM, 위쪽 중간 CA 가 더 있으면 이어 붙인 사슬)")],
    root: Annotated[Path, typer.Option(help="그 사슬의 루트 인증서(PEM)")],
) -> None:
    """organization 방식: 기관 CA 가 서명한 중간 CA 를 검증하고 설치한다. step-ca 는 다시 만든다."""
    cfg = ca_cfg()
    if cfg.mode != "organization":
        fail("install 은 OPENIT_CA_MODE=organization 에서만 쓴다", 2)
    if not (PENDING_DIR / "intermediate_ca.key").is_file():
        fail("pending/ 에 중간 CA 키가 없다. 먼저 ./deploy ca csr 로 요청을 만들고 그 요청을 서명받아 온다")
    install_intermediate(cert, PENDING_DIR / "intermediate_ca.key", root)
    finish_ca_change(cfg)


def finish_ca_change(cfg: pki.CaSettings) -> None:
    """설치 뒤 ca.json·신뢰 목록을 맞추고, 떠 있는 step-ca 를 다시 만든다."""
    write_if_changed(CA_DIR / "ca.json", pki.render_ca_json_text(cfg))
    write_bundle()
    sync_generated()
    if compose(["ps", "--quiet", "step-ca"], capture_output=True).stdout.strip():
        if compose(["up", "-d", "--wait", "--force-recreate", "--no-deps", "step-ca"]).returncode != 0:
            fail("step-ca 를 다시 만들지 못했다. ./deploy status 와 로그를 본다")
        typer.echo("step-ca 를 새 중간 CA 로 다시 만들었다. 이미 나간 리프는 만료까지(또는 자동 갱신 때까지) 이전 중간 CA 사슬로 유효하다")
    else:
        typer.echo("step-ca 가 떠 있지 않다. ./deploy bootstrap 으로 띄우면 새 중간 CA 를 쓴다")


@ca_app.command("rotate")
def ca_rotate() -> None:
    """중간 CA 를 교체한다. self: 루트로 새 중간 CA 를 만들어 검증·설치·step-ca 재생성. organization: 새 키와 CSR 을 만든다(이어서 ca install)."""
    cfg = ca_cfg()
    if not (CA_DIR / "intermediate_ca.crt").is_file():
        no_target("교체할 중간 CA 가 없다(./deploy bootstrap)")
    if cfg.mode == "organization":
        typer.echo(f"서명 요청: {create_csr(cfg).relative_to(ROOT)}\n기관 CA 가 서명하면 ./deploy ca install --cert <서명된 인증서> --root <기관 루트 인증서>")
        return
    create_intermediate(cfg)
    install_intermediate(PENDING_DIR / "intermediate_ca.crt", PENDING_DIR / "intermediate_ca.key", PKI_DIR / "root_ca.crt")
    finish_ca_change(cfg)
    ca_status()


def trust_users_running() -> list[str]:
    return [service for service in TRUST_LIST_USERS if is_running(service)]


def refresh_trust_users() -> None:
    """신뢰 목록을 시작할 때 읽는 서비스 중 돌고 있는 것을 다시 만든다."""
    running = trust_users_running()
    if running:
        typer.echo(f"새 신뢰 목록을 읽게 다시 만든다: {', '.join(running)}")
        recreate(running)


def old_root_files() -> list[Path]:
    return sorted(extra_trust_dir().glob("old-root-*.crt")) if extra_trust_dir().is_dir() else []


@ca_app.command("rotate-root")
def ca_rotate_root(
    finish: Annotated[bool, typer.Option("--finish", help="2단계: 이전 루트를 신뢰 목록에서 뺀다(새 루트를 모든 기기에 배포한 뒤)")] = False,
    distributed: Annotated[bool, typer.Option("--distributed", help="--finish 와 함께: 새 루트를 키오스크·직원 PC 에 배포했음을 확인했다")] = False,
) -> None:
    """루트 CA 를 교체한다(2단계, 절차는 docs/CA.md). 1단계(기본): 새 루트·중간 CA 를 만들고 신뢰 목록에 새 루트와 이전 루트를 함께 둔다. 2단계(--finish): 이전 루트를 뺀다."""
    cfg = ca_cfg()
    if not (CA_DIR / "root_ca.crt").is_file():
        no_target("deploy/pki/ca/root_ca.crt 가 없다(./deploy bootstrap)")
    if finish:
        return finish_root_rotation(distributed)
    if old_root_files():
        fail("이전 루트가 아직 신뢰 목록에 있다(이전 교체가 끝나지 않았다). 먼저 ./deploy ca rotate-root --finish --distributed")
    old = pki.load_cert(CA_DIR / "root_ca.crt")
    fingerprint = old.fingerprint(pki.hashes.SHA256()).hex()[:8]
    # 왜 먼저 이전 루트를 신뢰 목록 폴더에 둔다: 새 루트로 바꾸는 순간부터 이전 루트가 서명한 리프(기기·서비스)가 아직 쓰이므로 둘 다 믿어야 한다(ADR 0015)
    extra_trust_dir().mkdir(parents=True, exist_ok=True)
    write_if_changed(extra_trust_dir() / f"old-root-{fingerprint}.crt", pki.pem_text([old]))
    if cfg.mode == "organization":
        # 새 루트는 조직이 정한다. 새 중간 CA 서명 요청을 만들고, 서명된 사슬과 새 루트를 ca install 로 설치하면 신뢰 목록이 새 루트와 이전 루트를 함께 담는다
        typer.echo(f"이전 루트를 신뢰 목록 폴더에 두었다: old-root-{fingerprint}.crt")
        typer.echo(f"서명 요청: {create_csr(cfg).relative_to(ROOT)}\n조직이 새 루트로 서명하면 ./deploy ca install --cert <서명된 인증서> --root <새 루트 인증서>")
        typer.echo("새 루트를 키오스크와 직원 PC 에 배포한 뒤 ./deploy ca rotate-root --finish --distributed")
        return
    # self: 새 루트를 임시 폴더에 만들고(실패해도 현재 루트가 그대로다) 보관·교체·새 중간 CA 설치 순서로 간다
    staging = PKI_DIR / "pending-root"
    shutil.rmtree(staging, ignore_errors=True)
    private_dir(staging)
    result = step_cli(
        ["certificate", "create", f"{cfg.name} Root CA", "/pki/root_ca.crt", "/pki/root_ca.key", "--profile", "root-ca",
         "--not-after", pki.fmt_minutes(cfg.root_minutes), "--password-file", "/run/pw/root"],
        rw={staging: "/pki"}, ro={SECRETS_DIR / "step_ca_root_password": "/run/pw/root"},
    )
    step_or_fail("새 루트 CA 생성", result)
    archive = ARCHIVE_DIR / f"{time.strftime('%Y%m%dT%H%M%S')}-old-root"
    private_dir(ARCHIVE_DIR)
    private_dir(archive)
    for name in ("root_ca.crt", "root_ca.key"):
        shutil.move(PKI_DIR / name, archive / name)
        shutil.move(staging / name, PKI_DIR / name)
    (PKI_DIR / "root_ca.key").chmod(0o600)
    shutil.rmtree(staging, ignore_errors=True)
    typer.echo(f"이전 루트 파일 보관: {archive.relative_to(ROOT)}, 신뢰 목록 폴더에 old-root-{fingerprint}.crt")
    create_intermediate(cfg)
    install_intermediate(PENDING_DIR / "intermediate_ca.crt", PENDING_DIR / "intermediate_ca.key", PKI_DIR / "root_ca.crt")
    finish_ca_change(cfg)
    refresh_trust_users()
    new = pki.load_cert(PKI_DIR / "root_ca.crt")
    typer.echo(f"새 루트: {pki.subject_text(new)} sha256={new.fingerprint(pki.hashes.SHA256()).hex()}\n"
               f"배포할 파일: {(PKI_DIR / 'root_ca.crt').relative_to(ROOT)} (키오스크와 직원 PC, docs/CA.md '루트를 키오스크와 직원 PC에 배포')\n"
               "리프 수명이 지나 이전 루트가 서명한 인증서가 모두 갱신되고 새 루트가 모든 기기에 배포된 뒤: ./deploy ca rotate-root --finish --distributed")
    ca_status()


def finish_root_rotation(distributed: bool) -> None:
    """2단계: 이전 루트를 신뢰 목록에서 뺀다. 지금 나가 있는 서버 인증서가 새 루트만으로 검증되는지 확인하고, 배포 확인(--distributed)이 있어야 한다."""
    olds = old_root_files()
    if not olds:
        no_target("신뢰 목록 폴더에 이전 루트(old-root-*.crt)가 없다(교체 1단계를 하지 않았거나 이미 끝났다)")
    if not distributed:
        fail("새 루트를 키오스크와 직원 PC 에 배포했는지 이 명령이 확인할 수 없다. 배포했다면 --distributed 를 함께 준다", 2)
    # 왜 새 루트만으로 검증: 이전 루트가 서명한 리프가 남아 있으면 이전 루트를 빼는 순간 그 서비스의 TLS 가 깨진다
    only_new = META_DIR / "trust-new-root-only.pem"
    META_DIR.mkdir(exist_ok=True)
    only_new.write_text(pki.pem_text([pki.load_cert(CA_DIR / "root_ca.crt")]), encoding="ascii")
    served = platform_generated().settings
    probes: list[tuple[str, tuple[str, int] | None, str]] = [("입구", published_endpoint("ingress-acme", served.listen_port), served.public_host)]
    if reg_cfg().mode == "local":
        probes.append(("레지스트리", published_endpoint("registry", 443), reg_cfg().names[0]))
    stale = []
    for label, endpoint, name in probes:
        if endpoint is None:
            continue  # 떠 있지 않으면 내놓는 인증서가 없다
        try:
            pki.fetch_leaf(engine_host(), endpoint[1], name, only_new)
        except (OSError, ssl.SSLError) as error:
            stale.append(f"{label}({name}): {error}")
    only_new.unlink(missing_ok=True)
    if stale:
        fail("이전 루트가 서명한 인증서가 아직 나가 있어 이전 루트를 뺄 수 없다(리프가 갱신될 때까지 기다린다):\n  " + "\n  ".join(stale))
    for path in olds:
        path.unlink()
    write_bundle()
    sync_generated()
    refresh_trust_users()
    typer.echo(f"이전 루트를 신뢰 목록에서 뺐다: {', '.join(p.name for p in olds)}")
    ca_status()


@identity_app.command("sync")
def identity_sync() -> None:
    """생성한 realm 파일의 클라이언트와 역할을 이미 있는 realm 에 반영한다.

    왜 필요한가: Keycloak 의 --import-realm 은 이미 있는 realm 을 건너뛴다. 기계 호출자나 노출 선언이 바뀌면 realm 파일이 달라지는데 처음 설치 뒤에는 반영되지 않는다.
    방법: Keycloak 의 표준 관리 API partialImport(ifResourceExists=OVERWRITE)와 서비스 계정 역할 부여를 kcadm 으로 한다. 사람 계정은 건드리지 않는다.
    비밀(클라이언트 비밀)은 표준 입력으로만 넘기고 출력하지 않는다.
    """
    if not is_running("keycloak"):
        no_target("keycloak 이 떠 있지 않다(./deploy up)")
    realm = json.loads((GENERATED / "identity" / "openit-realm.json").read_text(encoding="utf-8"))
    values = {"OAUTH2_PROXY_CLIENT_SECRET": read_password("oauth2_proxy_client_secret").decode(), "OPENIT_REALM_ADMIN_PASSWORD": read_password("keycloak_admin_password").decode()}
    if MACHINE_SECRETS_DIR.is_dir():
        values |= {pf_identity.machine_env_name(p.name): p.read_text(encoding="utf-8").strip() for p in MACHINE_SECRETS_DIR.iterdir() if p.is_file()}
    body = json.dumps({"ifResourceExists": "OVERWRITE", "clients": realm["clients"]})
    # 왜 역할은 SKIP: 역할을 덮어쓰면 지워졌다 다시 만들어져 사람 계정에 준 역할 부여가 사라진다(시험에서 확인). 역할 이름은 계약이 정하므로 없는 것만 만든다
    roles_body = json.dumps({"ifResourceExists": "SKIP", "roles": realm["roles"]})
    for name, value in values.items():
        body = body.replace("${" + name + "}", value)
    unresolved = re.findall(r"\$\{[A-Z0-9_]+\}", body)
    if unresolved:
        fail(f"realm 파일의 자리표시자에 해당하는 비밀 파일이 없다: {', '.join(sorted(set(unresolved)))} (./deploy secrets init)")
    # 왜 범위 매핑: 클라이언트의 토큰에 싣는 역할을 계약의 역할로 제한한다(fullScopeAllowed 거짓). partialImport 가 갱신하지 않아 따로 부여한다(이미 있으면 그대로다).
    # 왜 service-account-user 조회: 덮어쓴 클라이언트의 서비스 계정은 이 조회로 만들어진다(Keycloak 이 필요할 때 만든다)
    calls = []
    for item in realm["scopeMappings"]:
        calls.append(f"mapping {item['client']} {' '.join(item['roles'])}")
    for user in realm["users"]:
        if "serviceAccountClientId" in user:
            calls.append(f"account {user['serviceAccountClientId']} {' '.join(user['realmRoles'])}")
    script = """set -e
kc() { /opt/keycloak/bin/kcadm.sh "$@" --config /tmp/kcadm.config; }
client_id() { kc get clients -r openit -q clientId="$1" --fields id --format csv --noquotes; }
mapping() {
  client="$1"; shift; cid="$(client_id "$client")"; body='['
  for role in "$@"; do rid="$(kc get "roles/$role" -r openit --fields id --format csv --noquotes)"; body="$body{\\"id\\":\\"$rid\\",\\"name\\":\\"$role\\"},"; done
  echo "${body%,}]" | kc create "clients/$cid/scope-mappings/realm" -r openit -f - >/dev/null
}
account() {
  client="$1"; shift; cid="$(client_id "$client")"; kc get "clients/$cid/service-account-user" -r openit >/dev/null
  args=""; for role in "$@"; do args="$args --rolename $role"; done
  kc add-roles -r openit --uusername "service-account-$client" $args
}
kc config credentials --server http://localhost:8080 --realm master --user admin --password "$(cat /run/secrets/keycloak_admin_password)" >/dev/null
kc create partialImport -r openit -f - >/dev/null
kc create partialImport -r openit -f - >/dev/null <<'ROLES'
""" + roles_body + "\nROLES\n" + "\n".join(calls) + "\n"
    result = compose(["exec", "-T", "keycloak", "bash", "-c", script], input=body, capture_output=True)
    if result.returncode != 0:
        fail(f"identity sync 실패(rc={result.returncode}): {(result.stderr or result.stdout).strip()[-400:]}")
    typer.echo(f"반영함: 클라이언트 {len(realm['clients'])}개, 역할 {len(realm['roles']['realm'])}개")


class E2EMode(str, Enum):
    pipeline = "pipeline"  # D81 의 gpu-12g(기반 Qwen3-1.7B)와 중립 어댑터: 게시·활성화·적재·추론 경로가 계약대로 도는지
    product = "product"  # 학습된 어댑터(--adapters-a/-b)와 --profile: 더해 대본의 기대 값이 결과에 저장되는지


# 왜 이 목록만: E2E 도구에 상속받은 환경 변수를 통째로 넘기지 않는다(RUNTIME R9.1). docker 설정·엔진 선택과 uv 캐시, 실행에 필요한 PATH 와 HOME 뿐이다
E2E_ENV_KEYS = ("PATH", "HOME", "LANG", "LC_ALL", "DOCKER_HOST", "DOCKER_CONTEXT", "DOCKER_CONFIG", "UV_CACHE_DIR", "XDG_CACHE_HOME")


@app.command()
def e2e(
    mode: Annotated[E2EMode, typer.Option("--mode", help="pipeline(gpu-12g, 중립 어댑터) 또는 product(학습된 어댑터)")],
    adapters_a: Annotated[Path | None, typer.Option("--adapters-a", help="product: LoRA-A 어댑터 폴더(PEFT 어댑터와 system_prompt.txt)")] = None,
    adapters_b: Annotated[Path | None, typer.Option("--adapters-b", help="product: LoRA-B 어댑터 폴더")] = None,
    profile: Annotated[str | None, typer.Option("--profile", help="product: 모델 프로파일(예: rtx4090-24g)")] = None,
    note: Annotated[str, typer.Option("--note", help="기록에 남길 한 줄 비고")] = "",
) -> None:
    """전체 시험 1회(샌드박스, 제품 구성은 건드리지 않는다). 결과는 deploy/docs/E2E_RESULTS.md 에 남는다(ADR 0025).

    임시 폴더에 설치를 하나 더 만들어(compose 프로젝트 openit-e2e-<무작위>) 그 안에서 한 건의 문진을 입구를 지나는 실제 HTTP 로 끝까지 시험하고 이 프로젝트만 down -v 한다.
    영역 이미지는 이 엔진에 빌드되어 있어야 한다(./deploy build). 종료 코드는 0 통과, 1 실패.
    """
    if not (DEPLOY / "e2e" / "pyproject.toml").is_file():
        no_target("deploy/e2e/ 가 없다(E2E 실행 도구)")
    command = ["uv", "run", "--project", str(DEPLOY / "e2e"), "openit-e2e", "--mode", mode.value]
    for flag, value in (("--adapters-a", adapters_a), ("--adapters-b", adapters_b)):
        if value is not None:
            command += [flag, str(value.resolve())]
    if profile:
        command += ["--profile", profile]
    if note:
        command += ["--note", note]
    try:
        # 왜 docker_env 의 값을 더한다: 엔진 선택(DOCKER_CONTEXT 가 DOCKER_HOST 보다 우선)을 이 명령이 한 번 해석해 넘긴다(dockerenv 의 규칙)
        env = {key: os.environ[key] for key in E2E_ENV_KEYS if key in os.environ} | {key: value for key, value in dockerenv.docker_env().items() if key.startswith("DOCKER_")}
    except dockerenv.DockerEnvError as error:
        fail(f"docker 환경을 정하지 못했다: {error}")
    env["PYTHONUNBUFFERED"] = "1"  # 왜: 진행 줄이 파이프·파일로 나가도 바로 보인다(몇 분에서 몇십 분 걸리는 명령이다)
    result = subprocess.run(command, cwd=ROOT, env=env, check=False)  # noqa: S603
    if result.returncode != 0:
        raise typer.Exit(result.returncode)


if __name__ == "__main__":
    app()
