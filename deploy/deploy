@functools.cache
def get_layout() -> dlayout.Layout:
    """배치 설정(계약 DeploymentLayout). 기본 이름의 파일이 없으면 서버 한 대 배치(지금 동작), 다른 이름을 줬는데 없으면 멈춘다."""
    value = env_values()["OPENIT_LAYOUT_FILE"]
    path = pki.resolve_path(DEPLOY, value)
    try:
        if not path.is_file() and value == LAYOUT_DEFAULT:
            return dlayout.load_layout(None)
        return dlayout.load_layout(path)
    except dlayout.LayoutError as error:
        fail("배치 설정이 틀렸다:\n  " + "\n  ".join(error.problems))


