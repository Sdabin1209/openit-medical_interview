@ca_app.command("install")
def ca_install(
    cert: Annotated[Path, typer.Option(help="서명된 중간 CA 인증서(PEM, 위쪽 중간 CA 가 더 있으면 이어 붙인 사슬)")],
    root: Annotated[Path, typer.Option(help="그 사슬의 루트 인증서(PEM)")],
) -> None:
    """organization 방식: 기관 CA 가 서명한 중간 CA 를 검증하고 설치한다. step-ca 는 다시 만든다."""
    cfg = ca_cfg()
    if cfg.mode != "organization":
        fail("install 은 OPENIT_CA_MODE=organization 에서만 쓴다", 2)
    if not (PENDING_DIR / "intermediate_ca.key").is_file():
        fail("pending/ 에 중간 CA 키가 없다. 먼저 ./deploy ca csr 로 요청을 만들고 그 요청을 서명받아 온다")
    install_intermediate(cert, PENDING_DIR / "intermediate_ca.key", root)
    finish_ca_change(cfg)


def finish_ca_change(cfg: pki.CaSettings) -> None:
    """설치 뒤 ca.json·신뢰 목록을 맞추고, 떠 있는 step-ca 를 다시 만든다."""
    write_if_changed(CA_DIR / "ca.json", pki.render_ca_json_text(cfg))
    write_bundle()
    sync_generated()
    if compose(["ps", "--quiet", "step-ca"], capture_output=True).stdout.strip():
        if compose(["up", "-d", "--wait", "--force-recreate", "--no-deps", "step-ca"]).returncode != 0:
            fail("step-ca 를 다시 만들지 못했다. ./deploy status 와 로그를 본다")
        typer.echo("step-ca 를 새 중간 CA 로 다시 만들었다. 이미 나간 리프는 만료까지(또는 자동 갱신 때까지) 이전 중간 CA 사슬로 유효하다")
    else:
        typer.echo("step-ca 가 떠 있지 않다. ./deploy bootstrap 으로 띄우면 새 중간 CA 를 쓴다")


@ca_app.command("rotate")
def ca_rotate() -> None:
    """중간 CA 를 교체한다. self: 루트로 새 중간 CA 를 만들어 검증·설치·step-ca 재생성. organization: 새 키와 CSR 을 만든다(이어서 ca install)."""
    cfg = ca_cfg()
