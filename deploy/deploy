def trust_users_running() -> list[str]:
    return [service for service in TRUST_LIST_USERS if is_running(service)]


def refresh_trust_users() -> None:
    """신뢰 목록을 시작할 때 읽는 서비스 중 돌고 있는 것을 다시 만든다."""
    running = trust_users_running()
    if running:
        typer.echo(f"새 신뢰 목록을 읽게 다시 만든다: {', '.join(running)}")
        recreate(running)


def old_root_files() -> list[Path]:
    return sorted(extra_trust_dir().glob("old-root-*.crt")) if extra_trust_dir().is_dir() else []


@ca_app.command("rotate-root")
def ca_rotate_root(
    finish: Annotated[bool, typer.Option("--finish", help="2단계: 이전 루트를 신뢰 목록에서 뺀다(새 루트를 모든 기기에 배포한 뒤)")] = False,
    distributed: Annotated[bool, typer.Option("--distributed", help="--finish 와 함께: 새 루트를 키오스크·직원 PC 에 배포했음을 확인했다")] = False,
) -> None:
    """루트 CA 를 교체한다(2단계, 절차는 docs/CA.md). 1단계(기본): 새 루트·중간 CA 를 만들고 신뢰 목록에 새 루트와 이전 루트를 함께 둔다. 2단계(--finish): 이전 루트를 뺀다."""
    cfg = ca_cfg()
    if not (CA_DIR / "root_ca.crt").is_file():
        no_target("deploy/pki/ca/root_ca.crt 가 없다(./deploy bootstrap)")
    if finish:
        return finish_root_rotation(distributed)
    if old_root_files():
        fail("이전 루트가 아직 신뢰 목록에 있다(이전 교체가 끝나지 않았다). 먼저 ./deploy ca rotate-root --finish --distributed")
    old = pki.load_cert(CA_DIR / "root_ca.crt")
    fingerprint = old.fingerprint(pki.hashes.SHA256()).hex()[:8]
    # 왜 먼저 이전 루트를 신뢰 목록 폴더에 둔다: 새 루트로 바꾸는 순간부터 이전 루트가 서명한 리프(기기·서비스)가 아직 쓰이므로 둘 다 믿어야 한다(ADR 0015)
    extra_trust_dir().mkdir(parents=True, exist_ok=True)
    write_if_changed(extra_trust_dir() / f"old-root-{fingerprint}.crt", pki.pem_text([old]))
    if cfg.mode == "organization":
        # 새 루트는 조직이 정한다. 새 중간 CA 서명 요청을 만들고, 서명된 사슬과 새 루트를 ca install 로 설치하면 신뢰 목록이 새 루트와 이전 루트를 함께 담는다
        typer.echo(f"이전 루트를 신뢰 목록 폴더에 두었다: old-root-{fingerprint}.crt")
        typer.echo(f"서명 요청: {create_csr(cfg).relative_to(ROOT)}\n조직이 새 루트로 서명하면 ./deploy ca install --cert <서명된 인증서> --root <새 루트 인증서>")
        typer.echo("새 루트를 키오스크와 직원 PC 에 배포한 뒤 ./deploy ca rotate-root --finish --distributed")
        return
    # self: 새 루트를 임시 폴더에 만들고(실패해도 현재 루트가 그대로다) 보관·교체·새 중간 CA 설치 순서로 간다
    staging = PKI_DIR / "pending-root"
    shutil.rmtree(staging, ignore_errors=True)
    private_dir(staging)
    result = step_cli(
        ["certificate", "create", f"{cfg.name} Root CA", "/pki/root_ca.crt", "/pki/root_ca.key", "--profile", "root-ca",
         "--not-after", pki.fmt_minutes(cfg.root_minutes), "--password-file", "/run/pw/root"],
        rw={staging: "/pki"}, ro={SECRETS_DIR / "step_ca_root_password": "/run/pw/root"},
    )
    step_or_fail("새 루트 CA 생성", result)
    archive = ARCHIVE_DIR / f"{time.strftime('%Y%m%dT%H%M%S')}-old-root"
    private_dir(ARCHIVE_DIR)
    private_dir(archive)
    for name in ("root_ca.crt", "root_ca.key"):
        shutil.move(PKI_DIR / name, archive / name)
        shutil.move(staging / name, PKI_DIR / name)
    (PKI_DIR / "root_ca.key").chmod(0o600)
    shutil.rmtree(staging, ignore_errors=True)
    typer.echo(f"이전 루트 파일 보관: {archive.relative_to(ROOT)}, 신뢰 목록 폴더에 old-root-{fingerprint}.crt")
    create_intermediate(cfg)
    install_intermediate(PENDING_DIR / "intermediate_ca.crt", PENDING_DIR / "intermediate_ca.key", PKI_DIR / "root_ca.crt")
    finish_ca_change(cfg)
    refresh_trust_users()
    new = pki.load_cert(PKI_DIR / "root_ca.crt")
    typer.echo(f"새 루트: {pki.subject_text(new)} sha256={new.fingerprint(pki.hashes.SHA256()).hex()}\n"
               f"배포할 파일: {(PKI_DIR / 'root_ca.crt').relative_to(ROOT)} (키오스크와 직원 PC, docs/CA.md '루트를 키오스크와 직원 PC에 배포')\n"
               "리프 수명이 지나 이전 루트가 서명한 인증서가 모두 갱신되고 새 루트가 모든 기기에 배포된 뒤: ./deploy ca rotate-root --finish --distributed")
    ca_status()


def finish_root_rotation(distributed: bool) -> None:
    """2단계: 이전 루트를 신뢰 목록에서 뺀다. 지금 나가 있는 서버 인증서가 새 루트만으로 검증되는지 확인하고, 배포 확인(--distributed)이 있어야 한다."""
    olds = old_root_files()
    if not olds:
        no_target("신뢰 목록 폴더에 이전 루트(old-root-*.crt)가 없다(교체 1단계를 하지 않았거나 이미 끝났다)")
    if not distributed:
        fail("새 루트를 키오스크와 직원 PC 에 배포했는지 이 명령이 확인할 수 없다. 배포했다면 --distributed 를 함께 준다", 2)
    # 왜 새 루트만으로 검증: 이전 루트가 서명한 리프가 남아 있으면 이전 루트를 빼는 순간 그 서비스의 TLS 가 깨진다
    only_new = META_DIR / "trust-new-root-only.pem"
    META_DIR.mkdir(exist_ok=True)
    only_new.write_text(pki.pem_text([pki.load_cert(CA_DIR / "root_ca.crt")]), encoding="ascii")
    served = platform_generated().settings
    probes: list[tuple[str, tuple[str, int] | None, str]] = [("입구", published_endpoint("ingress-acme", served.listen_port), served.public_host)]
    if reg_cfg().mode == "local":
        probes.append(("레지스트리", published_endpoint("registry", 443), reg_cfg().names[0]))
    stale = []
    for label, endpoint, name in probes:
        if endpoint is None:
            continue  # 떠 있지 않으면 내놓는 인증서가 없다
        try:
            pki.fetch_leaf(engine_host(), endpoint[1], name, only_new)
        except (OSError, ssl.SSLError) as error:
            stale.append(f"{label}({name}): {error}")
    only_new.unlink(missing_ok=True)
    if stale:
        fail("이전 루트가 서명한 인증서가 아직 나가 있어 이전 루트를 뺄 수 없다(리프가 갱신될 때까지 기다린다):\n  " + "\n  ".join(stale))
    for path in olds:
        path.unlink()
    write_bundle()
    sync_generated()
    refresh_trust_users()
    typer.echo(f"이전 루트를 신뢰 목록에서 뺐다: {', '.join(p.name for p in olds)}")
    ca_status()


@identity_app.command("sync")
def identity_sync() -> None:
    """생성한 realm 파일의 클라이언트와 역할을 이미 있는 realm 에 반영한다.

    왜 필요한가: Keycloak 의 --import-realm 은 이미 있는 realm 을 건너뛴다. 기계 호출자나 노출 선언이 바뀌면 realm 파일이 달라지는데 처음 설치 뒤에는 반영되지 않는다.
    방법: Keycloak 의 표준 관리 API partialImport(ifResourceExists=OVERWRITE)와 서비스 계정 역할 부여를 kcadm 으로 한다. 사람 계정은 건드리지 않는다.
    비밀(클라이언트 비밀)은 표준 입력으로만 넘기고 출력하지 않는다.
    """
    if not is_running("keycloak"):
        no_target("keycloak 이 떠 있지 않다(./deploy up)")
    realm = json.loads((GENERATED / "identity" / "openit-realm.json").read_text(encoding="utf-8"))
    values = {"OAUTH2_PROXY_CLIENT_SECRET": read_password("oauth2_proxy_client_secret").decode(), "OPENIT_REALM_ADMIN_PASSWORD": read_password("keycloak_admin_password").decode()}
    if MACHINE_SECRETS_DIR.is_dir():
        values |= {pf_identity.machine_env_name(p.name): p.read_text(encoding="utf-8").strip() for p in MACHINE_SECRETS_DIR.iterdir() if p.is_file()}
    body = json.dumps({"ifResourceExists": "OVERWRITE", "clients": realm["clients"]})
    # 왜 역할은 SKIP: 역할을 덮어쓰면 지워졌다 다시 만들어져 사람 계정에 준 역할 부여가 사라진다(시험에서 확인). 역할 이름은 계약이 정하므로 없는 것만 만든다
    roles_body = json.dumps({"ifResourceExists": "SKIP", "roles": realm["roles"]})
    for name, value in values.items():
        body = body.replace("${" + name + "}", value)
    unresolved = re.findall(r"\$\{[A-Z0-9_]+\}", body)
    if unresolved:
        fail(f"realm 파일의 자리표시자에 해당하는 비밀 파일이 없다: {', '.join(sorted(set(unresolved)))} (./deploy secrets init)")
    # 왜 범위 매핑: 클라이언트의 토큰에 싣는 역할을 계약의 역할로 제한한다(fullScopeAllowed 거짓). partialImport 가 갱신하지 않아 따로 부여한다(이미 있으면 그대로다).
    # 왜 service-account-user 조회: 덮어쓴 클라이언트의 서비스 계정은 이 조회로 만들어진다(Keycloak 이 필요할 때 만든다)
    calls = []
    for item in realm["scopeMappings"]:
        calls.append(f"mapping {item['client']} {' '.join(item['roles'])}")
    for user in realm["users"]:
        if "serviceAccountClientId" in user:
            calls.append(f"account {user['serviceAccountClientId']} {' '.join(user['realmRoles'])}")
    script = """set -e
kc() { /opt/keycloak/bin/kcadm.sh "$@" --config /tmp/kcadm.config; }
client_id() { kc get clients -r openit -q clientId="$1" --fields id --format csv --noquotes; }
mapping() {
  client="$1"; shift; cid="$(client_id "$client")"; body='['
  for role in "$@"; do rid="$(kc get "roles/$role" -r openit --fields id --format csv --noquotes)"; body="$body{\\"id\\":\\"$rid\\",\\"name\\":\\"$role\\"},"; done
  echo "${body%,}]" | kc create "clients/$cid/scope-mappings/realm" -r openit -f - >/dev/null
}
account() {
  client="$1"; shift; cid="$(client_id "$client")"; kc get "clients/$cid/service-account-user" -r openit >/dev/null
  args=""; for role in "$@"; do args="$args --rolename $role"; done
  kc add-roles -r openit --uusername "service-account-$client" $args
}
kc config credentials --server http://localhost:8080 --realm master --user admin --password "$(cat /run/secrets/keycloak_admin_password)" >/dev/null
kc create partialImport -r openit -f - >/dev/null
kc create partialImport -r openit -f - >/dev/null <<'ROLES'
""" + roles_body + "\nROLES\n" + "\n".join(calls) + "\n"
    result = compose(["exec", "-T", "keycloak", "bash", "-c", script], input=body, capture_output=True)
    if result.returncode != 0:
        fail(f"identity sync 실패(rc={result.returncode}): {(result.stderr or result.stdout).strip()[-400:]}")
    typer.echo(f"반영함: 클라이언트 {len(realm['clients'])}개, 역할 {len(realm['roles']['realm'])}개")


class E2EMode(str, Enum):
    pipeline = "pipeline"  # D81 의 gpu-12g(기반 Qwen3-1.7B)와 중립 어댑터: 게시·활성화·적재·추론 경로가 계약대로 도는지
    product = "product"  # 학습된 어댑터(--adapters-a/-b)와 --profile: 더해 대본의 기대 값이 결과에 저장되는지


# 왜 이 목록만: E2E 도구에 상속받은 환경 변수를 통째로 넘기지 않는다(RUNTIME R9.1). docker 설정·엔진 선택과 uv 캐시, 실행에 필요한 PATH 와 HOME 뿐이다
E2E_ENV_KEYS = ("PATH", "HOME", "LANG", "LC_ALL", "DOCKER_HOST", "DOCKER_CONTEXT", "DOCKER_CONFIG", "UV_CACHE_DIR", "XDG_CACHE_HOME")


@app.command()
def e2e(
    mode: Annotated[E2EMode, typer.Option("--mode", help="pipeline(gpu-12g, 중립 어댑터) 또는 product(학습된 어댑터)")],
    adapters_a: Annotated[Path | None, typer.Option("--adapters-a", help="product: LoRA-A 어댑터 폴더(PEFT 어댑터와 system_prompt.txt)")] = None,
    adapters_b: Annotated[Path | None, typer.Option("--adapters-b", help="product: LoRA-B 어댑터 폴더")] = None,
    profile: Annotated[str | None, typer.Option("--profile", help="product: 모델 프로파일(예: rtx4090-24g)")] = None,
    note: Annotated[str, typer.Option("--note", help="기록에 남길 한 줄 비고")] = "",
) -> None:
    """전체 시험 1회(샌드박스, 제품 구성은 건드리지 않는다). 결과는 deploy/docs/E2E_RESULTS.md 에 남는다(ADR 0025).

    임시 폴더에 설치를 하나 더 만들어(compose 프로젝트 openit-e2e-<무작위>) 그 안에서 한 건의 문진을 입구를 지나는 실제 HTTP 로 끝까지 시험하고 이 프로젝트만 down -v 한다.
    영역 이미지는 이 엔진에 빌드되어 있어야 한다(./deploy build). 종료 코드는 0 통과, 1 실패.
    """
    if not (DEPLOY / "e2e" / "pyproject.toml").is_file():
        no_target("deploy/e2e/ 가 없다(E2E 실행 도구)")
    command = ["uv", "run", "--project", str(DEPLOY / "e2e"), "openit-e2e", "--mode", mode.value]
    for flag, value in (("--adapters-a", adapters_a), ("--adapters-b", adapters_b)):
        if value is not None:
            command += [flag, str(value.resolve())]
    if profile:
        command += ["--profile", profile]
    if note:
        command += ["--note", note]
    try:
        # 왜 docker_env 의 값을 더한다: 엔진 선택(DOCKER_CONTEXT 가 DOCKER_HOST 보다 우선)을 이 명령이 한 번 해석해 넘긴다(dockerenv 의 규칙)
        env = {key: os.environ[key] for key in E2E_ENV_KEYS if key in os.environ} | {key: value for key, value in dockerenv.docker_env().items() if key.startswith("DOCKER_")}
    except dockerenv.DockerEnvError as error:
        fail(f"docker 환경을 정하지 못했다: {error}")
    env["PYTHONUNBUFFERED"] = "1"  # 왜: 진행 줄이 파이프·파일로 나가도 바로 보인다(몇 분에서 몇십 분 걸리는 명령이다)
    result = subprocess.run(command, cwd=ROOT, env=env, check=False)  # noqa: S603
    if result.returncode != 0:
        raise typer.Exit(result.returncode)


if __name__ == "__main__":
    app()
